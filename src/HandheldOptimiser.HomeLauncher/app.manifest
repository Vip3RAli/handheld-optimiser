<?xml version="1.0" encoding="utf-8"?>
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <assemblyIdentity version="1.0.0.0" name="HandheldOptimiser.HomeLauncher" />

  <!--
    Links this exe to the registration-only package in installer\HomeApp so it runs with that package's
    identity. publisher, packageName and applicationId must match installer\HomeApp\AppxManifest.xml.
  -->
  <msix xmlns="urn:schemas-microsoft-com:msix.v1"
        publisher="CN=Handheld Optimiser, OID.2.25.311729368913984317654407730594956997722=1"
        packageName="HandheldOptimiser.HomeApp"
        applicationId="HomeApp" />

  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v2">
    <security>
      <requestedPrivileges xmlns="urn:schemas-microsoft-com:asm.v3">
        <!-- Must not elevate: Windows starts this every time full screen mode opens. -->
        <requestedExecutionLevel level="asInvoker" uiAccess="false" />
      </requestedPrivileges>
    </security>
  </trustInfo>

  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}" />
    </application>
  </compatibility>
</assembly>
