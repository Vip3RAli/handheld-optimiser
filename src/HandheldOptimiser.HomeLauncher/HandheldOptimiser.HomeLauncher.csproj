<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Started by Windows as the full screen experience home app. Kept separate from the main app because
    that one requires administrator, which would show a UAC prompt every time full screen mode starts.
    WPF is only loaded when the game library is the chosen home app; the other choices open and exit.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Source-generated P/Invoke for XInput and the icon helpers. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- The game library's own icon, which its Start menu shortcut and window show. -->
    <ApplicationIcon>Assets\library.ico</ApplicationIcon>
    <AssemblyName>HandheldOptimiser.HomeLauncher</AssemblyName>
    <RootNamespace>HandheldOptimiser.HomeLauncher</RootNamespace>
    <Product>Handheld Optimiser</Product>
    <Version>1.1.0</Version>

    <!-- The library stays open behind games, so a small footprint matters more than GC throughput. -->
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <!--
      The collector also packs the heap down sooner, where it would leave gaps to save itself work.
      Measured on the Old School cards, 2026-10-12: about 10 MB less in front and 4 MB less behind a
      game, the same at levels 5, 7 and 9 of 9.
    -->
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="7" />
  </ItemGroup>

  <ItemGroup>
    <!-- The library's pure logic is tested without a window. -->
    <InternalsVisibleTo Include="HandheldOptimiser.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Open Sans, the game library's font wherever Convection is not installed. Built into the app, and
      its licence, which asks to travel with it, is copied beside the app.
    -->
    <Resource Include="Fonts\*.ttf" />
    <Content Include="Fonts\OFL.txt" Link="Open Sans licence.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Recommended Ally settings per game, kept at the top of the repository so it is easy to edit. The
      built-in copy is used until a newer one is fetched from GitHub; see GameSettingsDb.
    -->
    <EmbeddedResource Include="..\..\data\game-settings.json" LogicalName="game-settings.json" />
  </ItemGroup>

  <ItemGroup>
    <!-- How the library talks to the TDP Engine service, shared with it so the two always agree. -->
    <Compile Include="..\HandheldOptimiser.PowerService\AutoTdpProtocol.cs" Link="Library\AutoTdpProtocol.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- The screen brightness control in quick settings, which Windows only offers through WMI. -->
    <PackageReference Include="System.Management" Version="10.0.12" />
  </ItemGroup>

</Project>
