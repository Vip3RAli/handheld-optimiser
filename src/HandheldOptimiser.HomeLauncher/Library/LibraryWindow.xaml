<Window x:Class="HandheldOptimiser.HomeLauncher.Library.LibraryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Game Library"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowState="Maximized"
        Background="#0F1115"
        Foreground="#F2F3F5"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- A game tile: portrait art, or the store colour with the game's icon and name. -->
        <Style x:Key="TileButton" TargetType="Button">
            <Setter Property="Margin" Value="10" />
            <!-- Button's default style would otherwise make the titles black. -->
            <Setter Property="Foreground" Value="#F2F3F5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform />
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <StackPanel Width="180">
                            <Grid Height="270">
                                <Border x:Name="Art" CornerRadius="8" Background="{Binding Background}" ClipToBounds="True">
                                    <Grid>
                                        <Image Source="{Binding Cover}" Stretch="UniformToFill"
                                               RenderOptions.BitmapScalingMode="HighQuality"
                                               Visibility="{Binding HasCover, Converter={StaticResource BoolToVis}}" />
                                        <StackPanel VerticalAlignment="Center" Margin="16,0"
                                                    Visibility="{Binding ShowsIcon, Converter={StaticResource BoolToVis}}">
                                            <Image Source="{Binding Icon}" Width="88" Height="88"
                                                   RenderOptions.BitmapScalingMode="HighQuality" />
                                            <TextBlock Text="{Binding Title}" Margin="0,14,0,0" FontSize="17" FontWeight="SemiBold"
                                                       TextAlignment="Center" TextWrapping="Wrap" MaxHeight="92" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <Border x:Name="Ring" CornerRadius="10" Margin="-4" BorderThickness="3"
                                        BorderBrush="#F2F3F5" Opacity="0" />
                            </Grid>
                            <TextBlock Text="{Binding Title}" Margin="2,8,2,0" FontSize="14" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding StoreName}" Margin="2,1,2,0" FontSize="12" Opacity="0.55" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Ring" Property="Opacity" Value="0.45" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Ring" Property="Opacity" Value="1" />
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="1.05" ScaleY="1.05" />
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="Panel.ZIndex" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Controller button hint: a round glyph and its label. -->
        <Style x:Key="HintGlyph" TargetType="Border">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="CornerRadius" Value="13" />
            <Setter Property="Margin" Value="22,0,8,0" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="48,32,48,12">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                <TextBlock Text="Library" FontSize="32" FontWeight="SemiBold" />
                <TextBlock x:Name="CountText" Margin="14,0,0,5" FontSize="15" Opacity="0.55" VerticalAlignment="Bottom" />
            </StackPanel>
            <TextBlock x:Name="ClockText" HorizontalAlignment="Right" VerticalAlignment="Bottom" FontSize="20" Opacity="0.8" />
        </Grid>

        <ScrollViewer x:Name="Scroller" Grid.Row="1" VerticalScrollBarVisibility="Hidden" PanningMode="VerticalOnly"
                      Padding="38,4,38,24" Focusable="False">
            <ItemsControl x:Name="Tiles" Focusable="False" KeyboardNavigation.DirectionalNavigation="Contained">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource TileButton}" Click="OnTileClick" GotKeyboardFocus="OnTileFocused" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <TextBlock x:Name="EmptyText" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                   FontSize="18" Opacity="0.6" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="560" />

        <Grid Grid.Row="2" Margin="48,8,48,24">
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" FontSize="15" Opacity="0.8" TextTrimming="CharacterEllipsis" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Border Style="{StaticResource HintGlyph}" Background="#3FA34D">
                    <TextBlock Text="A" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="Play" FontSize="15" VerticalAlignment="Center" />
                <Border Style="{StaticResource HintGlyph}" Background="#D9A520">
                    <TextBlock Text="Y" FontWeight="Bold" FontSize="13" Foreground="#101010"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="Refresh" FontSize="15" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
