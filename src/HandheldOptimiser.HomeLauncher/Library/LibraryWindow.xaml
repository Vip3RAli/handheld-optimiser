<Window x:Class="HandheldOptimiser.HomeLauncher.Library.LibraryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:HandheldOptimiser.HomeLauncher.Library"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        Title="Game Library"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowState="Maximized"
        Background="#0F1115"
        Foreground="#F2F3F5"
        FontFamily="Convection, /HandheldOptimiser.HomeLauncher;component/Fonts/#Open Sans, Segoe UI Variable Text, Segoe UI"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!--
            A row of the menu, and the row in focus. Dark, for the menu over the dimmed library. On the
            back of an Old School card the menu has its own, see-through, so the card's colours show.
        -->
        <SolidColorBrush x:Key="MenuRowBrush" Color="#222630" />
        <SolidColorBrush x:Key="MenuRowFocusBrush" Color="#2C3240" />

        <!-- How much room a row of the menu takes, which is less on the back of a card. -->
        <Thickness x:Key="MenuRowPadding">16,10</Thickness>
        <Thickness x:Key="MenuRowMargin">0,0,0,8</Thickness>
        <sys:Double x:Key="MenuRowHeight">46</sys:Double>

        <!-- The back of a green Old School card: the card's own green, a shade deeper so white text reads on it. -->
        <LinearGradientBrush x:Key="OldSchoolGreenBack" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#8DBE22" Offset="0" />
            <GradientStop Color="#5E9412" Offset="0.5" />
            <GradientStop Color="#2F5708" Offset="1" />
        </LinearGradientBrush>

        <!--
            A notice is what the library has to say about a game, a deal or a green card, such as that the
            game is starting. It is shown on the tile or card itself for a few seconds, in place of the
            name: the one style is for whatever shows the notice, and the other for what gives way to it.
        -->
        <Style x:Key="ShownByNotice" TargetType="FrameworkElement">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Notice}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="HiddenByNotice" TargetType="FrameworkElement">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Notice}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- A game tile in the grid: portrait art, or the store colour with the game's icon and name. -->
        <Style x:Key="TileButton" TargetType="Button">
            <Setter Property="Margin" Value="10" />
            <!-- Button's default style would otherwise make the titles black. -->
            <Setter Property="Foreground" Value="#F2F3F5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform />
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <StackPanel Width="180">
                            <Grid Height="270">
                                <Border x:Name="Art" CornerRadius="8" Background="{Binding Background}" ClipToBounds="True">
                                    <Grid>
                                        <Image Source="{Binding Cover}" Stretch="UniformToFill"
                                               RenderOptions.BitmapScalingMode="HighQuality"
                                               Visibility="{Binding HasCover, Converter={StaticResource BoolToVis}}" />
                                        <StackPanel VerticalAlignment="Center" Margin="16,0"
                                                    Visibility="{Binding ShowsIcon, Converter={StaticResource BoolToVis}}">
                                            <Image Source="{Binding Icon}" Width="88" Height="88"
                                                   RenderOptions.BitmapScalingMode="HighQuality" />
                                            <TextBlock Text="{Binding Title}" Margin="0,14,0,0" FontSize="17" FontWeight="SemiBold"
                                                       TextAlignment="Center" TextWrapping="Wrap" MaxHeight="92" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <!-- Games that are not installed wear a download mark. -->
                                <Border x:Name="InstallMark" Width="34" Height="34" CornerRadius="17" Margin="8" Background="#D0101216"
                                        HorizontalAlignment="Left" VerticalAlignment="Bottom" Visibility="Collapsed">
                                    <TextBlock Text="&#xE896;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <!-- The store the game is from, as its logo. -->
                                <Border x:Name="StoreMark" Width="30" Height="30" CornerRadius="15" Margin="8" Background="#D0101216"
                                        HorizontalAlignment="Right" VerticalAlignment="Bottom">
                                    <Path Data="{Binding StoreLogo}" Fill="#F2F3F5" Stretch="Uniform" Width="16" Height="16"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <!-- Favourites wear a star in the corner. -->
                                <Border Width="34" Height="34" CornerRadius="17" Margin="8" Background="#B0101216"
                                        HorizontalAlignment="Right" VerticalAlignment="Top"
                                        Visibility="{Binding IsFavourite, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="&#xE735;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16"
                                               Foreground="#F5C542" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <!-- A notice, across the bottom of the picture: the name under it is one short line. -->
                                <Border Style="{StaticResource ShownByNotice}" CornerRadius="0,0,8,8" Padding="10,8"
                                        Background="#E6101216" VerticalAlignment="Bottom">
                                    <TextBlock Text="{Binding Notice}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" />
                                </Border>
                                <Border x:Name="Ring" CornerRadius="10" Margin="-4" BorderThickness="3"
                                        BorderBrush="#F2F3F5" Opacity="0" />
                            </Grid>
                            <TextBlock Text="{Binding Title}" Margin="2,8,2,0" FontSize="14" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding StoreLogo}" Value="{x:Null}">
                                <Setter TargetName="StoreMark" Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <!-- Hidden games only show while Show hidden games is on, faded so they stand out. -->
                            <DataTrigger Binding="{Binding IsHidden}" Value="True">
                                <Setter TargetName="Art" Property="Opacity" Value="0.4" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsInstalled}" Value="False">
                                <Setter TargetName="Art" Property="Opacity" Value="0.6" />
                                <Setter TargetName="InstallMark" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Ring" Property="Opacity" Value="0.45" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Ring" Property="Opacity" Value="1" />
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="1.05" ScaleY="1.05" />
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="Panel.ZIndex" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            A game tile in the row: a square icon, as on a console's home screen. The focused one is drawn
            at twice the size from its bottom edge, with margins that move its neighbours aside by as much
            (RowTileSize and RowFocusScale in LibraryWindow.Layout.cs), and only it shows its name. The
            square picture is SteamGridDB's; until one arrives the cover is shown, cut to fit.
        -->
        <Style x:Key="RowTileButton" TargetType="Button">
            <Setter Property="Margin" Value="6" />
            <Setter Property="Foreground" Value="#F2F3F5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="RenderTransformOrigin" Value="0.5,1" />
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform />
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Width="150" Height="150">
                            <Border x:Name="Art" CornerRadius="6" Background="{Binding Background}" ClipToBounds="True">
                                <Grid>
                                    <Image Source="{Binding Cover}" Stretch="UniformToFill" VerticalAlignment="Top"
                                           RenderOptions.BitmapScalingMode="HighQuality" />
                                    <Image Source="{Binding Icon}" Width="72" Height="72"
                                           RenderOptions.BitmapScalingMode="HighQuality"
                                           Visibility="{Binding ShowsIcon, Converter={StaticResource BoolToVis}}" />
                                    <Image Source="{Binding Square}" Stretch="UniformToFill"
                                           RenderOptions.BitmapScalingMode="HighQuality" />
                                </Grid>
                            </Border>
                            <!-- The store the game is from, as its logo. -->
                            <Border x:Name="StoreMark" Width="18" Height="18" CornerRadius="9" Margin="5" Background="#D0101216"
                                    HorizontalAlignment="Left" VerticalAlignment="Top">
                                <Path Data="{Binding StoreLogo}" Fill="#F2F3F5" Stretch="Uniform" Width="10" Height="10"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <!-- Favourites wear a star in the corner. -->
                            <Border Width="18" Height="18" CornerRadius="9" Margin="5" Background="#B0101216"
                                    HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Visibility="{Binding IsFavourite, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="&#xE735;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="9"
                                           Foreground="#F5C542" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <!-- The name across the bottom of the focused one, at half the size it is drawn. -->
                            <Border x:Name="Name" CornerRadius="0,0,6,6" Padding="8,14,8,5" VerticalAlignment="Bottom" Visibility="Collapsed">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#00000000" Offset="0" />
                                        <GradientStop Color="#E0000000" Offset="0.6" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource HiddenByNotice}" Text="{Binding Title}" FontSize="9"
                                               FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Style="{StaticResource ShownByNotice}" Text="{Binding Notice}" FontSize="8"
                                               FontWeight="SemiBold" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <Border x:Name="Ring" CornerRadius="8" Margin="-3" BorderThickness="2"
                                    BorderBrush="#F2F3F5" Opacity="0" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding StoreLogo}" Value="{x:Null}">
                                <Setter TargetName="StoreMark" Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsHidden}" Value="True">
                                <Setter TargetName="Art" Property="Opacity" Value="0.4" />
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Ring" Property="Opacity" Value="0.45" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Ring" Property="Opacity" Value="1" />
                                <Setter TargetName="Ring" Property="BorderThickness" Value="1.5" />
                                <Setter TargetName="Name" Property="Visibility" Value="Visible" />
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="2" ScaleY="2" />
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="Margin" Value="81,6,81,6" />
                                <Setter Property="Panel.ZIndex" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            A game's card in the Old School layout: its wide artwork with its name along the bottom, as
            the Xbox 360's cards were. OldSchoolPanel sizes and places each one, so the focused card does
            not grow by itself (OldSchoolStack in OldSchoolPanel.cs has the card's size). A game with no
            wide artwork shows its cover on its own colours.
        -->
        <Style x:Key="OldSchoolCardButton" TargetType="Button">
            <Setter Property="Foreground" Value="#F2F3F5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Width="420" Height="320">
                            <Border x:Name="Art" CornerRadius="12" Background="{Binding CardBrush}">
                                <Grid>
                                    <!-- Under the wide artwork, and so only seen without it. -->
                                    <Border x:Name="Fallback" Width="150" Height="225" Margin="24,24,0,0" CornerRadius="6" ClipToBounds="True"
                                            HorizontalAlignment="Left" VerticalAlignment="Top" Background="{Binding Background}">
                                        <Grid>
                                            <Image Source="{Binding Cover}" Stretch="UniformToFill"
                                                   RenderOptions.BitmapScalingMode="Linear" />
                                            <Image Source="{Binding Icon}" Width="112" Height="112"
                                                   RenderOptions.BitmapScalingMode="Linear"
                                                   Visibility="{Binding ShowsIcon, Converter={StaticResource BoolToVis}}" />
                                        </Grid>
                                    </Border>
                                    <!-- A brush, not an image, so the picture keeps the card's round corners. -->
                                    <Border CornerRadius="12" RenderOptions.BitmapScalingMode="Linear">
                                        <Border.Background>
                                            <ImageBrush ImageSource="{Binding Wide}" Stretch="UniformToFill" />
                                        </Border.Background>
                                    </Border>
                                    <!-- The sheen across the top of the card, and the shade the name is read on. -->
                                    <Border CornerRadius="12">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#30FFFFFF" Offset="0" />
                                                <GradientStop Color="#00FFFFFF" Offset="0.3" />
                                                <GradientStop Color="#00000000" Offset="0.5" />
                                                <GradientStop Color="#E0000000" Offset="1" />
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>
                                    <!-- Only on the front card: the ones behind have theirs half covered. -->
                                    <TextBlock Style="{StaticResource HiddenByNotice}" Text="{Binding Title}" Margin="20,0,56,16"
                                               FontSize="26" FontWeight="SemiBold"
                                               VerticalAlignment="Bottom" TextTrimming="CharacterEllipsis"
                                               Opacity="{Binding Path=(local:OldSchoolPanel.Front), RelativeSource={RelativeSource AncestorType=ContentPresenter}}" />
                                    <!-- A notice takes the name's place, on as many lines as it needs. -->
                                    <TextBlock Style="{StaticResource ShownByNotice}" Text="{Binding Notice}" Margin="20,0,56,16"
                                               FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"
                                               VerticalAlignment="Bottom"
                                               Opacity="{Binding Path=(local:OldSchoolPanel.Front), RelativeSource={RelativeSource AncestorType=ContentPresenter}}" />
                                </Grid>
                            </Border>
                            <!-- The store the game is from, as its logo. -->
                            <Border x:Name="StoreMark" Width="30" Height="30" CornerRadius="15" Margin="14" Background="#D0101216"
                                    HorizontalAlignment="Right" VerticalAlignment="Bottom">
                                <Path Data="{Binding StoreLogo}" Fill="#F2F3F5" Stretch="Uniform" Width="16" Height="16"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <!-- Favourites wear a star in the corner. -->
                            <Border Width="34" Height="34" CornerRadius="17" Margin="12" Background="#B0101216"
                                    HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Visibility="{Binding IsFavourite, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="&#xE735;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16"
                                           Foreground="#F5C542" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <Border x:Name="Ring" CornerRadius="14" Margin="-4" BorderThickness="3"
                                    BorderBrush="#F2F3F5" Opacity="0" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding StoreLogo}" Value="{x:Null}">
                                <Setter TargetName="StoreMark" Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsHidden}" Value="True">
                                <Setter TargetName="Art" Property="Opacity" Value="0.4" />
                            </DataTrigger>
                            <!-- An icon sits on the card's own colours, with no cover-shaped box around it. -->
                            <DataTrigger Binding="{Binding ShowsIcon}" Value="True">
                                <Setter TargetName="Fallback" Property="Background" Value="Transparent" />
                            </DataTrigger>
                            <!-- No ring under the mouse: after a swipe it would sit on whichever card came to rest there. -->
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Ring" Property="Opacity" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The games' tiles in each layout. Press and hold arrives as a right click, so touch reaches the quick actions too. -->
        <DataTemplate x:Key="GridTile">
            <Button Style="{StaticResource TileButton}" Click="OnTileClick" GotKeyboardFocus="OnTileFocused"
                    MouseRightButtonUp="OnTileRightClick" />
        </DataTemplate>
        <DataTemplate x:Key="RowTile">
            <Button Style="{StaticResource RowTileButton}" Click="OnTileClick" GotKeyboardFocus="OnTileFocused"
                    MouseRightButtonUp="OnTileRightClick" />
        </DataTemplate>
        <DataTemplate x:Key="OldSchoolTile">
            <Button Style="{StaticResource OldSchoolCardButton}" Click="OnTileClick" GotKeyboardFocus="OnTileFocused"
                    MouseRightButtonUp="OnTileRightClick" />
        </DataTemplate>

        <!-- The Last played card: a wide tile with the same focus ring and lift as the others. -->
        <Style x:Key="CardButton" TargetType="Button">
            <Setter Property="Margin" Value="10" />
            <Setter Property="Foreground" Value="#F2F3F5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform />
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <ContentPresenter />
                            <Border x:Name="Ring" CornerRadius="10" Margin="-4" BorderThickness="3"
                                    BorderBrush="#F2F3F5" Opacity="0" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Ring" Property="Opacity" Value="0.45" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Ring" Property="Opacity" Value="1" />
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="1.03" ScaleY="1.03" />
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="Panel.ZIndex" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The layouts: a grid that scrolls down, one row of games that scrolls across, and the Old School cards. -->
        <ItemsPanelTemplate x:Key="GridPanel">
            <WrapPanel />
        </ItemsPanelTemplate>
        <ItemsPanelTemplate x:Key="RowPanel">
            <StackPanel Orientation="Horizontal" />
        </ItemsPanelTemplate>
        <ItemsPanelTemplate x:Key="OldSchoolPanel">
            <local:OldSchoolPanel />
        </ItemsPanelTemplate>

        <!-- A deal's card in the row below the grid, and in the grid of deals below the row of games. -->
        <DataTemplate x:Key="DealCard">
            <Button Style="{StaticResource CardButton}" Click="OnDealClick" GotKeyboardFocus="OnDealFocused">
                <StackPanel Width="300">
                    <Grid Height="140">
                        <Border CornerRadius="8" ClipToBounds="True" Background="#262B36">
                            <Grid>
                                <Image Source="{Binding Banner}" Stretch="UniformToFill"
                                       RenderOptions.BitmapScalingMode="HighQuality" />
                                <TextBlock Text="{Binding Title}" Margin="16,0" FontSize="18" FontWeight="SemiBold"
                                           TextAlignment="Center" TextWrapping="Wrap" VerticalAlignment="Center"
                                           Visibility="{Binding ShowsTitle, Converter={StaticResource BoolToVis}}" />
                            </Grid>
                        </Border>
                        <Border Margin="8" Padding="8,3" CornerRadius="6" Background="#3FA34D"
                                HorizontalAlignment="Left" VerticalAlignment="Bottom">
                            <TextBlock Text="{Binding Cut}" FontSize="15" FontWeight="Bold" />
                        </Border>
                        <Border Margin="8" Padding="8,3" CornerRadius="6" Background="#D0101216"
                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                Visibility="{Binding HasBadge, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding Badge}" FontSize="12" FontWeight="SemiBold" Foreground="#F5C542" />
                        </Border>
                        <Border Style="{StaticResource ShownByNotice}" CornerRadius="0,0,8,8" Padding="10,8"
                                Background="#E6101216" VerticalAlignment="Bottom">
                            <TextBlock Text="{Binding Notice}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" />
                        </Border>
                    </Grid>
                    <TextBlock Text="{Binding Title}" Margin="2,8,2,0" FontSize="14" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" />
                    <StackPanel Orientation="Horizontal" Margin="2,1,2,0">
                        <TextBlock Text="{Binding Price}" FontSize="13" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Regular}" Margin="8,0,0,0" FontSize="12" Opacity="0.5"
                                   TextDecorations="Strikethrough" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Shop}" Margin="8,0,0,0" FontSize="12" Opacity="0.55"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </Button>
        </DataTemplate>

        <!--
            A deal's card in the Old School layout, the size of a game's: its banner across the top at
            the banner's own shape, with how much is off in the corner that shows on the cards behind,
            and its name and price underneath on the front card only.
        -->
        <Style x:Key="OldSchoolDealButton" TargetType="Button">
            <Setter Property="Foreground" Value="#F2F3F5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Width="420" Height="320">
                            <Border CornerRadius="12">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#2B303C" Offset="0" />
                                        <GradientStop Color="#14171D" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <!-- A brush, not an image, so the picture keeps the card's round corners. -->
                            <Border Height="198" VerticalAlignment="Top" CornerRadius="12,12,0,0" RenderOptions.BitmapScalingMode="Linear">
                                <Border.Background>
                                    <ImageBrush ImageSource="{Binding Banner}" Stretch="UniformToFill" />
                                </Border.Background>
                            </Border>
                            <!-- The sheen across the top of the card. -->
                            <Border CornerRadius="12">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#30FFFFFF" Offset="0" />
                                        <GradientStop Color="#00FFFFFF" Offset="0.25" />
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <!-- At the right, which is the part of a card that shows from behind the one in front. -->
                            <Border Margin="12" Padding="9,3" CornerRadius="6" Background="#3FA34D"
                                    HorizontalAlignment="Right" VerticalAlignment="Top">
                                <TextBlock Text="{Binding Cut}" FontSize="17" FontWeight="Bold" />
                            </Border>
                            <!-- Only on the front card: the ones behind have theirs half covered. -->
                            <Grid Margin="20,0,20,18" VerticalAlignment="Bottom"
                                  Opacity="{Binding Path=(local:OldSchoolPanel.Front), RelativeSource={RelativeSource AncestorType=ContentPresenter}}">
                                <StackPanel Style="{StaticResource HiddenByNotice}">
                                    <TextBlock Text="{Binding Badge}" Margin="0,0,0,2" FontSize="13" FontWeight="SemiBold" Foreground="#F5C542"
                                               Visibility="{Binding HasBadge, Converter={StaticResource BoolToVis}}" />
                                    <TextBlock Text="{Binding Title}" FontSize="22" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                        <TextBlock Text="{Binding Price}" FontSize="16" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Regular}" Margin="10,0,0,0" FontSize="14" Opacity="0.6"
                                                   TextDecorations="Strikethrough" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Shop}" Margin="10,0,0,0" FontSize="14" Opacity="0.7"
                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    </StackPanel>
                                </StackPanel>
                                <TextBlock Style="{StaticResource ShownByNotice}" Text="{Binding Notice}" FontSize="20"
                                           FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Bottom" />
                            </Grid>
                            <Border x:Name="Ring" CornerRadius="14" Margin="-4" BorderThickness="3"
                                    BorderBrush="#F2F3F5" Opacity="0" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Ring" Property="Opacity" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <DataTemplate x:Key="OldSchoolDeal">
            <Button Style="{StaticResource OldSchoolDealButton}" Click="OnDealClick" GotKeyboardFocus="OnDealFocused" />
        </DataTemplate>

        <!--
            A card that does something, in the Old School layout: one of the settings' lists, a power
            action, or the way in to the games that are not installed. The green of the Xbox 360's own
            cards, with a white symbol towards the right, where it shows from behind the card in front.
        -->
        <Style x:Key="OldSchoolActionButton" TargetType="Button">
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Width="420" Height="320">
                            <Border CornerRadius="12">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#C6E04A" Offset="0" />
                                        <GradientStop Color="#9CC72A" Offset="0.45" />
                                        <GradientStop Color="#5E9412" Offset="0.8" />
                                        <GradientStop Color="#2F5708" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <!-- The sheen across the top of the card. -->
                            <Border CornerRadius="12">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#50FFFFFF" Offset="0" />
                                        <GradientStop Color="#00FFFFFF" Offset="0.35" />
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <!-- A shape and not text: text this big is not drawn at all on the small cards at the back. -->
                            <Path Data="{Binding Icon}" Fill="#FFFFFF" Stretch="Uniform" Width="116" Height="116"
                                  Margin="0,0,48,34" HorizontalAlignment="Right" VerticalAlignment="Center" Opacity="0.95" />
                            <!-- Only on the front card: the ones behind have theirs half covered. -->
                            <Grid Margin="20,0,20,18" VerticalAlignment="Bottom"
                                  Opacity="{Binding Path=(local:OldSchoolPanel.Front), RelativeSource={RelativeSource AncestorType=ContentPresenter}}">
                                <StackPanel Style="{StaticResource HiddenByNotice}">
                                    <TextBlock Text="{Binding Title}" FontSize="26" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Detail}" Margin="0,2,0,0" FontSize="14" Opacity="0.9" TextWrapping="Wrap"
                                               TextTrimming="CharacterEllipsis" MaxHeight="40"
                                               Visibility="{Binding HasDetail, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>
                                <TextBlock Style="{StaticResource ShownByNotice}" Text="{Binding Notice}" FontSize="20"
                                           FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Bottom" />
                            </Grid>
                            <Border x:Name="Ring" CornerRadius="14" Margin="-4" BorderThickness="3"
                                    BorderBrush="#F2F3F5" Opacity="0" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Ring" Property="Opacity" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <DataTemplate x:Key="OldSchoolAction">
            <Button Style="{StaticResource OldSchoolActionButton}" Click="OnActionClick" GotKeyboardFocus="OnActionFocused" />
        </DataTemplate>

        <!-- Controller button hint: a round glyph and its label. -->
        <Style x:Key="HintGlyph" TargetType="Border">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="CornerRadius" Value="13" />
            <Setter Property="Margin" Value="22,0,8,0" />
        </Style>

        <!-- Bumper hint at either end of the store filter. -->
        <Style x:Key="BumperGlyph" TargetType="Border">
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="Background" Value="#2A2F3A" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!--
            A tab in the top bar: a round button with the tab's icon or its store's logo. Not focusable, so
            keyboard focus stays on the tiles.
        -->
        <Style x:Key="FilterTab" TargetType="RadioButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Foreground" Value="#F2F3F5" />
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Pill" Width="44" Height="44" CornerRadius="22" Background="#59101216" Opacity="0.85">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Pill" Property="Background" Value="#22FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Pill" Property="Background" Value="#F2F3F5" />
                                <Setter TargetName="Pill" Property="Opacity" Value="1" />
                                <Setter Property="Foreground" Value="#101010" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A row in the quick actions menu: the action, and under it what it applies to. -->
        <Style x:Key="MenuButton" TargetType="Button">
            <Setter Property="Foreground" Value="#F2F3F5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Row" CornerRadius="8" Padding="{DynamicResource MenuRowPadding}" Margin="{DynamicResource MenuRowMargin}"
                                MinHeight="{DynamicResource MenuRowHeight}"
                                Background="{DynamicResource MenuRowBrush}" BorderThickness="2" BorderBrush="Transparent">
                            <!--
                                One line: the row's name, and at the right what it is set to now, which is
                                its Tag. A row that only opens something or does something has no Tag.
                            -->
                            <Grid VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}"
                                           FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                           Margin="18,0,0,0" FontSize="14.5" Opacity="0.75" TextTrimming="CharacterEllipsis"
                                           HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource MenuRowFocusBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource MenuRowFocusBrush}" />
                                <Setter TargetName="Row" Property="BorderBrush" Value="#F2F3F5" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Row" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A round glyph button in the top bar. Only the ones the d-pad can reach are focusable. -->
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Foreground" Value="#F2F3F5" />
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Disc" Width="44" Height="44" CornerRadius="22" Background="#59101216" Opacity="0.85"
                                BorderBrush="Transparent" BorderThickness="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Disc" Property="Background" Value="#22FFFFFF" />
                                <Setter TargetName="Disc" Property="Opacity" Value="1" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Disc" Property="Background" Value="#22FFFFFF" />
                                <Setter TargetName="Disc" Property="BorderBrush" Value="#F2F3F5" />
                                <Setter TargetName="Disc" Property="Opacity" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A button with words on it in the top bar, the shape of the search box it sits beside. -->
        <Style x:Key="PillButton" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Foreground" Value="#F2F3F5" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Pill" Height="40" CornerRadius="20" Padding="18,0" Background="#66101216"
                                BorderBrush="Transparent" BorderThickness="2">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Pill" Property="Background" Value="#22FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Pill" Property="Background" Value="#22FFFFFF" />
                                <Setter TargetName="Pill" Property="BorderBrush" Value="#F2F3F5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Save and Cancel under the launch arguments box, sized for a finger. -->
        <Style x:Key="DialogButton" TargetType="Button">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Foreground" Value="#F2F3F5" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Pill" CornerRadius="8" Padding="22,0" MinHeight="44" Background="#2C3240">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Pill" Property="Background" Value="#3A4254" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <!--
            The focused game's background, as a finished picture the size of the screen (see Backdrops):
            its colours or its artwork, with the shade that keeps tiles and text readable already in it.
            Two layers, so a new one can fade in over the old. Drawn pixel for pixel, never scaled, so they
            sit outside the part that docked mode makes bigger.
        -->
        <Rectangle x:Name="BackdropBack" Opacity="0" IsHitTestVisible="False"
                   RenderOptions.BitmapScalingMode="NearestNeighbor" />
        <Rectangle x:Name="BackdropFront" Opacity="0" IsHitTestVisible="False"
                   RenderOptions.BitmapScalingMode="NearestNeighbor" />

        <!-- Everything else, drawn bigger on a TV or monitor by docked mode. -->
        <Grid x:Name="ScaledContent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="48,14,48,8">
            <!-- Equal space either side keeps the round buttons in the middle of the screen. -->
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Hidden in the Old School layout, which has its list of categories for all of this. -->
            <StackPanel x:Name="TopBarCentre" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <!--
                    The tabs, each a round button: Games, Apps, the favourites and a tab per store when there
                    are some, and Not installed. The bumpers move between them.
                -->
                <StackPanel x:Name="FilterStrip" Orientation="Horizontal" Margin="0,-10,0,-10" VerticalAlignment="Center">
                    <Border Style="{StaticResource BumperGlyph}" Margin="0,0,10,0">
                        <TextBlock Text="LB" FontSize="12" FontWeight="Bold" />
                    </Border>
                    <StackPanel x:Name="FilterTabs" Orientation="Horizontal" />
                </StackPanel>

                <!--
                    Search, on the Not installed tab only. The button opens the search bar, which the d-pad
                    can then pick to type in, or leave for the store button beside it, which goes through the
                    stores the games are from. The games are narrowed down as each letter is typed.
                -->
                <Button x:Name="StoreButton" Style="{StaticResource PillButton}" Margin="0,-10,8,-10" MinWidth="132"
                        VerticalAlignment="Center" Focusable="True" GotKeyboardFocus="OnTopBarFocused" Visibility="Collapsed"
                        Content="All stores" ToolTip="Show one store's games" Click="OnStepSearchStore" />
                <Grid x:Name="SearchPanel" Margin="0,-10,8,-10" Width="336" Height="40" VerticalAlignment="Center"
                      Visibility="Collapsed">
                    <!-- The bar as the d-pad finds it: what was searched for, and A to type. -->
                    <Button x:Name="SearchBar" Style="{StaticResource PillButton}" HorizontalContentAlignment="Left"
                            Focusable="True" GotKeyboardFocus="OnTopBarFocused" ToolTip="Type to search" Click="OnBeginTyping">
                        <TextBlock x:Name="SearchText" Text="Search" Width="296" FontSize="16" Opacity="0.6"
                                   TextTrimming="CharacterEllipsis" />
                    </Button>
                    <!-- The bar while it is typed in. Focusing the box brings up Windows' own keyboard. -->
                    <Border x:Name="SearchEntry" Padding="18,0" CornerRadius="20" Background="#66101216"
                            BorderBrush="#F2F3F5" BorderThickness="2" Visibility="Collapsed">
                        <Grid>
                            <TextBox x:Name="SearchBox" MaxLength="64" FontSize="16" VerticalAlignment="Center"
                                     Background="Transparent" BorderThickness="0" Foreground="#F2F3F5" CaretBrush="#F2F3F5"
                                     TextChanged="OnSearchChanged" GotKeyboardFocus="OnSearchFocusChanged"
                                     LostKeyboardFocus="OnSearchFocusChanged" />
                            <!-- In the middle of the box until the first letter is typed. -->
                            <TextBlock x:Name="SearchHint" Text="Menu done, View clear" FontSize="12.5" Opacity="0.6"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"
                                       Visibility="Collapsed" />
                        </Grid>
                    </Border>
                </Grid>
                <Button x:Name="SearchButton" Style="{StaticResource IconButton}" Margin="0,-10,4,-10" VerticalAlignment="Center"
                        Focusable="True" GotKeyboardFocus="OnTopBarFocused" Visibility="Collapsed"
                        Content="&#xE721;" ToolTip="Search the games that are not installed" Click="OnOpenSearch" />

                <!--
                    The library's settings, also on the controller's Menu button. Sized for a finger. Up from
                    the top row of games reaches these buttons, as the bumpers do after the last tab, and A
                    presses the one in focus.
                -->
                <Button x:Name="SettingsButton" Style="{StaticResource IconButton}" Margin="0,-10,4,-10" VerticalAlignment="Center"
                        Focusable="True" GotKeyboardFocus="OnTopBarFocused"
                        Content="&#xE713;" ToolTip="Settings" Click="OnOpenSettings" />

                <!-- Sleep, hibernate, restart and shut down, also on the controller's View button. -->
                <Button x:Name="PowerButton" Style="{StaticResource IconButton}" Margin="0,-10,0,-10" VerticalAlignment="Center"
                        Focusable="True" GotKeyboardFocus="OnTopBarFocused"
                        Content="&#xE7E8;" ToolTip="Power" Click="OnOpenPower" />

                <!-- The bumpers go along the whole row, tabs and buttons alike. -->
                <Border Style="{StaticResource BumperGlyph}" Margin="10,0,0,0">
                    <TextBlock Text="RB" FontSize="12" FontWeight="Bold" />
                </Border>
            </StackPanel>

            <!-- Wi-Fi, the battery and the clock stay at the right. -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">

                <!-- Wi-Fi signal: four bars, lit up to the current strength. -->
                <StackPanel x:Name="WifiBars" Orientation="Horizontal" Height="16" Margin="0,0,20,0"
                            VerticalAlignment="Center" Visibility="Collapsed">
                    <Rectangle Width="4" Height="4" Margin="0,0,2,0" RadiusX="1" RadiusY="1" Fill="#F2F3F5" VerticalAlignment="Bottom" />
                    <Rectangle Width="4" Height="8" Margin="0,0,2,0" RadiusX="1" RadiusY="1" Fill="#F2F3F5" VerticalAlignment="Bottom" />
                    <Rectangle Width="4" Height="12" Margin="0,0,2,0" RadiusX="1" RadiusY="1" Fill="#F2F3F5" VerticalAlignment="Bottom" />
                    <Rectangle Width="4" Height="16" RadiusX="1" RadiusY="1" Fill="#F2F3F5" VerticalAlignment="Bottom" />
                </StackPanel>

                <StackPanel x:Name="BatteryPanel" Orientation="Horizontal" Margin="0,0,20,0"
                            VerticalAlignment="Center" Visibility="Collapsed">
                    <Path x:Name="ChargingBolt" Data="M7,0 L1,9 L5,9 L3,16 L10,6 L6,6 Z" Fill="#F2F3F5" Opacity="0.8"
                          Margin="0,0,6,0" VerticalAlignment="Center" />
                    <Border Width="28" Height="14" CornerRadius="3" BorderThickness="1.5" BorderBrush="#CCF2F3F5"
                            VerticalAlignment="Center">
                        <Rectangle x:Name="BatteryFill" Margin="1.5" RadiusX="1" RadiusY="1" Fill="#F2F3F5"
                                   HorizontalAlignment="Left" />
                    </Border>
                    <Rectangle Width="2" Height="6" Margin="1,0,0,0" Fill="#CCF2F3F5" VerticalAlignment="Center" />
                    <TextBlock x:Name="BatteryText" Margin="8,0,0,0" FontSize="16" Opacity="0.8" VerticalAlignment="Center" />
                </StackPanel>

                <TextBlock x:Name="ClockText" FontSize="20" Opacity="0.8" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="1">
            <!-- A newer release is on GitHub. The controller reaches the same action in Settings. -->
            <Border x:Name="UpdateBanner" Margin="48,0,48,12" Padding="18,8,8,8" CornerRadius="10"
                    Background="#222630" Visibility="Collapsed">
                <Grid>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="UpdateText" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="Opens Handheld Optimiser to install it. Also in Settings." Margin="0,2,0,0"
                                   FontSize="12.5" Opacity="0.6" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Style="{StaticResource DialogButton}" Content="Update now" Click="OnUpdateNow" />
                        <Button Style="{StaticResource IconButton}" Margin="6,0,0,0" FontSize="14"
                                Content="&#xE711;" ToolTip="Dismiss" Click="OnDismissUpdate" />
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>

        <!--
            The Old School layout's Not installed card, opened: one card nearly the size of the screen,
            which the page below is laid out inside for as long as it is open, so the games that are not
            installed scroll within it. The search is moved into its heading from the top bar. See
            LibraryWindow.NotInstalledCard.cs, which has the page's edges to match the sizes here.
        -->
        <Grid x:Name="OpenCard" Grid.Row="2" Margin="24,0,24,0" Visibility="Collapsed">
            <Border x:Name="OpenCardBack" CornerRadius="14" Background="{StaticResource OldSchoolGreenBack}" />
            <Grid x:Name="OpenCardHeading" Height="60" Margin="14,0,14,0" VerticalAlignment="Top" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- For a finger or the mouse. B does the same on the controller. -->
                    <Button Style="{StaticResource IconButton}" Margin="0,0,14,0" FontSize="16" VerticalAlignment="Center"
                            Content="&#xE72B;" ToolTip="Back to the cards" Click="OnCloseOpenCard" />
                    <TextBlock Text="Not installed" FontSize="26" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock x:Name="OpenCardCount" Margin="14,0,0,0" FontSize="15" Opacity="0.75" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel x:Name="OpenCardSearch" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>
        </Grid>

        <ScrollViewer x:Name="Scroller" Grid.Row="2" VerticalScrollBarVisibility="Hidden" PanningMode="VerticalOnly"
                      Padding="38,4,38,24" Focusable="False">
            <StackPanel x:Name="Page">
                <!--
                    Last played: the last game played as a wide card above the games, on the Games tab. In
                    the middle and bigger above the grid, and at the left above the row.
                -->
                <StackPanel x:Name="ContinuePanel" Visibility="Collapsed">
                    <TextBlock Text="Last played" Margin="10,20,0,6" FontSize="22" FontWeight="SemiBold" Opacity="0.85" />

                    <!--
                        Above the grid the card and the panel beside it are drawn one and a half times the size
                        they are laid out at below, as ContinueScale in LibraryWindow.ContinueInfo.cs, in the
                        middle of the screen. When they fill it the margin keeps their edges in line with the
                        tiles'. UpdateContinue sets both for the layout in use.
                    -->
                    <Grid x:Name="ContinueRow" Margin="-5,0,-5,0" HorizontalAlignment="Center">
                        <Grid.LayoutTransform>
                            <ScaleTransform x:Name="ContinueZoom" ScaleX="1.5" ScaleY="1.5" />
                        </Grid.LayoutTransform>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="ContinueCard" Style="{StaticResource CardButton}" Click="OnTileClick"
                                GotKeyboardFocus="OnTileFocused" MouseRightButtonUp="OnTileRightClick">
                            <Grid Width="560" Height="270">
                                <Border x:Name="ContinueBack" CornerRadius="8" ClipToBounds="True">
                                    <Image x:Name="ContinueArt" Stretch="UniformToFill" Opacity="0.6"
                                           RenderOptions.BitmapScalingMode="HighQuality" />
                                </Border>
                                <Border CornerRadius="8">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#C0000000" Offset="0" />
                                            <GradientStop Color="#00000000" Offset="1" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                                <StackPanel Orientation="Horizontal" Margin="16">
                                    <Border Width="159" Height="238" CornerRadius="6" ClipToBounds="True" Background="{Binding Background}">
                                        <Grid>
                                            <Image Source="{Binding Cover}" Stretch="UniformToFill"
                                                   RenderOptions.BitmapScalingMode="HighQuality" />
                                            <Image Source="{Binding Icon}" Width="72" Height="72"
                                                   RenderOptions.BitmapScalingMode="HighQuality"
                                                   Visibility="{Binding ShowsIcon, Converter={StaticResource BoolToVis}}" />
                                            <Border Width="26" Height="26" CornerRadius="13" Margin="6" Background="#D0101216"
                                                    HorizontalAlignment="Right" VerticalAlignment="Bottom">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding StoreLogo}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Path Data="{Binding StoreLogo}" Fill="#F2F3F5" Stretch="Uniform" Width="14" Height="14"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                    <StackPanel Width="340" Margin="20,0,0,4" VerticalAlignment="Bottom">
                                        <TextBlock Style="{StaticResource HiddenByNotice}" Text="{Binding Title}" FontSize="26"
                                                   FontWeight="SemiBold"
                                                   TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="72" />
                                        <TextBlock Style="{StaticResource ShownByNotice}" Text="{Binding Notice}" FontSize="20"
                                                   FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <TextBlock x:Name="ContinueDetail" Margin="0,2,0,0" FontSize="14" Opacity="0.7"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Button>

                        <!-- About the game on the card: its play time and the like, and its store's description. -->
                        <Border x:Name="ContinueInfo" Grid.Column="1" Height="270" Margin="10" Padding="22,18" CornerRadius="8"
                                Background="#66101216" Visibility="Collapsed">
                            <DockPanel>
                                <ItemsControl x:Name="ContinueRows" DockPanel.Dock="Left" Focusable="False" VerticalAlignment="Top">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="108" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Label}" FontSize="14" Opacity="0.6" />
                                                <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="14"
                                                           TextTrimming="CharacterEllipsis" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <!-- Wikipedia's text is free to show when it is credited. -->
                                <TextBlock x:Name="ContinueSource" DockPanel.Dock="Bottom" Margin="28,8,0,0" FontSize="11"
                                           Opacity="0.5" Visibility="Collapsed" />
                                <TextBlock x:Name="ContinueAbout" Margin="28,0,0,0" FontSize="15" LineHeight="23" Opacity="0.85"
                                           TextWrapping="Wrap" TextTrimming="CharacterEllipsis" Visibility="Collapsed" />
                            </DockPanel>
                        </Border>
                    </Grid>
                    <TextBlock x:Name="AllGamesHeading" Text="Game library" Margin="10,36,0,6" FontSize="22" FontWeight="SemiBold" Opacity="0.85" />
                </StackPanel>

                <!--
                    The Old School layout's categories, in place of the tabs and buttons along the top: the
                    open one's name just above its cards, and the others stacked above it, smaller and
                    fainter the further they are. A press on a name opens it.
                -->
                <ItemsControl x:Name="Categories" Margin="14,0,0,4" Focusable="False" Visibility="Collapsed">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <local:OldSchoolListPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="Transparent" Padding="0,2,24,2" Cursor="Hand" MouseLeftButtonDown="OnCategoryPressed">
                                <StackPanel Orientation="Horizontal">
                                    <!-- The mark beside the open one. -->
                                    <Rectangle Width="11" Height="11" Margin="0,5,12,0" Fill="#F2F3F5" VerticalAlignment="Center"
                                               Opacity="{Binding Path=(local:OldSchoolListPanel.Open), RelativeSource={RelativeSource AncestorType=ContentPresenter}}" />
                                    <TextBlock Text="{Binding Name}" FontSize="44" FontWeight="SemiBold" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- The games. In the row layout this scrolls them across; in the grid it does nothing. -->
                <ScrollViewer x:Name="TilesScroller" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Disabled"
                              PanningMode="None" Focusable="False" PreviewMouseWheel="OnTilesWheel">
                    <ItemsControl x:Name="Tiles" Focusable="False" KeyboardNavigation.DirectionalNavigation="Contained"
                                  ItemsPanel="{StaticResource GridPanel}" ItemTemplate="{StaticResource GridTile}" />
                </ScrollViewer>


                <!--
                    Deals: Epic's free games and the games on sale from IsThereAnyDeal, below the games. Only
                    when switched on, on the Games tab. Below the grid they are one row that scrolls across.
                    Below the row of games there is a card for each place the deals are from, and pressing
                    one shows its deals in a grid underneath.
                -->
                <StackPanel x:Name="DealsPanel" Margin="0,18,0,0" Visibility="Collapsed">
                    <StackPanel x:Name="DealsHeading" Orientation="Horizontal" Margin="10,0,0,2">
                        <TextBlock Text="Deals" FontSize="22" FontWeight="SemiBold" Opacity="0.85" />
                        <TextBlock x:Name="DealsSource" Text="Prices from IsThereAnyDeal" Margin="12,0,0,2" FontSize="13" Opacity="0.5"
                                   VerticalAlignment="Bottom" />
                    </StackPanel>
                    <ItemsControl x:Name="DealSources" Focusable="False" Visibility="Collapsed">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource CardButton}" Click="OnDealSourceClick" GotKeyboardFocus="OnDealSourceFocused">
                                    <Grid Width="440" Height="150">
                                        <Border CornerRadius="8" ClipToBounds="True" Background="#262B36">
                                            <Image Source="{Binding Banner}" Stretch="UniformToFill"
                                                   RenderOptions.BitmapScalingMode="HighQuality" />
                                        </Border>
                                        <Border CornerRadius="8">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                    <GradientStop Color="#00000000" Offset="0.15" />
                                                    <GradientStop Color="#D8000000" Offset="1" />
                                                </LinearGradientBrush>
                                            </Border.Background>
                                        </Border>
                                        <StackPanel Style="{StaticResource HiddenByNotice}" Margin="16,0,16,12" VerticalAlignment="Bottom">
                                            <TextBlock Text="{Binding Title}" FontSize="19" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Detail}" Margin="0,2,0,0" FontSize="13" Opacity="0.8"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <TextBlock Style="{StaticResource ShownByNotice}" Text="{Binding Notice}" Margin="16,0,16,12"
                                                   FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Bottom" />
                                        <!-- A mark in the corner while its deals are showing underneath. -->
                                        <Border Margin="10" Padding="8,3" CornerRadius="6" Background="#F2F3F5"
                                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                                Visibility="{Binding IsOpen, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="Showing below" FontSize="12" FontWeight="SemiBold" Foreground="#101010" />
                                        </Border>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ScrollViewer x:Name="DealsScroller" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                                  PanningMode="HorizontalOnly" Focusable="False" PreviewMouseWheel="OnDealsWheel">
                        <ItemsControl x:Name="DealTiles" Focusable="False" ItemsPanel="{StaticResource RowPanel}"
                                      ItemTemplate="{StaticResource DealCard}" />
                    </ScrollViewer>

                </StackPanel>

                <!--
                    The cards of an Old School category that is not games or deals: the settings' lists, the
                    power actions, and the way in to the games that are not installed.
                -->
                <ItemsControl x:Name="ActionCards" Margin="10,6,10,0" Focusable="False" Visibility="Collapsed"
                              ItemsPanel="{StaticResource OldSchoolPanel}" ItemTemplate="{StaticResource OldSchoolAction}" />
            </StackPanel>
        </ScrollViewer>

        <TextBlock x:Name="EmptyText" Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center"
                   FontSize="18" Opacity="0.6" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="560" />

        <!--
            The button hints. A, which changes with what has the focus, and X are at the left, and the
            rest are at the right, with View and Menu each above what it opens. Margins that keep the bar the
            height it was with everything in one line, so the Old School cards above it still fit.
        -->
        <Grid Grid.Row="3" Margin="48,2,48,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                <Border Style="{StaticResource HintGlyph}" Margin="0,0,8,0" Background="#3FA34D">
                    <TextBlock Text="A" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock x:Name="AcceptHint" Text="Play" FontSize="15" VerticalAlignment="Center" />
                <StackPanel x:Name="OptionsHint" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Style="{StaticResource HintGlyph}" Background="#2F6FD0">
                        <TextBlock Text="X" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Options" FontSize="15" VerticalAlignment="Center" />
                </StackPanel>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <!-- Only while the Old School layout's Not installed card is open, which B closes. -->
                <StackPanel x:Name="BackHint" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                    <Border Style="{StaticResource HintGlyph}" Background="#C8423B">
                        <TextBlock Text="B" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Back" FontSize="15" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Margin="26,0,0,0" VerticalAlignment="Center">
                    <Border Style="{StaticResource BumperGlyph}" HorizontalAlignment="Center">
                        <TextBlock Text="VIEW" FontSize="11" FontWeight="Bold" />
                    </Border>
                    <TextBlock Text="Power" Margin="0,3,0,0" FontSize="15" HorizontalAlignment="Center" />
                </StackPanel>
                <StackPanel Margin="22,0,0,0" VerticalAlignment="Center">
                    <Border Style="{StaticResource BumperGlyph}" HorizontalAlignment="Center">
                        <TextBlock Text="MENU" FontSize="11" FontWeight="Bold" />
                    </Border>
                    <TextBlock Text="Settings" Margin="0,3,0,0" FontSize="15" HorizontalAlignment="Center" />
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- Quick actions for one game, over the dimmed library. Tapping outside the panel closes it. -->
        <Grid x:Name="MenuOverlay" Grid.RowSpan="4" Background="#C0000000" Visibility="Collapsed"
              MouseLeftButtonDown="OnMenuBackdropClick">
            <!--
                Over the dimmed library in the grid and the row. In the Old School layout it is put where
                the front card is and shown as that card's other side: see LibraryWindow.CardFlip.cs.
            -->
            <Border x:Name="MenuBox" Width="560" Margin="0,24" Padding="28,24,28,20" CornerRadius="12" Background="#181B22"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.DirectionalNavigation="Contained">
                <!-- Scrolls when the list is taller than the screen, as on a small or heavily scaled display. -->
                <ScrollViewer x:Name="MenuScroller" VerticalScrollBarVisibility="Hidden" PanningMode="VerticalOnly" Focusable="False">
                <StackPanel>
                    <TextBlock x:Name="MenuTitle" FontSize="22" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="MenuStore" Margin="0,2,0,18" FontSize="13" Opacity="0.55" />
                    <!-- A notice raised while the menu is open, such as that a setting could not be saved. -->
                    <TextBlock x:Name="MenuNotice" Margin="0,-6,0,12" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"
                               Visibility="Collapsed" />

                    <StackPanel x:Name="GameItems">
                        <!-- Only for a game that is not installed, which has none of the other rows but Hide. -->
                        <Button x:Name="InstallItem" Style="{StaticResource MenuButton}" Content="Install"
                                Visibility="Collapsed" Click="OnInstall" />
                        <Button x:Name="FavouriteItem" Style="{StaticResource MenuButton}" Click="OnToggleFavourite" />
                        <Button x:Name="ProfileItem" Style="{StaticResource MenuButton}" Content="Game profile"
                                Click="OnOpenProfile" />
                        <!-- Only for a game on the recommended settings list. -->
                        <Button x:Name="RecommendedItem" Style="{StaticResource MenuButton}" Content="Optimised settings"
                                Visibility="Collapsed" Click="OnOpenRecommended" />
                        <!-- Only for a program the player added: moves it between the games and Apps. -->
                        <Button x:Name="MoveItem" Style="{StaticResource MenuButton}" Click="OnToggleApp" />
                        <Button x:Name="ArgumentsItem" Style="{StaticResource MenuButton}" Content="Launch arguments"
                                Click="OnEditArguments" />
                        <Button x:Name="FolderItem" Style="{StaticResource MenuButton}" Content="Open install folder"
                                Click="OnOpenFolder" />
                        <Button x:Name="PropertiesItem" Style="{StaticResource MenuButton}" Content="Executable properties"
                                Click="OnShowProperties" />
                        <Button x:Name="ArtworkItem" Style="{StaticResource MenuButton}" Content="Artwork"
                                Click="OnEditArtworkTitle" />
                        <Button x:Name="CloseGameItem" Style="{StaticResource MenuButton}" Content="Close game"
                                Visibility="Collapsed" Click="OnCloseGame" LostKeyboardFocus="OnCloseGameLostFocus" />
                        <Button x:Name="HideItem" Style="{StaticResource MenuButton}" Click="OnToggleHidden" />

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                            <Border Style="{StaticResource HintGlyph}" Background="#3FA34D">
                                <TextBlock Text="A" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="Select" FontSize="15" VerticalAlignment="Center" />
                            <Border Style="{StaticResource HintGlyph}" Background="#C8423B">
                                <TextBlock Text="B" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="Back" FontSize="15" VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>

                    <!-- The library's settings: a short list of categories, each with its groups of settings behind it. -->
                    <StackPanel x:Name="SettingsItems" Visibility="Collapsed">
                        <Button x:Name="UpdateSetting" Style="{StaticResource MenuButton}" Content="Update now"
                                Visibility="Collapsed" Click="OnUpdateNow" />
                        <Button x:Name="LibraryDisplayGroup" Style="{StaticResource MenuButton}" Content="Library Display" Click="OnOpenLibraryDisplay" />
                        <Button x:Name="GamesAppsGroup" Style="{StaticResource MenuButton}" Content="Games and Apps" Click="OnOpenGamesApps" />
                        <Button x:Name="SleepTweaksGroup" Style="{StaticResource MenuButton}" Content="Sleep and Tweaks" Click="OnOpenSleepTweaks" />
                        <Button x:Name="RescanItem" Style="{StaticResource MenuButton}" Content="Refresh library" Click="OnRescan" />
                        <Button x:Name="QuitSetting" Style="{StaticResource MenuButton}" Content="Quit" Click="OnQuit" />

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                            <Border Style="{StaticResource HintGlyph}" Background="#3FA34D">
                                <TextBlock Text="A" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="Select" FontSize="15" VerticalAlignment="Center" />
                            <Border Style="{StaticResource HintGlyph}" Background="#C8423B">
                                <TextBlock Text="B" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="Back" FontSize="15" VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Library Display: how the library looks, on the built-in screen and docked. -->
                    <StackPanel x:Name="LibraryDisplayItems" Visibility="Collapsed">
                        <Button x:Name="BackgroundGroup" Style="{StaticResource MenuButton}" Content="Art and Background" Click="OnOpenBackgroundSettings" />
                        <Button x:Name="DisplayGroup" Style="{StaticResource MenuButton}" Content="Library View Options" Click="OnOpenDisplaySettings" />
                        <Button x:Name="TvGroup" Style="{StaticResource MenuButton}" Content="Docked mode" Click="OnOpenTvSettings" />
                        <!-- For touch, which has no B button. -->
                        <Button Style="{StaticResource MenuButton}" Content="Back" Click="OnSettingsBack" />

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                            <Border Style="{StaticResource HintGlyph}" Background="#3FA34D">
                                <TextBlock Text="A" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="Select" FontSize="15" VerticalAlignment="Center" />
                            <Border Style="{StaticResource HintGlyph}" Background="#C8423B">
                                <TextBlock Text="B" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="Back" FontSize="15" VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Games and Apps: what the library lists besides the installed games. -->
                    <StackPanel x:Name="GamesAppsItems" Visibility="Collapsed">
                        <Button x:Name="OwnedGroup" Style="{StaticResource MenuButton}" Content="Games not installed" Click="OnOpenOwnedSettings" />
                        <Button x:Name="DealsGroup" Style="{StaticResource MenuButton}" Content="Game deals" Click="OnOpenDealsSettings" />
                        <Button x:Name="EmulatorsGroup" Style="{StaticResource MenuButton}" Content="Emulators" Click="OnOpenEmulators" />
                        <Button x:Name="AddProgramGroup" Style="{StaticResource MenuButton}" Content="Add a program" Click="OnOpenAddProgram" />
                        <!-- For touch, which has no B button. -->
                        <Button Style="{StaticResource MenuButton}" Content="Back" Click="OnSettingsBack" />

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                            <Border Style="{StaticResource HintGlyph}" Background="#3FA34D">
                                <TextBlock Text="A" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="Select" FontSize="15" VerticalAlignment="Center" />
                            <Border Style="{StaticResource HintGlyph}" Background="#C8423B">
                                <TextBlock Text="B" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="Back" FontSize="15" VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Sleep and Tweaks: what happens around a game and sleep, clean-ups, and the main app. -->
                    <StackPanel x:Name="SleepTweaksItems" Visibility="Collapsed">
                        <Button x:Name="WhilePlayingGroup" Style="{StaticResource MenuButton}" Content="Play and Sleep" Click="OnOpenWhilePlaying" />
                        <Button x:Name="MaintenanceGroup" Style="{StaticResource MenuButton}" Content="Quick Tweaks" Click="OnOpenMaintenance" />
                        <Button x:Name="OpenMainAppSetting" Style="{StaticResource MenuButton}" Content="Launch Handheld Optimiser" Click="OnOpenMainApp" />
                        <!-- For touch, which has no B button. -->
                        <Button Style="{StaticResource MenuButton}" Content="Back" Click="OnSettingsBack" />

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                            <Border Style="{StaticResource HintGlyph}" Background="#3FA34D">
                                <TextBlock Text="A" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="Select" FontSize="15" VerticalAlignment="Center" />
                            <Border Style="{StaticResource HintGlyph}" Background="#C8423B">
                                <TextBlock Text="B" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="Back" FontSize="15" VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>

                    <!-- The background settings. A steps a row to its next value. -->
                    <StackPanel x:Name="BackgroundItems" Visibility="Collapsed">
                        <Button x:Name="BackgroundSetting" Style="{StaticResource MenuButton}" Content="Background"
                                Click="OnCycleBackground" />
                        <Button x:Name="StrengthSetting" Style="{StaticResource MenuButton}" Content="Colour strength"
                                Click="OnCycleStrength" />
                        <Button x:Name="BlurSetting" Style="{StaticResource MenuButton}" Content="Artwork blur"
                                Click="OnCycleBlur" />
                        <Button x:Name="PositionSetting" Style="{StaticResource MenuButton}" Content="Artwork position"
                                Click="OnCyclePosition" />
                        <Button x:Name="ArtworkKeySetting" Style="{StaticResource MenuButton}" Content="SteamGridDB API key"
                                Click="OnEditArtworkKey" />
                        <!-- For touch, which has no B button. -->
                        <Button Style="{StaticResource MenuButton}" Content="Back" Click="OnSettingsBack" />

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                            <Border Style="{StaticResource HintGlyph}" Background="#3FA34D">
                                <TextBlock Text="A" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="Change" FontSize="15" VerticalAlignment="Center" />
                            <Border Style="{StaticResource HintGlyph}" Background="#C8423B">
                                <TextBlock Text="B" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="Back" FontSize="15" VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>

                    <!-- What the library shows and which buttons it offers. A switches a row on or off. -->
                    <StackPanel x:Name="DisplayItems" Visibility="Collapsed">
                        <Button x:Name="LayoutSetting" Style="{StaticResource MenuButton}" Content="Layout"
                                Click="OnStepLayout" />
                        <Button x:Name="ContinueSetting" Style="{StaticResource MenuButton}" Content="Last played"
                                Click="OnToggleContinue" />
                        <Button x:Name="ContinueInfoSetting" Style="{StaticResource MenuButton}" Content="Game info"
                                Click="OnToggleContinueInfo" />
                        <Button x:Name="StoreDetailsSetting" Style="{StaticResource MenuButton}" Content="Store details"
                                Click="OnToggleStoreDetails" />
                        <Button x:Name="StatusSetting" Style="{StaticResource MenuButton}" Content="Battery and Wi-Fi"
                                Click="OnToggleStatus" />
                        <Button x:Name="FilterSetting" Style="{StaticResource MenuButton}" Content="Store filter"
                                Click="OnToggleFilter" />
                        <Button x:Name="QuickActionsSetting" Style="{StaticResource MenuButton}" Content="Quick actions"
                                Click="OnToggleQuickActions" />
                        <Button x:Name="HiddenSetting" Style="{StaticResource MenuButton}" Content="Show hidden games"
                                Click="OnToggleShowHidden" />
                        <Button x:Name="SortSetting" Style="{StaticResource MenuButton}" Content="Sort games"
                                Click="OnStepSort" />
                        <!-- For touch, which has no B button. -->
                        <Button Style="{StaticResource MenuButton}" Content="Back" Click="OnSettingsBack" />

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                            <Border Style="{StaticResource HintGlyph}" Background="#3FA34D">
                                <TextBlock Text="A" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="Change" FontSize="15" VerticalAlignment="Center" />
                            <Border Style="{StaticResource HintGlyph}" Background="#C8423B">
                                <TextBlock Text="B" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="Back" FontSize="15" VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>

                    <!-- The power menu. Restart and Shut down take a second press, so a stray A cannot end a session. -->
                    <StackPanel x:Name="PowerItems" Visibility="Collapsed">
                        <Button x:Name="SleepItem" Style="{StaticResource MenuButton}" Content="Sleep" Click="OnSleep" />
                        <Button x:Name="HibernateItem" Style="{StaticResource MenuButton}" Content="Hibernate" Click="OnHibernate" />
                        <Button x:Name="RestartItem" Style="{StaticResource MenuButton}" Content="Restart"
                                Click="OnRestart" LostKeyboardFocus="OnPowerRowLostFocus" />
                        <Button x:Name="ShutDownItem" Style="{StaticResource MenuButton}" Content="Shut down"
                                Click="OnShutDown" LostKeyboardFocus="OnPowerRowLostFocus" />

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                            <Border Style="{StaticResource HintGlyph}" Background="#3FA34D">
                                <TextBlock Text="A" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="Select" FontSize="15" VerticalAlignment="Center" />
                            <Border Style="{StaticResource HintGlyph}" Background="#C8423B">
                                <TextBlock Text="B" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="Back" FontSize="15" VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>

                    <!--
                        Quick settings, like Armoury Crate's Command Center. Left and right adjust a row; A
                        mutes the volume and steps the other rows on, for touch.
                    -->
                    <StackPanel x:Name="QuickItems" Visibility="Collapsed">
                        <Button x:Name="VolumeSetting" Style="{StaticResource MenuButton}" Content="Volume"
                                Click="OnToggleMute" />
                        <Button x:Name="BrightnessSetting" Style="{StaticResource MenuButton}" Content="Brightness"
                                Click="OnStepBrightness" />
                        <Button x:Name="PowerModeSetting" Style="{StaticResource MenuButton}" Content="Power mode"
                                Click="OnStepPowerMode" />
                        <Button x:Name="ResolutionSetting" Style="{StaticResource MenuButton}" Content="Resolution"
                                Click="OnStepResolution" />
                        <Button x:Name="RefreshRateSetting" Style="{StaticResource MenuButton}" Content="Refresh rate"
                                Click="OnStepRefreshRate" />
                        <Button x:Name="CloseAppsNowItem" Style="{StaticResource MenuButton}" Content="Close background programs"
                                Click="OnCloseAppsNow" />

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                            <Border Style="{StaticResource BumperGlyph}" Margin="22,0,8,0">
                                <TextBlock Text="&#x25C0; &#x25B6;" FontSize="11" FontWeight="Bold" />
                            </Border>
                            <TextBlock Text="Adjust" FontSize="15" VerticalAlignment="Center" />
                            <Border Style="{StaticResource HintGlyph}" Background="#3FA34D">
                                <TextBlock Text="A" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="Select" FontSize="15" VerticalAlignment="Center" />
                            <Border Style="{StaticResource HintGlyph}" Background="#C8423B">
                                <TextBlock Text="B" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="Close" FontSize="15" VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>

                    <!-- One game's profile, switched to when it starts from the library. -->
                    <StackPanel x:Name="ProfileItems" Visibility="Collapsed">
                        <Button x:Name="ProfilePowerSetting" Style="{StaticResource MenuButton}" Content="Power mode"
                                Click="OnStepProfilePower" />
                        <Button x:Name="ProfileResolutionSetting" Style="{StaticResource MenuButton}" Content="Resolution"
                                Click="OnStepProfileResolution" />
                        <Button x:Name="ProfileRefreshSetting" Style="{StaticResource MenuButton}" Content="Refresh rate"
                                Click="OnStepProfileRefresh" />
                        <Button x:Name="ProfileBrightnessSetting" Style="{StaticResource MenuButton}" Content="Brightness"
                                Click="OnStepProfileBrightness" />
                        <Button x:Name="ProfileAppsSetting" Style="{StaticResource MenuButton}" Content="Background programs"
                                Click="OnStepProfileApps" />
                        <Button x:Name="ProfileAutoTdpSetting" Style="{StaticResource MenuButton}" Content="TDP Engine"
                                Click="OnStepProfileAutoTdp" />
                        <!-- For touch, which has no B button. -->
                        <Button Style="{StaticResource MenuButton}" Content="Back" Click="OnSettingsBack" />

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                            <Border Style="{StaticResource BumperGlyph}" Margin="22,0,8,0">
                                <TextBlock Text="&#x25C0; &#x25B6;" FontSize="11" FontWeight="Bold" />
                            </Border>
                            <TextBlock Text="Adjust" FontSize="15" VerticalAlignment="Center" />
                            <Border Style="{StaticResource HintGlyph}" Background="#3FA34D">
                                <TextBlock Text="A" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="Change" FontSize="15" VerticalAlignment="Center" />
                            <Border Style="{StaticResource HintGlyph}" Background="#C8423B">
                                <TextBlock Text="B" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="Back" FontSize="15" VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>

                    <!--
                        Optimised settings for one game. The device half can go into its profile with
                        one press; the in-game half is a list to set in the game's own menu. The text is not
                        in a StackPanel, which would be taken for the hints row and hidden on a card.
                    -->
                    <StackPanel x:Name="RecommendedItems" Visibility="Collapsed">
                        <TextBlock x:Name="RecommendedNote" Margin="4,0,4,14" FontSize="14.5" TextWrapping="Wrap" Opacity="0.85" />
                        <Button x:Name="RecommendedApplyItem" Style="{StaticResource MenuButton}" Content="Apply optimised settings"
                                Click="OnApplyRecommended" />
                        <TextBlock x:Name="RecommendedDevice" Margin="4,2,4,16" FontSize="13.5" TextWrapping="Wrap" Opacity="0.6" />
                        <TextBlock Text="Set these in the game" Margin="4,0,4,8" FontSize="16" FontWeight="SemiBold" />
                        <ItemsControl x:Name="RecommendedList" Margin="4,0,4,12" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Name}" FontSize="14.5" Opacity="0.8" TextWrapping="Wrap" />
                                        <TextBlock Grid.Column="1" Text="{Binding Value}" Margin="16,0,0,0" FontSize="14.5"
                                                   FontWeight="SemiBold" TextAlignment="Right" TextWrapping="Wrap" MaxWidth="260" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="RecommendedSource" Margin="4,0,4,12" FontSize="13" TextWrapping="Wrap" Opacity="0.55" />
                        <!-- For touch, which has no B button. -->
                        <Button x:Name="RecommendedBackItem" Style="{StaticResource MenuButton}" Content="Back" Click="OnSettingsBack" />

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                            <Border Style="{StaticResource HintGlyph}" Background="#3FA34D">
                                <TextBlock Text="A" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="Select" FontSize="15" VerticalAlignment="Center" />
                            <Border Style="{StaticResource HintGlyph}" Background="#C8423B">
                                <TextBlock Text="B" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="Back" FontSize="15" VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Programs from the Start menu are added as rows above the hints once they are found. -->
                    <StackPanel x:Name="AddItems" Visibility="Collapsed">
                        <Button x:Name="BrowseItem" Style="{StaticResource MenuButton}" Content="Browse for a program" Click="OnBrowseProgram" />
                        <!-- For touch, which has no B button. -->
                        <Button x:Name="AddBackItem" Style="{StaticResource MenuButton}" Content="Back"
                                Click="OnSettingsBack" />

                        <StackPanel x:Name="AddHints" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                            <Border Style="{StaticResource HintGlyph}" Background="#3FA34D">
                                <TextBlock Text="A" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="Add" FontSize="15" VerticalAlignment="Center" />
                            <Border Style="{StaticResource HintGlyph}" Background="#C8423B">
                                <TextBlock Text="B" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="Back" FontSize="15" VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Around games: closing background programs as one starts, and the store's app once it ends. -->
                    <StackPanel x:Name="WhilePlayingItems" Visibility="Collapsed">
                        <Button x:Name="GameModeSetting" Style="{StaticResource MenuButton}" Content="Close background programs"
                                Click="OnToggleGameMode" />
                        <Button x:Name="AppsToCloseGroup" Style="{StaticResource MenuButton}" Content="Programs to close"
                                Click="OnOpenAppsToClose" />
                        <Button x:Name="ReopenSetting" Style="{StaticResource MenuButton}" Content="Open them again afterwards"
                                Click="OnToggleReopen" />
                        <Button x:Name="AutoTdpSetting" Style="{StaticResource MenuButton}" Content="TDP Engine"
                                Click="OnStepAutoTdp" />
                        <Button x:Name="AutoTdpTemperatureSetting" Style="{StaticResource MenuButton}" Content="TDP Engine temperature limit"
                                Click="OnStepAutoTdpTemperature" />
                        <Button x:Name="AutoTdpWattsSetting" Style="{StaticResource MenuButton}" Content="TDP Engine most watts"
                                Click="OnStepAutoTdpWatts" />
                        <Button x:Name="StoreClosingSetting" Style="{StaticResource MenuButton}" Content="Close store apps after playing"
                                Click="OnStepStoreClosing" />
                        <Button x:Name="StoreStartupItem" Style="{StaticResource MenuButton}" Content="Store apps at startup" Click="OnOpenStoreStartup" />
                        <Button x:Name="QuickResumeSetting" Style="{StaticResource MenuButton}" Content="Quick Resume"
                                Click="OnToggleQuickResume" />
                        <Button x:Name="ResumeSetting" Style="{StaticResource MenuButton}" Content="Back to your game after sleep"
                                Click="OnToggleResume" />
                        <!-- For touch, which has no B button. -->
                        <Button Style="{StaticResource MenuButton}" Content="Back" Click="OnSettingsBack" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                            <Border Style="{StaticResource BumperGlyph}" Margin="22,0,8,0">
                                <TextBlock Text="&#x25C0; &#x25B6;" FontSize="11" FontWeight="Bold" />
                            </Border>
                            <TextBlock Text="Adjust" FontSize="15" VerticalAlignment="Center" />
                            <Border Style="{StaticResource HintGlyph}" Background="#3FA34D">
                                <TextBlock Text="A" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="Change" FontSize="15" VerticalAlignment="Center" />
                            <Border Style="{StaticResource HintGlyph}" Background="#C8423B">
                                <TextBlock Text="B" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="Back" FontSize="15" VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>

                    <!-- A row per program, added when the list opens. A switches whether it is closed. -->
                    <StackPanel x:Name="AppsToCloseItems" Visibility="Collapsed">
                        <Button x:Name="AddRunningAppItem" Style="{StaticResource MenuButton}" Content="Add a running program" Click="OnOpenRunningApps" />
                        <!-- For touch, which has no B button. -->
                        <Button x:Name="AppsToCloseBackItem" Style="{StaticResource MenuButton}" Content="Back"
                                Click="OnSettingsBack" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                            <Border Style="{StaticResource HintGlyph}" Background="#3FA34D">
                                <TextBlock Text="A" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="Change" FontSize="15" VerticalAlignment="Center" />
                            <Border Style="{StaticResource HintGlyph}" Background="#C8423B">
                                <TextBlock Text="B" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="Back" FontSize="15" VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>

                    <!-- The programs running now, added as rows when the list opens. -->
                    <StackPanel x:Name="RunningAppsItems" Visibility="Collapsed">
                        <!-- For touch, which has no B button. -->
                        <Button x:Name="RunningAppsBackItem" Style="{StaticResource MenuButton}" Content="Back"
                                Click="OnSettingsBack" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                            <Border Style="{StaticResource HintGlyph}" Background="#3FA34D">
                                <TextBlock Text="A" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="Add" FontSize="15" VerticalAlignment="Center" />
                            <Border Style="{StaticResource HintGlyph}" Background="#C8423B">
                                <TextBlock Text="B" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="Back" FontSize="15" VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Clean-ups a standard user may run, and the startup apps. Clearing takes a second press. -->
                    <StackPanel x:Name="MaintenanceItems" Visibility="Collapsed">
                        <Button x:Name="TempItem" Style="{StaticResource MenuButton}" Content="Clear temporary files"
                                Click="OnClearTemp" LostKeyboardFocus="OnConfirmRowLostFocus" />
                        <Button x:Name="ShaderItem" Style="{StaticResource MenuButton}" Content="Clear shader caches"
                                Click="OnClearShaders" LostKeyboardFocus="OnConfirmRowLostFocus" />
                        <Button x:Name="RecycleItem" Style="{StaticResource MenuButton}" Content="Empty the Recycle Bin"
                                Click="OnEmptyRecycleBin" LostKeyboardFocus="OnConfirmRowLostFocus" />
                        <Button x:Name="StartupGroup" Style="{StaticResource MenuButton}" Content="Startup apps"
                                Click="OnOpenStartup" />
                        <!-- For touch, which has no B button. -->
                        <Button Style="{StaticResource MenuButton}" Content="Back" Click="OnSettingsBack" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                            <Border Style="{StaticResource HintGlyph}" Background="#3FA34D">
                                <TextBlock Text="A" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="Select" FontSize="15" VerticalAlignment="Center" />
                            <Border Style="{StaticResource HintGlyph}" Background="#C8423B">
                                <TextBlock Text="B" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="Back" FontSize="15" VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>

                    <!-- A row per program that starts with Windows, added when the list opens. -->
                    <StackPanel x:Name="StartupItems" Visibility="Collapsed">
                        <!-- For touch, which has no B button. -->
                        <Button x:Name="StartupBackItem" Style="{StaticResource MenuButton}" Content="Back" Click="OnSettingsBack" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                            <Border Style="{StaticResource HintGlyph}" Background="#3FA34D">
                                <TextBlock Text="A" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="Change" FontSize="15" VerticalAlignment="Center" />
                            <Border Style="{StaticResource HintGlyph}" Background="#C8423B">
                                <TextBlock Text="B" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="Back" FontSize="15" VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>

                    <!-- A row per console found and per ROM folder, added when the list opens. -->
                    <StackPanel x:Name="EmulatorItems" Visibility="Collapsed">
                        <Button x:Name="AddRomFolderItem" Style="{StaticResource MenuButton}" Content="Add a ROM folder" Click="OnAddRomFolder" />
                        <Button x:Name="AddEmulatorItem" Style="{StaticResource MenuButton}" Content="Find an emulator" Click="OnAddEmulator" />
                        <Button x:Name="RescanEmulatorsItem" Style="{StaticResource MenuButton}" Content="Look again" Click="OnRescanEmulators" />
                        <!-- For touch, which has no B button. -->
                        <Button x:Name="EmulatorsBackItem" Style="{StaticResource MenuButton}" Content="Back"
                                Click="OnSettingsBack" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                            <Border Style="{StaticResource BumperGlyph}" Margin="22,0,8,0">
                                <TextBlock Text="&#x25C0; &#x25B6;" FontSize="11" FontWeight="Bold" />
                            </Border>
                            <TextBlock Text="Adjust" FontSize="15" VerticalAlignment="Center" />
                            <Border Style="{StaticResource HintGlyph}" Background="#3FA34D">
                                <TextBlock Text="A" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="Select" FontSize="15" VerticalAlignment="Center" />
                            <Border Style="{StaticResource HintGlyph}" Background="#C8423B">
                                <TextBlock Text="B" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="Back" FontSize="15" VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Docked mode: a layout and size of its own on a TV or monitor. -->
                    <StackPanel x:Name="TvItems" Visibility="Collapsed">
                        <Button x:Name="DockedSetting" Style="{StaticResource MenuButton}" Content="Docked mode"
                                Click="OnToggleDocked" />
                        <Button x:Name="DockedLayoutSetting" Style="{StaticResource MenuButton}" Content="Layout"
                                Click="OnStepDockedLayout" />
                        <Button x:Name="DockedSizeSetting" Style="{StaticResource MenuButton}" Content="Zoom"
                                Click="OnStepDockedSize" />
                        <!-- For touch, which has no B button. -->
                        <Button Style="{StaticResource MenuButton}" Content="Back" Click="OnSettingsBack" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                            <Border Style="{StaticResource BumperGlyph}" Margin="22,0,8,0">
                                <TextBlock Text="&#x25C0; &#x25B6;" FontSize="11" FontWeight="Bold" />
                            </Border>
                            <TextBlock Text="Adjust" FontSize="15" VerticalAlignment="Center" />
                            <Border Style="{StaticResource HintGlyph}" Background="#3FA34D">
                                <TextBlock Text="A" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="Change" FontSize="15" VerticalAlignment="Center" />
                            <Border Style="{StaticResource HintGlyph}" Background="#C8423B">
                                <TextBlock Text="B" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="Back" FontSize="15" VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Owned games that are not installed, in a tab of their own. -->
                    <StackPanel x:Name="OwnedItems" Visibility="Collapsed">
                        <Button x:Name="NotInstalledSetting" Style="{StaticResource MenuButton}" Content="Show games not installed"
                                Click="OnToggleNotInstalled" />
                        <Button x:Name="SteamKeySetting" Style="{StaticResource MenuButton}" Content="Steam Web API key"
                                Click="OnEditSteamKey" />
                        <Button x:Name="OwnedRefreshItem" Style="{StaticResource MenuButton}" Content="Look again" Click="OnRefreshOwned" />
                        <!-- For touch, which has no B button. -->
                        <Button Style="{StaticResource MenuButton}" Content="Back" Click="OnSettingsBack" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                            <Border Style="{StaticResource HintGlyph}" Background="#3FA34D">
                                <TextBlock Text="A" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="Select" FontSize="15" VerticalAlignment="Center" />
                            <Border Style="{StaticResource HintGlyph}" Background="#C8423B">
                                <TextBlock Text="B" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="Back" FontSize="15" VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>

                    <!-- The Deals row below the library. A switches a row on or off. -->
                    <StackPanel x:Name="DealsItems" Visibility="Collapsed">
                        <Button x:Name="DealsSetting" Style="{StaticResource MenuButton}" Content="Show game deals"
                                Click="OnToggleDeals" />
                        <Button x:Name="EpicFreeSetting" Style="{StaticResource MenuButton}" Content="Epic's free games"
                                Click="OnToggleEpicFreeGames" />
                        <Button x:Name="DealsKeySetting" Style="{StaticResource MenuButton}" Content="IsThereAnyDeal API key"
                                Click="OnEditDealsKey" />
                        <Button x:Name="WishlistDealsSetting" Style="{StaticResource MenuButton}" Content="Wishlist deals first"
                                Click="OnToggleWishlistDeals" />
                        <Button x:Name="DealsRefreshItem" Style="{StaticResource MenuButton}" Content="Look again"
                                Click="OnRefreshDeals" />
                        <!-- For touch, which has no B button. -->
                        <Button Style="{StaticResource MenuButton}" Content="Back" Click="OnSettingsBack" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                            <Border Style="{StaticResource HintGlyph}" Background="#3FA34D">
                                <TextBlock Text="A" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="Select" FontSize="15" VerticalAlignment="Center" />
                            <Border Style="{StaticResource HintGlyph}" Background="#C8423B">
                                <TextBlock Text="B" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="Back" FontSize="15" VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel x:Name="TextEditor" Visibility="Collapsed">
                        <TextBlock x:Name="EditorTitle" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock x:Name="EditorHint" Margin="0,2,0,12" FontSize="12.5" Opacity="0.6" TextWrapping="Wrap" />
                        <TextBox x:Name="EditorBox" Padding="12,10" FontSize="17" MaxLength="512"
                                 Background="#0F1115" Foreground="#F2F3F5" CaretBrush="#F2F3F5" BorderBrush="#3A4050" />
                        <Grid Margin="0,16,0,0">
                            <TextBlock Text="Menu saves, View cancels" FontSize="12.5" Opacity="0.6" VerticalAlignment="Center" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Style="{StaticResource DialogButton}" Content="Cancel" Click="OnCancelEdit" />
                                <Button Style="{StaticResource DialogButton}" Content="Save" Click="OnSaveEdit" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
        </Grid>
    </Grid>
</Window>
