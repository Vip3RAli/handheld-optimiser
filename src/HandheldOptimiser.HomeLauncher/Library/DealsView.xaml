<!--
    The Deals row: the deals below the games, or the Old School layout's deal cards. DealsPresenter fills it
    and wires its buttons.
-->
<UserControl x:Class="HandheldOptimiser.HomeLauncher.Library.DealsView"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        Deals: Epic's free games and the games on sale from IsThereAnyDeal, below the games. Only
        when switched on, on the Games tab. They are one row that scrolls across, and moves slowly
        by itself when Scroll deals is on.
    -->
    <!--
        The heading and the cards share one place: the cards sit below the heading, and the picked one, which
        grows (DealCardButton), is drawn up over it rather than cut off at the top of the scroll viewer.
    -->
    <Grid x:Name="DealsPanel" Margin="0,18,0,0" Visibility="Collapsed">
        <!-- Its name alone, without where the deals are from beside it, which the user asked for on 2026-11-16. -->
        <TextBlock x:Name="DealsHeading" Text="Giveaways and On Sale" Margin="10,0,0,2" VerticalAlignment="Top" FontSize="22" FontWeight="SemiBold"
                   Opacity="0.85" />
        <!--
            Not laid out on whole pixels as the rest of the window is: the row moving slowly by itself
            could then only jump a pixel at a time. DealsPresenter puts it back on a whole pixel when it stops.
        -->
        <ScrollViewer x:Name="DealsScroller" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                      PanningMode="HorizontalOnly" Focusable="False" UseLayoutRounding="False">
            <ItemsControl x:Name="DealTiles" Focusable="False" ItemsPanel="{StaticResource RowPanel}"
                          ItemTemplate="{StaticResource DealCard}" />
        </ScrollViewer>

    </Grid>
</UserControl>
