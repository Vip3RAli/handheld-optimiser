                    <Button x:Name="AutoTdpTemperatureSetting" Style="{StaticResource MenuButton}" local:MenuRow.Icon="&#xE9CA;" Content="TDP Engine temperature limit"
                            local:MenuRow.About="TDP Engine lowers the power limit to keep the handheld under this temperature." />
                    <Button x:Name="AutoTdpWattsSetting" Style="{StaticResource MenuButton}" local:MenuRow.Icon="&#xE945;" Content="TDP Engine maximum power"
                            local:MenuRow.About="The most watts TDP Engine may give a game." />
                    <Button x:Name="FanCurveSetting" Style="{StaticResource MenuButton}" local:MenuRow.Icon="&#xE9CA;" Content="Fan curve"
