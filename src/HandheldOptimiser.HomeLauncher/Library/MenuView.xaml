                    <!-- For touch, which has no B button. -->
                    <Button x:Name="DealsSettingsBackItem" Style="{StaticResource MenuButton}" local:MenuRow.Icon="&#xE72B;" Content="Back"
                            local:MenuRow.About="Back to Catalog &amp; Content." />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
