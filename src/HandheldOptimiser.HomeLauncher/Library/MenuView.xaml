                            local:MenuRow.About="Delete temporary files. Confirmation required." />
                    <Button x:Name="ShaderItem" Style="{StaticResource MenuButton}" local:MenuRow.Icon="&#xE74D;" Content="Clear shader caches"
                            local:MenuRow.About="Delete every game's shader caches. Each is rebuilt as its game starts." />
                    <Button x:Name="RecycleItem" Style="{StaticResource MenuButton}" local:MenuRow.Icon="&#xE74D;" Content="Empty the Recycle Bin"
                            local:MenuRow.About="Empty the Recycle Bin. Confirmation required." />
                    <Button x:Name="StartupGroup" Style="{StaticResource MenuButton}" local:MenuRow.Icon="&#xE768;" Content="Startup apps"
                            local:MenuRow.About="Choose which programs start with Windows." />
