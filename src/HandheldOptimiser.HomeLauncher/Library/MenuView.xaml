<!--
    The menu: a game's quick actions, the library's settings, the power menu and quick settings, as lists
    that take each other's place in one box, and the text box for typed settings. MenuPresenter brings it on
    screen and moves between the lists, and each menu wires its own rows.
-->
<UserControl x:Class="HandheldOptimiser.HomeLauncher.Library.MenuView"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:HandheldOptimiser.HomeLauncher.Library">
    <!-- Quick actions for one game, over the dimmed library. Tapping outside the panel closes it. -->
    <Grid x:Name="MenuOverlay" Background="#C0000000" Visibility="Collapsed">
        <!--
            Over the dimmed library in the grid and the row. In the Old School layout it is the
            settings panel of the Xbox 360: see MenuPresenter.cs.
        -->
        <Border x:Name="MenuBox" Width="560" Margin="0,24" Padding="28,24,28,20" CornerRadius="12" Background="#181B22"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.DirectionalNavigation="Contained">
            <!--
                The list, and in the Old School layout a column beside it that says what the row in focus
                does, as the Xbox 360's settings panel did. MenuPresenter shows that column and sizes it.
            -->
            <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <!-- The Old School panel's sheen, out to the box's edges over its padding. -->
            <Rectangle x:Name="MenuSheen" Grid.ColumnSpan="2" Visibility="Collapsed" IsHitTestVisible="False"
                       Fill="{StaticResource MenuPanelSheen}" RadiusX="5" RadiusY="5" />
            <!-- Scrolls when the list is taller than the screen, as on a small or heavily scaled display. -->
            <ScrollViewer x:Name="MenuScroller" VerticalScrollBarVisibility="Hidden" PanningMode="VerticalOnly" Focusable="False">
            <StackPanel>
                <TextBlock x:Name="MenuTitle" FontSize="22" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="MenuStore" Margin="0,2,0,18" FontSize="13" Opacity="0.55" />
                <!-- A notice raised while the menu is open, such as that a setting could not be saved. -->
                <TextBlock x:Name="MenuNotice" Margin="0,-6,0,12" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"
                           Visibility="Collapsed" />

                <StackPanel x:Name="GameItems">
                    <!-- Only for a game that is not installed, which has none of the other rows but Hide. -->
                    <Button x:Name="InstallItem" Style="{StaticResource MenuButton}" local:MenuRow.Icon="&#xE896;" Content="Install"
                            local:MenuRow.About="Install this game from its store. Opens the store's page."
                            Visibility="Collapsed" />
                    <Button x:Name="FavouriteItem" Style="{StaticResource MenuButton}" local:MenuRow.Icon="&#xE734;"
                            local:MenuRow.About="Pin this game to Favourites, so it shows up first." />
                    <Button x:Name="TagsItem" Style="{StaticResource MenuButton}" local:MenuRow.Icon="&#xE8EC;" Content="Tags &amp; collections"
                            local:MenuRow.About="Create your own collections and add this game to them." />
                    <Button x:Name="ProfileItem" Style="{StaticResource MenuButton}" local:MenuRow.Icon="&#xE713;" Content="Game profile"
                            local:MenuRow.About="Settings used only while this game runs." />
                    <!-- Only for a game on the recommended settings list. -->
                    <Button x:Name="RecommendedItem" Style="{StaticResource MenuButton}" local:MenuRow.Icon="&#xE945;" Content="Optimised settings"
                            local:MenuRow.About="Known good settings for this game on a handheld."
                            Visibility="Collapsed" />
                    <Button x:Name="AchievementsItem" Style="{StaticResource MenuButton}" local:MenuRow.Icon="&#xE8E1;" Content="Achievements"
                            local:MenuRow.About="Browse your unlocked and locked achievements." />
                    <Button x:Name="SaveSnapshotsItem" Style="{StaticResource MenuButton}" local:MenuRow.Icon="&#xE74E;" Content="Save snapshots"
                            local:MenuRow.About="Save Guard keeps copies of this game's saves, so you can restore one if it is lost or deleted by accident." />
                    <!-- Only for a program the player added: moves it between the games and Apps. -->
                    <Button x:Name="MoveItem" Style="{StaticResource MenuButton}" local:MenuRow.Icon="&#xE8AB;"
                            local:MenuRow.About="Move this program between your games and Apps." />
                    <Button x:Name="ArgumentsItem" Style="{StaticResource MenuButton}" local:MenuRow.Icon="&#xE943;" Content="Launch arguments"
                            local:MenuRow.About="Extra options passed to the game each time it starts." />
                    <Button x:Name="FolderItem" Style="{StaticResource MenuButton}" local:MenuRow.Icon="&#xE8B7;" Content="Open install folder"
                            local:MenuRow.About="Open the folder the game is installed in." />
                    <Button x:Name="PropertiesItem" Style="{StaticResource MenuButton}" local:MenuRow.Icon="&#xE946;" Content="Executable properties"
                            local:MenuRow.About="The game's executable file properties." />
                    <Button x:Name="ArtworkItem" Style="{StaticResource MenuButton}" local:MenuRow.Icon="&#xE8B9;" Content="Artwork"
                            local:MenuRow.About="Change the artwork for this game's card." />
                    <Button x:Name="CloseGameItem" Style="{StaticResource MenuButton}" local:MenuRow.Icon="&#xE711;" Content="Close game"
                            local:MenuRow.About="Close the game. Unsaved progress will be lost."
                            Visibility="Collapsed" />
                    <Button x:Name="HideItem" Style="{StaticResource MenuButton}" local:MenuRow.Icon="&#xED1A;"
                            local:MenuRow.About="Take this game out of the library. Restore it from Settings." />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                        <Border Style="{StaticResource HintGlyph}" Background="#3FA34D">
                            <TextBlock Text="A" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Select" FontSize="15" VerticalAlignment="Center" />
                        <Border Style="{StaticResource HintGlyph}" Background="#C8423B">
                            <TextBlock Text="B" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Back" FontSize="15" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>

                <!-- The library's settings: a short list of categories, each with its groups of settings behind it. -->
                <StackPanel x:Name="SettingsItems" Visibility="Collapsed">
                    <Button x:Name="UpdateSetting" Style="{StaticResource MenuButton}" local:MenuRow.Icon="&#xE895;" Content="Update now"
                            local:MenuRow.About="A new version is ready to install."
                            Visibility="Collapsed" />
                    <Button x:Name="LibraryDisplayGroup" Style="{StaticResource MenuButton}" local:MenuRow.Icon="&#xE790;" Content="Appearance &amp; Layout"
                            local:MenuRow.About="How the library looks: artwork, theme and layout." />
                    <Button x:Name="GamesAppsGroup" Style="{StaticResource MenuButton}" local:MenuRow.Icon="&#xE8F1;" Content="Catalog &amp; Content"
                            local:MenuRow.About="Store accounts, games ready to install, deals, emulators and custom apps." />
                    <Button x:Name="SleepTweaksGroup" Style="{StaticResource MenuButton}" local:MenuRow.Icon="&#xE945;" Content="Performance &amp; Power"
                            local:MenuRow.About="Game mode, TDP Engine, fan profiles, Quick Resume and clean up." />
                    <Button x:Name="RescanItem" Style="{StaticResource MenuButton}" local:MenuRow.Icon="&#xE72C;" Content="Refresh library"
                            local:MenuRow.About="Scan every store for new and removed games." />
                    <Button x:Name="QuitSetting" Style="{StaticResource MenuButton}" local:MenuRow.Icon="&#xE7E8;" Content="Close library"
                            local:MenuRow.About="Close the library and go to the Windows desktop." />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                        <Border Style="{StaticResource HintGlyph}" Background="#3FA34D">
                            <TextBlock Text="A" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Select" FontSize="15" VerticalAlignment="Center" />
                        <Border Style="{StaticResource HintGlyph}" Background="#C8423B">
                            <TextBlock Text="B" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Back" FontSize="15" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>

                <!-- Library display: how the library looks, on the built-in screen and docked. -->
                <StackPanel x:Name="LibraryDisplayItems" Visibility="Collapsed">
                    <Button x:Name="BackgroundGroup" Style="{StaticResource MenuButton}" local:MenuRow.Icon="&#xE8B9;" Content="Artwork &amp; Theme"
                            local:MenuRow.About="The background, game artwork and NXE theme." />
                    <Button x:Name="DisplayGroup" Style="{StaticResource MenuButton}" local:MenuRow.Icon="&#xE80A;" Content="Library Elements"
                            local:MenuRow.About="Choose the layout, and turn on or off what the library shows." />
                    <Button x:Name="TvGroup" Style="{StaticResource MenuButton}" local:MenuRow.Icon="&#xE7F4;" Content="Docked Display"
                            local:MenuRow.About="Custom settings for when the handheld is docked to a monitor or TV." />
                    <!-- For touch, which has no B button. -->
                    <Button x:Name="LibraryDisplaySettingsBackItem" Style="{StaticResource MenuButton}" local:MenuRow.Icon="&#xE72B;" Content="Back"
                            local:MenuRow.About="Back to Settings." />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                        <Border Style="{StaticResource HintGlyph}" Background="#3FA34D">
                            <TextBlock Text="A" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Select" FontSize="15" VerticalAlignment="Center" />
                        <Border Style="{StaticResource HintGlyph}" Background="#C8423B">
                            <TextBlock Text="B" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Back" FontSize="15" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>

                <!-- Games and apps: what the library lists besides the installed games. -->
                <StackPanel x:Name="GamesAppsItems" Visibility="Collapsed">
                    <Button x:Name="AccountsGroup" Style="{StaticResource MenuButton}" local:MenuRow.Icon="&#xE77B;" Content="Store Accounts &amp; Achievements"
                            local:MenuRow.About="Sign in to your game stores and sync achievements." />
                    <Button x:Name="OwnedGroup" Style="{StaticResource MenuButton}" local:MenuRow.Icon="&#xE896;" Content="Ready to Install"
                            local:MenuRow.About="Every game you own that is ready to install, in one place." />
                    <Button x:Name="DealsGroup" Style="{StaticResource MenuButton}" local:MenuRow.Icon="&#xE719;" Content="Deals &amp; Free Games"
                            local:MenuRow.About="Free games from the Epic Games Store, and deals from IsThereAnyDeal." />
                    <Button x:Name="EmulatorsGroup" Style="{StaticResource MenuButton}" local:MenuRow.Icon="&#xE7FC;" Content="Emulators &amp; ROMs"
                            local:MenuRow.About="Choose where your emulators are and which ROM folders to add to the library." />
                    <Button x:Name="AddProgramGroup" Style="{StaticResource MenuButton}" local:MenuRow.Icon="&#xE710;" Content="Add Custom App"
                            local:MenuRow.About="Add a program to start from the library." />
                    <!-- For touch, which has no B button. -->
                    <Button x:Name="GamesAppsSettingsBackItem" Style="{StaticResource MenuButton}" local:MenuRow.Icon="&#xE72B;" Content="Back"
                            local:MenuRow.About="Back to Settings." />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                        <Border Style="{StaticResource HintGlyph}" Background="#3FA34D">
                            <TextBlock Text="A" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Select" FontSize="15" VerticalAlignment="Center" />
                        <Border Style="{StaticResource HintGlyph}" Background="#C8423B">
                            <TextBlock Text="B" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Back" FontSize="15" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>

                <!-- Sleep and clean-up: what happens around a game and sleep, clean-ups, and the main app. -->
                <StackPanel x:Name="SleepTweaksItems" Visibility="Collapsed">
                    <Button x:Name="WhilePlayingGroup" Style="{StaticResource MenuButton}" local:MenuRow.Icon="&#xE7FC;" Content="Game Mode &amp; Optimisation"
                            local:MenuRow.About="Set up what happens when a game starts and quits." />
                    <Button x:Name="MaintenanceGroup" Style="{StaticResource MenuButton}" local:MenuRow.Icon="&#xE74D;" Content="Clean up &amp; Startup apps"
                            local:MenuRow.About="Free up space from temporary files, shader caches and the Recycle Bin, and choose your startup apps." />
                    <Button x:Name="OpenMainAppSetting" Style="{StaticResource MenuButton}" local:MenuRow.Icon="&#xE8A7;" Content="Open Handheld Optimiser App"
                            local:MenuRow.About="Open Handheld Optimiser to tune Windows." />
                    <!-- For touch, which has no B button. -->
                    <Button x:Name="SleepTweaksSettingsBackItem" Style="{StaticResource MenuButton}" local:MenuRow.Icon="&#xE72B;" Content="Back"
                            local:MenuRow.About="Back to Settings." />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                        <Border Style="{StaticResource HintGlyph}" Background="#3FA34D">
                            <TextBlock Text="A" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Select" FontSize="15" VerticalAlignment="Center" />
                        <Border Style="{StaticResource HintGlyph}" Background="#C8423B">
                            <TextBlock Text="B" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Back" FontSize="15" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>

                <!-- The background settings. A steps a row to its next value. -->
                <StackPanel x:Name="BackgroundItems" Visibility="Collapsed">
                    <Button x:Name="BackgroundSetting" Style="{StaticResource MenuButton}" local:MenuRow.Icon="&#xE8B9;" Content="Background &amp; Art"
                            local:MenuRow.About="Change the library's background and game artwork." />
                    <Button x:Name="StrengthSetting" Style="{StaticResource MenuButton}" local:MenuRow.Icon="&#xE790;" Content="Colour strength"
                            local:MenuRow.About="Choose how strongly the background is tinted." />
                    <Button x:Name="BlurSetting" Style="{StaticResource MenuButton}" local:MenuRow.Icon="&#xE8B9;" Content="Artwork blur"
                            local:MenuRow.About="Blur the background so the game cards stand out." />
                    <Button x:Name="PositionSetting" Style="{StaticResource MenuButton}" local:MenuRow.Icon="&#xE8B9;" Content="Artwork position"
                            local:MenuRow.About="Choose which part of the artwork shows behind the library." />
                    <Button x:Name="ArtworkKeySetting" Style="{StaticResource MenuButton}" local:MenuRow.Icon="&#xE8D7;" Content="SteamGridDB API key"
                            local:MenuRow.About="A free SteamGridDB key lets the library fetch artwork for games that have none." />
                    <Button x:Name="OldSchoolLookSetting" Style="{StaticResource MenuButton}" local:MenuRow.Icon="&#xE7FC;" Content="NXE Theme"
                            local:MenuRow.About="Choose Modern or Classic." />
                    <Button x:Name="MovingBackgroundSetting" Style="{StaticResource MenuButton}" local:MenuRow.Icon="&#xE768;" Content="Animated background"
                            local:MenuRow.About="Circles that come and go behind the Modern theme. Uses more power, so best turned off on battery." />
                    <!-- For touch, which has no B button. -->
                    <Button x:Name="BackgroundSettingsBackItem" Style="{StaticResource MenuButton}" local:MenuRow.Icon="&#xE72B;" Content="Back"
                            local:MenuRow.About="Back to Appearance &amp; Layout." />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                        <Border Style="{StaticResource HintGlyph}" Background="#3FA34D">
                            <TextBlock Text="A" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Change" FontSize="15" VerticalAlignment="Center" />
                        <Border Style="{StaticResource HintGlyph}" Background="#C8423B">
                            <TextBlock Text="B" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Back" FontSize="15" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>

                <!-- What the library shows and which buttons it offers. A switches a row on or off. -->
                <StackPanel x:Name="DisplayItems" Visibility="Collapsed">
                    <Button x:Name="LayoutSetting" Style="{StaticResource MenuButton}" local:MenuRow.Icon="&#xE80A;" Content="Layout"
                            local:MenuRow.About="Change the library's layout." />
                    <Button x:Name="ContinueSetting" Style="{StaticResource MenuButton}" local:MenuRow.Icon="&#xE81C;" Content="Show last played"
                            local:MenuRow.About="Show the last game you played at the front, ready to carry on." />
                    <Button x:Name="ContinueInfoSetting" Style="{StaticResource MenuButton}" local:MenuRow.Icon="&#xE946;" Content="Game info"
                            local:MenuRow.About="Show the last game's play time, size and profile beside it." />
                    <Button x:Name="StoreDetailsSetting" Style="{StaticResource MenuButton}" local:MenuRow.Icon="&#xE8A5;" Content="Store details"
                            local:MenuRow.About="Show or hide the game's store details." />
                    <Button x:Name="StatusSetting" Style="{StaticResource MenuButton}" local:MenuRow.Icon="&#xE701;" Content="Battery and Wi-Fi"
                            local:MenuRow.About="Show or hide the battery and Wi-Fi at the top of the screen." />
                    <Button x:Name="FilterSetting" Style="{StaticResource MenuButton}" local:MenuRow.Icon="&#xE71C;" Content="Store filter"
                            local:MenuRow.About="Filter games by store." />
                    <Button x:Name="QuickActionsSetting" Style="{StaticResource MenuButton}" local:MenuRow.Icon="&#xE7FC;" Content="Controller guide hints"
                            local:MenuRow.About="Show or hide the controller button hints." />
                    <Button x:Name="HiddenSetting" Style="{StaticResource MenuButton}" local:MenuRow.Icon="&#xE7B3;" Content="Show hidden games"
                            local:MenuRow.About="Show hidden games, so you can restore them." />
                    <Button x:Name="SortSetting" Style="{StaticResource MenuButton}" local:MenuRow.Icon="&#xE8CB;" Content="Sort games"
                            local:MenuRow.About="The order games are shown in." />
                    <!-- For touch, which has no B button. -->
                    <Button x:Name="DisplaySettingsBackItem" Style="{StaticResource MenuButton}" local:MenuRow.Icon="&#xE72B;" Content="Back"
                            local:MenuRow.About="Back to Appearance &amp; Layout." />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                        <Border Style="{StaticResource HintGlyph}" Background="#3FA34D">
                            <TextBlock Text="A" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Change" FontSize="15" VerticalAlignment="Center" />
                        <Border Style="{StaticResource HintGlyph}" Background="#C8423B">
                            <TextBlock Text="B" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Back" FontSize="15" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>

                <!-- The power menu. Restart and Shut down take a second press, so a stray A cannot end a session. -->
                <StackPanel x:Name="PowerItems" Visibility="Collapsed">
                    <Button x:Name="SleepItem" Style="{StaticResource MenuButton}" local:MenuRow.Icon="&#xE708;" Content="Sleep"
                            local:MenuRow.About="Put the handheld to sleep." />
                    <Button x:Name="HibernateItem" Style="{StaticResource MenuButton}" local:MenuRow.Icon="&#xE823;" Content="Hibernate"
                            local:MenuRow.About="Save a snapshot of the system, then shut down. Slower to start than sleep." />
                    <Button x:Name="RestartItem" Style="{StaticResource MenuButton}" local:MenuRow.Icon="&#xE777;" Content="Restart"
                            local:MenuRow.About="Restart the handheld. Confirmation required." />
                    <Button x:Name="ShutDownItem" Style="{StaticResource MenuButton}" local:MenuRow.Icon="&#xE7E8;" Content="Shut down"
                            local:MenuRow.About="Turn the handheld off. Confirmation required." />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                        <Border Style="{StaticResource HintGlyph}" Background="#3FA34D">
                            <TextBlock Text="A" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Select" FontSize="15" VerticalAlignment="Center" />
                        <Border Style="{StaticResource HintGlyph}" Background="#C8423B">
                            <TextBlock Text="B" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Back" FontSize="15" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>

                <!--
                    Quick settings, like Armoury Crate's Command Center. Left and right adjust a row; A
                    mutes the volume and steps the other rows on, for touch.
                -->
                <StackPanel x:Name="QuickItems" Visibility="Collapsed">
                    <Button x:Name="VolumeSetting" Style="{StaticResource MenuButton}" local:MenuRow.Icon="&#xE767;" Content="Volume"
                            local:MenuRow.About="Adjust the system volume." />
                    <Button x:Name="BrightnessSetting" Style="{StaticResource MenuButton}" local:MenuRow.Icon="&#xE706;" Content="Brightness"
                            local:MenuRow.About="Adjust the handheld's screen brightness." />
                    <Button x:Name="PowerModeSetting" Style="{StaticResource MenuButton}" local:MenuRow.Icon="&#xE945;" Content="Power mode"
                            local:MenuRow.About="Switch between Windows power modes." />
                    <Button x:Name="ResolutionSetting" Style="{StaticResource MenuButton}" local:MenuRow.Icon="&#xE7F4;" Content="Resolution"
                            local:MenuRow.About="Switch screen resolution." />
                    <Button x:Name="RefreshRateSetting" Style="{StaticResource MenuButton}" local:MenuRow.Icon="&#xE916;" Content="Refresh rate"
                            local:MenuRow.About="Switch refresh rate." />
                    <Button x:Name="CloseAppsNowItem" Style="{StaticResource MenuButton}" local:MenuRow.Icon="&#xE71D;" Content="Close background programs"
                            local:MenuRow.About="Close background programs now, to free up memory." />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                        <Border Style="{StaticResource BumperGlyph}" Margin="22,0,8,0">
                            <TextBlock Text="&#x25C0; &#x25B6;" FontSize="11" FontWeight="Bold" />
                        </Border>
                        <TextBlock Text="Adjust" FontSize="15" VerticalAlignment="Center" />
                        <Border Style="{StaticResource HintGlyph}" Background="#3FA34D">
                            <TextBlock Text="A" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Select" FontSize="15" VerticalAlignment="Center" />
                        <Border Style="{StaticResource HintGlyph}" Background="#C8423B">
                            <TextBlock Text="B" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Close" FontSize="15" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>

                <!-- One game's profile, switched to when it starts from the library. -->
                <StackPanel x:Name="ProfileItems" Visibility="Collapsed">
                    <Button x:Name="ProfilePowerSetting" Style="{StaticResource MenuButton}" local:MenuRow.Icon="&#xE945;" Content="Power mode"
                            local:MenuRow.About="The power mode used while this game runs." />
                    <Button x:Name="ProfileResolutionSetting" Style="{StaticResource MenuButton}" local:MenuRow.Icon="&#xE7F4;" Content="Resolution"
                            local:MenuRow.About="The resolution used while this game runs." />
                    <Button x:Name="ProfileRefreshSetting" Style="{StaticResource MenuButton}" local:MenuRow.Icon="&#xE916;" Content="Refresh rate"
                            local:MenuRow.About="The refresh rate used while this game runs." />
                    <Button x:Name="ProfileBrightnessSetting" Style="{StaticResource MenuButton}" local:MenuRow.Icon="&#xE706;" Content="Brightness"
                            local:MenuRow.About="The handheld's screen brightness while this game runs." />
                    <Button x:Name="ProfileAppsSetting" Style="{StaticResource MenuButton}" local:MenuRow.Icon="&#xE71D;" Content="Background programs"
                            local:MenuRow.About="Choose whether background programs are closed as this game starts." />
                    <Button x:Name="ProfileAutoTdpSetting" Style="{StaticResource MenuButton}" local:MenuRow.Icon="&#xE950;" Content="TDP Engine"
                            local:MenuRow.About="How TDP Engine sets the power limit while this game runs." />
                    <Button x:Name="ProfileFanSetting" Style="{StaticResource MenuButton}" local:MenuRow.Icon="&#xE9CA;" Content="Fan curve"
                            local:MenuRow.About="The fan curve used while this game runs." />
                    <Button x:Name="ProfileExportItem" Style="{StaticResource MenuButton}" local:MenuRow.Icon="&#xE898;" Content="Export preset"
                            local:MenuRow.About="Save this game's profile to a file, to keep or share." />
                    <Button x:Name="ProfileImportItem" Style="{StaticResource MenuButton}" local:MenuRow.Icon="&#xE896;" Content="Import preset"
                            local:MenuRow.About="Load a profile from a file into this game." />
                    <!-- For touch, which has no B button. -->
                    <Button x:Name="ProfileSettingsBackItem" Style="{StaticResource MenuButton}" local:MenuRow.Icon="&#xE72B;" Content="Back"
                            local:MenuRow.About="Back to the game's menu." />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                        <Border Style="{StaticResource BumperGlyph}" Margin="22,0,8,0">
                            <TextBlock Text="&#x25C0; &#x25B6;" FontSize="11" FontWeight="Bold" />
                        </Border>
                        <TextBlock Text="Adjust" FontSize="15" VerticalAlignment="Center" />
                        <Border Style="{StaticResource HintGlyph}" Background="#3FA34D">
                            <TextBlock Text="A" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Change" FontSize="15" VerticalAlignment="Center" />
                        <Border Style="{StaticResource HintGlyph}" Background="#C8423B">
                            <TextBlock Text="B" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Back" FontSize="15" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>

                <!--
                    Optimised settings for one game. The device half can go into its profile with
                    one press; the in-game half is a list to set in the game's own menu. The text is not
                    in a StackPanel, which would be taken for the hints row and hidden on a card.
                -->
                <StackPanel x:Name="RecommendedItems" Visibility="Collapsed">
                    <TextBlock x:Name="RecommendedNote" Margin="4,0,4,14" FontSize="14.5" TextWrapping="Wrap" Opacity="0.85" />
                    <Button x:Name="RecommendedApplyItem" Style="{StaticResource MenuButton}" local:MenuRow.Icon="&#xE945;" Content="Apply optimised settings"
                            local:MenuRow.About="Apply these settings to this game's profile." />
                    <TextBlock x:Name="RecommendedDevice" Margin="4,2,4,16" FontSize="13.5" TextWrapping="Wrap" Opacity="0.6" />
