<!--
    A store's sign-in, over the whole library: the menu's slate panel with the store's QR code, or its own
    sign-in page. SignInPresenter fills it and wires its buttons.

    A web page is a window of its own, which always draws over WPF in its rectangle, so nothing is laid over
    it: the heading sits above the page and the button hints below. This view is outside the part docked
    mode draws bigger, as a web page cannot be scaled with it.
-->
<UserControl x:Class="HandheldOptimiser.HomeLauncher.Library.SignInView"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Visibility="Collapsed">
    <Grid Background="#C8000000">
        <Border x:Name="Panel" MaxWidth="940" Margin="40,28" HorizontalAlignment="Center" VerticalAlignment="Center"
                CornerRadius="5" Background="{StaticResource MenuPanelBack}" BorderBrush="#47FFFFFF" BorderThickness="1">
            <Grid>
                <Rectangle Fill="{StaticResource MenuPanelSheen}" RadiusX="5" RadiusY="5" IsHitTestVisible="False" />
                <Grid Margin="28,20,28,18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="Heading" FontSize="26" FontWeight="SemiBold" />

                    <!-- The QR code, approved in the store's app on a phone. -->
                    <Grid x:Name="QrPart" Grid.Row="1" Margin="0,20,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Background="#FFFFFF" CornerRadius="6" Padding="14" VerticalAlignment="Center">
                            <Grid Width="280" Height="280">
                                <Image x:Name="QrImage" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                                <TextBlock x:Name="QrWaiting" Text="Asking Steam for a code..." Foreground="#3A3F47" FontSize="16"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="30,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="QrHeading" FontSize="21" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock x:Name="QrSteps" Margin="0,12,0,0" FontSize="16" Opacity="0.85" TextWrapping="Wrap" LineHeight="23" />
                            <TextBlock x:Name="QrNote" Margin="0,18,0,0" FontSize="14" Opacity="0.65" TextWrapping="Wrap" LineHeight="20" />
                        </StackPanel>
                    </Grid>

                    <!-- The store's own sign-in page, put here in code while it is open. -->
                    <Border x:Name="WebPart" Grid.Row="1" Margin="0,16,0,0" Background="#FFFFFF" CornerRadius="3" Visibility="Collapsed" />

                    <TextBlock x:Name="Status" Grid.Row="2" Margin="0,14,0,0" FontSize="15" Opacity="0.8" TextWrapping="Wrap" />

                    <!-- The controller's buttons, which are also buttons for a finger or the mouse. -->
                    <StackPanel Grid.Row="3" Margin="0,16,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="KeyboardButton" Style="{StaticResource DialogButton}" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource HintGlyph}" Margin="0,0,8,0" Background="#D9A520">
                                    <TextBlock Text="Y" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="Keyboard" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="SwitchButton" Style="{StaticResource DialogButton}">
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource HintGlyph}" Margin="0,0,8,0" Background="#2F6FD0">
                                    <TextBlock Text="X" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock x:Name="SwitchText" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="CancelButton" Style="{StaticResource DialogButton}">
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource HintGlyph}" Margin="0,0,8,0" Background="#C8423B">
                                    <TextBlock Text="B" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="Cancel" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
