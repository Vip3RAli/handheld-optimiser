<!--
    The game library's styles, brushes, panels and item templates. Merged into the library's Application by
    LibraryApp, so the window and the views inside it find them as they are parsed. The item templates name no
    handlers: the presenters catch their buttons' clicks and focus on the items control, as both bubble.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:HandheldOptimiser.HomeLauncher.Library"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <BooleanToVisibilityConverter x:Key="BoolToVis" />

    <!-- A row of the menu over the dimmed library, and the row in focus. -->
    <SolidColorBrush x:Key="MenuRowBrush" Color="#222630" />
    <SolidColorBrush x:Key="MenuRowFocusBrush" Color="#2C3240" />

    <!-- How much room a row of the menu over the dimmed library takes. -->
    <Thickness x:Key="MenuRowPadding">16,10</Thickness>
    <Thickness x:Key="MenuRowMargin">0,0,0,8</Thickness>
    <sys:Double x:Key="MenuRowHeight">46</sys:Double>

    <!--
        The ring round a game tile in focus: white, or in the open Ready to install card the green of the
        menu panel's bar, which OldSchoolPresenter puts in the page's resources while the card is open.
    -->
    <SolidColorBrush x:Key="TileRingBrush" Color="#F2F3F5" />
    <SolidColorBrush x:Key="MenuPanelRing" Color="#9BD94A" />

    <!--
        How faded a game that is not installed is drawn among the installed ones. In the open Ready to
        install card every game is one, so there they are drawn at full strength against the slate.
    -->
    <sys:Double x:Key="NotInstalledArtOpacity">0.6</sys:Double>

    <!--
        A notice is what the library has to say about a game, a deal or a green card, such as that the
        game is starting. It is shown on the tile or card itself for a few seconds, in place of the
        name: the one style is for whatever shows the notice, and the other for what gives way to it.
    -->
    <Style x:Key="ShownByNotice" TargetType="FrameworkElement">
        <Style.Triggers>
            <DataTrigger Binding="{Binding Notice}" Value="{x:Null}">
                <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="HiddenByNotice" TargetType="FrameworkElement">
        <Setter Property="Visibility" Value="Collapsed" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Notice}" Value="{x:Null}">
                <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- A game tile in the grid: portrait art, or the store colour with the game's icon and name. -->
    <Style x:Key="TileButton" TargetType="Button">
        <Setter Property="Margin" Value="10" />
        <!-- Button's default style would otherwise make the titles black. -->
        <Setter Property="Foreground" Value="#F2F3F5" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
        <Setter Property="RenderTransform">
            <Setter.Value>
                <ScaleTransform />
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <StackPanel Width="180">
                        <Grid Height="270">
                            <Border x:Name="Art" CornerRadius="8" Background="{Binding Background}" ClipToBounds="True">
                                <Grid>
                                    <Image Source="{Binding Cover}" Stretch="UniformToFill"
                                           RenderOptions.BitmapScalingMode="HighQuality"
                                           Visibility="{Binding HasCover, Converter={StaticResource BoolToVis}}" />
                                    <StackPanel VerticalAlignment="Center" Margin="16,0"
                                                Visibility="{Binding ShowsIcon, Converter={StaticResource BoolToVis}}">
                                        <Image Source="{Binding Icon}" Width="88" Height="88"
                                               RenderOptions.BitmapScalingMode="HighQuality" />
                                        <TextBlock Text="{Binding Title}" Margin="0,14,0,0" FontSize="17" FontWeight="SemiBold"
                                                   TextAlignment="Center" TextWrapping="Wrap" MaxHeight="92" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <!-- Games that are not installed wear a download mark. -->
                            <Border x:Name="InstallMark" Width="34" Height="34" CornerRadius="17" Margin="8" Background="#D0101216"
                                    HorizontalAlignment="Left" VerticalAlignment="Bottom" Visibility="Collapsed">
                                <TextBlock Text="&#xE896;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <!-- The store the game is from, as its logo. -->
                            <Border x:Name="StoreMark" Width="30" Height="30" CornerRadius="15" Margin="8" Background="#D0101216"
                                    HorizontalAlignment="Right" VerticalAlignment="Bottom">
                                <Path Data="{Binding StoreLogo}" Fill="#F2F3F5" Stretch="Uniform" Width="16" Height="16"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <!-- Favourites wear a star in the corner. -->
                            <Border Width="34" Height="34" CornerRadius="17" Margin="8" Background="#B0101216"
                                    HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Visibility="{Binding IsFavourite, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="&#xE735;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16"
                                           Foreground="#F5C542" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <!-- A notice, across the bottom of the picture: the name under it is one short line. -->
                            <Border Style="{StaticResource ShownByNotice}" CornerRadius="0,0,8,8" Padding="10,8"
                                    Background="#E6101216" VerticalAlignment="Bottom">
                                <TextBlock Text="{Binding Notice}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" />
                            </Border>
                            <Border x:Name="Ring" CornerRadius="10" Margin="-4" BorderThickness="3"
                                    BorderBrush="{DynamicResource TileRingBrush}" Opacity="0" />
                        </Grid>
                        <TextBlock Text="{Binding Title}" Margin="2,8,2,0" FontSize="14" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding StoreLogo}" Value="{x:Null}">
                            <Setter TargetName="StoreMark" Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                        <!-- Hidden games only show while Show hidden games is on, faded so they stand out. -->
                        <DataTrigger Binding="{Binding IsHidden}" Value="True">
                            <Setter TargetName="Art" Property="Opacity" Value="0.4" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsInstalled}" Value="False">
                            <Setter TargetName="Art" Property="Opacity" Value="{DynamicResource NotInstalledArtOpacity}" />
                            <Setter TargetName="InstallMark" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Ring" Property="Opacity" Value="0.45" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Ring" Property="Opacity" Value="1" />
                            <Setter Property="RenderTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="1.05" ScaleY="1.05" />
                                </Setter.Value>
                            </Setter>
                            <Setter Property="Panel.ZIndex" Value="1" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        A game tile in the row: a square icon, as on a console's home screen. The focused one is drawn
        at twice the size from its bottom edge, with margins that move its neighbours aside by as much
        (RowTileSize and RowFocusScale in LibraryLayoutManager.cs), and only it shows its name. The
        square picture is SteamGridDB's; until one arrives the cover is shown, cut to fit.
    -->
    <Style x:Key="RowTileButton" TargetType="Button">
        <Setter Property="Margin" Value="6" />
        <Setter Property="Foreground" Value="#F2F3F5" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="RenderTransformOrigin" Value="0.5,1" />
        <Setter Property="RenderTransform">
            <Setter.Value>
                <ScaleTransform />
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Width="150" Height="150">
                        <Border x:Name="Art" CornerRadius="6" Background="{Binding Background}" ClipToBounds="True">
                            <Grid>
                                <Image Source="{Binding Cover}" Stretch="UniformToFill" VerticalAlignment="Top"
                                       RenderOptions.BitmapScalingMode="HighQuality" />
                                <Image Source="{Binding Icon}" Width="72" Height="72"
                                       RenderOptions.BitmapScalingMode="HighQuality"
                                       Visibility="{Binding ShowsIcon, Converter={StaticResource BoolToVis}}" />
                                <Image Source="{Binding Square}" Stretch="UniformToFill"
                                       RenderOptions.BitmapScalingMode="HighQuality" />
                            </Grid>
                        </Border>
                        <!-- The store the game is from, as its logo. -->
                        <Border x:Name="StoreMark" Width="18" Height="18" CornerRadius="9" Margin="5" Background="#D0101216"
                                HorizontalAlignment="Left" VerticalAlignment="Top">
                            <Path Data="{Binding StoreLogo}" Fill="#F2F3F5" Stretch="Uniform" Width="10" Height="10"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <!-- Favourites wear a star in the corner. -->
                        <Border Width="18" Height="18" CornerRadius="9" Margin="5" Background="#B0101216"
                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                Visibility="{Binding IsFavourite, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="&#xE735;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="9"
                                       Foreground="#F5C542" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <!-- The name across the bottom of the focused one, at half the size it is drawn. -->
                        <Border x:Name="Name" CornerRadius="0,0,6,6" Padding="8,14,8,5" VerticalAlignment="Bottom" Visibility="Collapsed">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#00000000" Offset="0" />
                                    <GradientStop Color="#E0000000" Offset="0.6" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <StackPanel>
                                <TextBlock Style="{StaticResource HiddenByNotice}" Text="{Binding Title}" FontSize="9"
                                           FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Style="{StaticResource ShownByNotice}" Text="{Binding Notice}" FontSize="8"
                                           FontWeight="SemiBold" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <Border x:Name="Ring" CornerRadius="8" Margin="-3" BorderThickness="2"
                                BorderBrush="#F2F3F5" Opacity="0" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding StoreLogo}" Value="{x:Null}">
                            <Setter TargetName="StoreMark" Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsHidden}" Value="True">
                            <Setter TargetName="Art" Property="Opacity" Value="0.4" />
                        </DataTrigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Ring" Property="Opacity" Value="0.45" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Ring" Property="Opacity" Value="1" />
                            <Setter TargetName="Ring" Property="BorderThickness" Value="1.5" />
                            <Setter TargetName="Name" Property="Visibility" Value="Visible" />
                            <Setter Property="RenderTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="2" ScaleY="2" />
                                </Setter.Value>
                            </Setter>
                            <Setter Property="Margin" Value="81,6,81,6" />
                            <Setter Property="Panel.ZIndex" Value="1" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        The Old School layout's Console space look, which ConsoleSpaceLook switches on through the dynamic
        resources below; their values here are the Classic look's, which leaves every card as it was.
    -->
    <Visibility x:Key="ConsoleOnly">Collapsed</Visibility>
    <Visibility x:Key="ClassicOnly">Visible</Visibility>
    <SolidColorBrush x:Key="CardRingBrush" Color="#F2F3F5" />
    <SolidColorBrush x:Key="CategoryBrush" Color="#F2F3F5" />
    <SolidColorBrush x:Key="HudBackground" Color="Transparent" />
    <SolidColorBrush x:Key="HudBorder" Color="Transparent" />
    <Thickness x:Key="HudPadding">0</Thickness>
    <Thickness x:Key="HudEnd">0</Thickness>
    <SolidColorBrush x:Key="PillBackground" Color="Transparent" />
    <SolidColorBrush x:Key="PillBorder" Color="Transparent" />
    <Thickness x:Key="PillPadding">0</Thickness>
    <Thickness x:Key="PillGap">0</Thickness>
    <SolidColorBrush x:Key="AcceptPillBackground" Color="Transparent" />
    <SolidColorBrush x:Key="AcceptPillBorder" Color="Transparent" />
    <FontFamily x:Key="CardTitleFont">Convection, /HandheldOptimiser.HomeLauncher;component/Fonts/#Open Sans, Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="CategoryFont">Convection, /HandheldOptimiser.HomeLauncher;component/Fonts/#Open Sans, Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="HintFont">Convection, /HandheldOptimiser.HomeLauncher;component/Fonts/#Open Sans, Segoe UI Variable Text, Segoe UI</FontFamily>

    <!--
        Behind a card in the Console space look: the shadow it casts to the right onto the card behind, the
        darker one where it meets the floor, and its reflection in the floor, which is the card itself (the
        element in Tag) turned upside down and fading away. The frame is invisible and only keeps room: it
        is the picture CardTilt is given, so it must hold everything the card draws, and OldSchoolStack's
        Frame numbers must match its margins.
    -->
    <ControlTemplate x:Key="ConsoleCardBack" TargetType="ContentControl">
        <Grid Visibility="{DynamicResource ConsoleOnly}">
            <Rectangle Margin="-60,-60,-80,-380" Fill="Transparent" />
            <Rectangle Width="46" Margin="0,10,-46,8" HorizontalAlignment="Right">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#80000000" Offset="0" />
                        <GradientStop Color="#00000000" Offset="1" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <Ellipse Height="48" Margin="20,0,20,-30" VerticalAlignment="Bottom">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#C0000000" Offset="0" />
                        <GradientStop Color="#00000000" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <Rectangle Height="320" VerticalAlignment="Top" RadiusX="12" RadiusY="12">
                <Rectangle.RenderTransform>
                    <TranslateTransform Y="328" />
                </Rectangle.RenderTransform>
                <Rectangle.Fill>
                    <VisualBrush Visual="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Stretch="Fill">
                        <VisualBrush.RelativeTransform>
                            <ScaleTransform ScaleY="-1" CenterY="0.5" />
                        </VisualBrush.RelativeTransform>
                    </VisualBrush>
                </Rectangle.Fill>
                <Rectangle.OpacityMask>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#4CFFFFFF" Offset="0" />
                        <GradientStop Color="#00FFFFFF" Offset="0.32" />
                    </LinearGradientBrush>
                </Rectangle.OpacityMask>
            </Rectangle>
        </Grid>
    </ControlTemplate>

    <!--
        Over a card in the Console space look, as on a glossy case: a highlight across the top left, a lit
        top edge, a fine light edge all round, and a darker spine down the left.
    -->
    <ControlTemplate x:Key="ConsoleCardGloss" TargetType="ContentControl">
        <Grid Visibility="{DynamicResource ConsoleOnly}" IsHitTestVisible="False">
            <Border CornerRadius="12">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0.8">
                        <GradientStop Color="#4CFFFFFF" Offset="0" />
                        <GradientStop Color="#14FFFFFF" Offset="0.18" />
                        <GradientStop Color="#00FFFFFF" Offset="0.34" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
            <Border Width="11" HorizontalAlignment="Left" CornerRadius="12,0,0,12">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#73000000" Offset="0" />
                        <GradientStop Color="#1AFFFFFF" Offset="0.6" />
                        <GradientStop Color="#00FFFFFF" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
            <Border CornerRadius="12" BorderThickness="1" BorderBrush="#38FFFFFF" />
            <Border CornerRadius="12" BorderThickness="0,1.5,0,0" BorderBrush="#80FFFFFF" />
        </Grid>
    </ControlTemplate>

    <!--
        A game's card in the Old School layout: its wide artwork with its name along the bottom, as
        the Xbox 360's cards were. OldSchoolPanel sizes and places each one, so the focused card does
        not grow by itself (OldSchoolStack in OldSchoolPanel.cs has the card's size). A game with no
        wide artwork shows its cover on its own colours.
    -->
    <Style x:Key="OldSchoolCardButton" TargetType="Button">
        <Setter Property="Foreground" Value="#F2F3F5" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Width="420" Height="320">
                        <!-- The Console space look's shadows and reflection, behind the card. See ConsoleCardBack. -->
                        <ContentControl Template="{StaticResource ConsoleCardBack}" Focusable="False" IsTabStop="False"
                                        Tag="{Binding ElementName=Art}" />
                        <Border x:Name="Art" CornerRadius="12" Background="{Binding CardBrush}">
                            <Grid>
                                <!-- Under the wide artwork, and so only seen without it. -->
                                <Border x:Name="Fallback" Width="150" Height="225" Margin="24,24,0,0" CornerRadius="6" ClipToBounds="True"
                                        HorizontalAlignment="Left" VerticalAlignment="Top" Background="{Binding Background}">
                                    <Grid>
                                        <Image Source="{Binding Cover}" Stretch="UniformToFill"
                                               RenderOptions.BitmapScalingMode="Linear" />
                                        <Image Source="{Binding Icon}" Width="112" Height="112"
                                               RenderOptions.BitmapScalingMode="Linear"
                                               Visibility="{Binding ShowsIcon, Converter={StaticResource BoolToVis}}" />
                                    </Grid>
                                </Border>
                                <!-- A brush, not an image, so the picture keeps the card's round corners. -->
                                <Border CornerRadius="12" RenderOptions.BitmapScalingMode="Linear">
                                    <Border.Background>
                                        <ImageBrush ImageSource="{Binding Wide}" Stretch="UniformToFill" />
                                    </Border.Background>
                                </Border>
                                <!-- The sheen across the top of the card, and the shade the name is read on. -->
                                <Border CornerRadius="12">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#30FFFFFF" Offset="0" />
                                            <GradientStop Color="#00FFFFFF" Offset="0.3" />
                                            <GradientStop Color="#00000000" Offset="0.5" />
                                            <GradientStop Color="#E0000000" Offset="1" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                                <ContentControl Template="{StaticResource ConsoleCardGloss}" Focusable="False" IsTabStop="False" />
                                <!-- Only on the front card: the ones behind have theirs half covered. -->
                                <Border Visibility="{DynamicResource ClassicOnly}">
                                    <TextBlock Style="{StaticResource HiddenByNotice}" Text="{Binding Title}" Margin="20,0,56,16"
                                               FontSize="26" FontWeight="SemiBold"
                                               VerticalAlignment="Bottom" TextTrimming="CharacterEllipsis"
                                               Opacity="{Binding Path=(local:OldSchoolPanel.Front), RelativeSource={RelativeSource AncestorType=ContentPresenter}}" />
                                </Border>
                                <!--
                                    The Console space look's front card: a pane of frosted glass across the bottom, the
                                    artwork blurred behind it, with the name and the store on it. The blur is drawn once
                                    and kept (BitmapCache), so a card moving costs nothing more for it.
                                -->
                                <Grid Visibility="{DynamicResource ConsoleOnly}" Width="396" Height="92" Margin="12"
                                      HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                      Opacity="{Binding Path=(local:OldSchoolPanel.Front), RelativeSource={RelativeSource AncestorType=ContentPresenter}}">
                                    <Grid.Clip>
                                        <RectangleGeometry Rect="0,0,396,92" RadiusX="10" RadiusY="10" />
                                    </Grid.Clip>
                                    <Border Width="420" Height="320" Margin="-12,-216,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"
                                            RenderOptions.BitmapScalingMode="Linear">
                                        <Border.Background>
                                            <ImageBrush ImageSource="{Binding Wide}" Stretch="UniformToFill" />
                                        </Border.Background>
                                        <Border.Effect>
                                            <BlurEffect Radius="22" />
                                        </Border.Effect>
                                        <Border.CacheMode>
                                            <BitmapCache />
                                        </Border.CacheMode>
                                    </Border>
                                    <Border CornerRadius="10" Background="#7A0A140A" BorderBrush="#33FFFFFF" BorderThickness="1" />
                                    <Border CornerRadius="10" BorderBrush="#40FFFFFF" BorderThickness="0,1,0,0" Margin="1" />
                                    <StackPanel Style="{StaticResource HiddenByNotice}" Margin="18,0,56,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" FontFamily="{DynamicResource CardTitleFont}" FontSize="30" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding StoreName}" FontFamily="{DynamicResource CardTitleFont}" FontSize="15"
                                                   Margin="0,1,0,0" Opacity="0.78" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Grid>
                                <!-- A notice takes the name's place, on as many lines as it needs. -->
                                <TextBlock Style="{StaticResource ShownByNotice}" Text="{Binding Notice}" Margin="20,0,56,16"
                                           FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"
                                           VerticalAlignment="Bottom"
                                           Opacity="{Binding Path=(local:OldSchoolPanel.Front), RelativeSource={RelativeSource AncestorType=ContentPresenter}}" />
                            </Grid>
                        </Border>
                        <!-- The store the game is from, as its logo. -->
                        <Border x:Name="StoreMark" Width="30" Height="30" CornerRadius="15" Margin="14" Background="#D0101216"
                                HorizontalAlignment="Right" VerticalAlignment="Bottom">
                            <Path Data="{Binding StoreLogo}" Fill="#F2F3F5" Stretch="Uniform" Width="16" Height="16"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <!-- Favourites wear a star in the corner. -->
                        <Border Width="34" Height="34" CornerRadius="17" Margin="12" Background="#B0101216"
                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                Visibility="{Binding IsFavourite, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="&#xE735;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16"
                                       Foreground="#F5C542" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <Border x:Name="Ring" CornerRadius="14" Margin="-4" BorderThickness="3"
                                BorderBrush="{DynamicResource CardRingBrush}" Effect="{DynamicResource CardRingEffect}" Opacity="0" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding StoreLogo}" Value="{x:Null}">
                            <Setter TargetName="StoreMark" Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsHidden}" Value="True">
                            <Setter TargetName="Art" Property="Opacity" Value="0.4" />
                        </DataTrigger>
                        <!-- An icon sits on the card's own colours, with no cover-shaped box around it. -->
                        <DataTrigger Binding="{Binding ShowsIcon}" Value="True">
                            <Setter TargetName="Fallback" Property="Background" Value="Transparent" />
                        </DataTrigger>
                        <!-- No ring under the mouse: after a swipe it would sit on whichever card came to rest there. -->
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Ring" Property="Opacity" Value="1" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The games' tiles in each layout. Press and hold arrives as a right click, so touch reaches the quick actions too. -->
    <DataTemplate x:Key="GridTile">
        <Button Style="{StaticResource TileButton}" />
    </DataTemplate>
    <DataTemplate x:Key="RowTile">
        <Button Style="{StaticResource RowTileButton}" />
    </DataTemplate>
    <DataTemplate x:Key="OldSchoolTile">
        <Button Style="{StaticResource OldSchoolCardButton}" />
    </DataTemplate>

    <!-- The Last played card: a wide tile with the same focus ring and lift as the others. -->
    <Style x:Key="CardButton" TargetType="Button">
        <Setter Property="Margin" Value="10" />
        <Setter Property="Foreground" Value="#F2F3F5" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
        <Setter Property="RenderTransform">
            <Setter.Value>
                <ScaleTransform />
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <ContentPresenter />
                        <Border x:Name="Ring" CornerRadius="10" Margin="-4" BorderThickness="3"
                                BorderBrush="#F2F3F5" Opacity="0" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Ring" Property="Opacity" Value="0.45" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Ring" Property="Opacity" Value="1" />
                            <Setter Property="RenderTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="1.03" ScaleY="1.03" />
                                </Setter.Value>
                            </Setter>
                            <Setter Property="Panel.ZIndex" Value="1" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The layouts: a grid that scrolls down, one row of games that scrolls across, and the Old School cards. -->
    <ItemsPanelTemplate x:Key="GridPanel">
        <WrapPanel />
    </ItemsPanelTemplate>
    <ItemsPanelTemplate x:Key="RowPanel">
        <StackPanel Orientation="Horizontal" />
    </ItemsPanelTemplate>
    <ItemsPanelTemplate x:Key="OldSchoolPanel">
        <local:OldSchoolPanel />
    </ItemsPanelTemplate>

    <!-- A deal's card in the row below the grid, and in the grid of deals below the row of games. -->
    <DataTemplate x:Key="DealCard">
        <Button Style="{StaticResource CardButton}">
            <StackPanel Width="300">
                <Grid Height="140">
                    <Border CornerRadius="8" ClipToBounds="True" Background="#262B36">
                        <Grid>
                            <Image Source="{Binding Banner}" Stretch="UniformToFill"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                            <TextBlock Text="{Binding Title}" Margin="16,0" FontSize="18" FontWeight="SemiBold"
                                       TextAlignment="Center" TextWrapping="Wrap" VerticalAlignment="Center"
                                       Visibility="{Binding ShowsTitle, Converter={StaticResource BoolToVis}}" />
                        </Grid>
                    </Border>
                    <Border Margin="8" Padding="8,3" CornerRadius="6" Background="#3FA34D"
                            HorizontalAlignment="Left" VerticalAlignment="Bottom">
                        <TextBlock Text="{Binding Cut}" FontSize="15" FontWeight="Bold" />
                    </Border>
                    <Border Margin="8" Padding="8,3" CornerRadius="6" Background="#D0101216"
                            HorizontalAlignment="Right" VerticalAlignment="Top"
                            Visibility="{Binding HasBadge, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding Badge}" FontSize="12" FontWeight="SemiBold" Foreground="#F5C542" />
                    </Border>
                    <Border Style="{StaticResource ShownByNotice}" CornerRadius="0,0,8,8" Padding="10,8"
                            Background="#E6101216" VerticalAlignment="Bottom">
                        <TextBlock Text="{Binding Notice}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" />
                    </Border>
                </Grid>
                <TextBlock Text="{Binding Title}" Margin="2,8,2,0" FontSize="14" FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis" />
                <StackPanel Orientation="Horizontal" Margin="2,1,2,0">
                    <TextBlock Text="{Binding Price}" FontSize="13" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Regular}" Margin="8,0,0,0" FontSize="12" Opacity="0.5"
                               TextDecorations="Strikethrough" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Shop}" Margin="8,0,0,0" FontSize="12" Opacity="0.55"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                </StackPanel>
            </StackPanel>
        </Button>
    </DataTemplate>

    <!--
        A deal's card in the Old School layout, the size of a game's: its banner across the top at
        the banner's own shape, with how much is off in the corner that shows on the cards behind,
        and its name and price underneath on the front card only.
    -->
    <Style x:Key="OldSchoolDealButton" TargetType="Button">
        <Setter Property="Foreground" Value="#F2F3F5" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Width="420" Height="320">
                        <ContentControl Template="{StaticResource ConsoleCardBack}" Focusable="False" IsTabStop="False"
                                        Tag="{Binding ElementName=Body}" />
                        <Grid x:Name="Body">
                        <Border CornerRadius="12">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#2B303C" Offset="0" />
                                    <GradientStop Color="#14171D" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <!-- A brush, not an image, so the picture keeps the card's round corners. -->
                        <Border Height="198" VerticalAlignment="Top" CornerRadius="12,12,0,0" RenderOptions.BitmapScalingMode="Linear">
                            <Border.Background>
                                <ImageBrush ImageSource="{Binding Banner}" Stretch="UniformToFill" />
                            </Border.Background>
                        </Border>
                        <!-- The sheen across the top of the card. -->
                        <Border CornerRadius="12">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#30FFFFFF" Offset="0" />
                                    <GradientStop Color="#00FFFFFF" Offset="0.25" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <!-- At the right, which is the part of a card that shows from behind the one in front. -->
                        <Border Margin="12" Padding="9,3" CornerRadius="6" Background="#3FA34D"
                                HorizontalAlignment="Right" VerticalAlignment="Top">
                            <TextBlock Text="{Binding Cut}" FontSize="17" FontWeight="Bold" />
                        </Border>
                        <!-- Only on the front card: the ones behind have theirs half covered. -->
                        <Grid Margin="20,0,20,18" VerticalAlignment="Bottom"
                              Opacity="{Binding Path=(local:OldSchoolPanel.Front), RelativeSource={RelativeSource AncestorType=ContentPresenter}}">
                            <StackPanel Style="{StaticResource HiddenByNotice}">
                                <TextBlock Text="{Binding Badge}" Margin="0,0,0,2" FontSize="13" FontWeight="SemiBold" Foreground="#F5C542"
                                           Visibility="{Binding HasBadge, Converter={StaticResource BoolToVis}}" />
                                <TextBlock Text="{Binding Title}" FontFamily="{DynamicResource CardTitleFont}" FontSize="22" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                    <TextBlock Text="{Binding Price}" FontSize="16" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Regular}" Margin="10,0,0,0" FontSize="14" Opacity="0.6"
                                               TextDecorations="Strikethrough" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Shop}" Margin="10,0,0,0" FontSize="14" Opacity="0.7"
                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                </StackPanel>
                            </StackPanel>
                            <TextBlock Style="{StaticResource ShownByNotice}" Text="{Binding Notice}" FontSize="20"
                                       FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Bottom" />
                        </Grid>
                        <ContentControl Template="{StaticResource ConsoleCardGloss}" Focusable="False" IsTabStop="False" />
                        </Grid>
                        <Border x:Name="Ring" CornerRadius="14" Margin="-4" BorderThickness="3"
                                BorderBrush="{DynamicResource CardRingBrush}" Effect="{DynamicResource CardRingEffect}" Opacity="0" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Ring" Property="Opacity" Value="1" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <DataTemplate x:Key="OldSchoolDeal">
        <Button Style="{StaticResource OldSchoolDealButton}" />
    </DataTemplate>

    <!--
        A card that does something, in the Old School layout: one of the settings' lists, a power
        action, or the way in to the games that are not installed. The green of the Xbox 360's own
        cards, with a white symbol towards the right, where it shows from behind the card in front.
    -->
    <Style x:Key="OldSchoolActionButton" TargetType="Button">
        <Setter Property="Foreground" Value="#FFFFFF" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Width="420" Height="320">
                        <ContentControl Template="{StaticResource ConsoleCardBack}" Focusable="False" IsTabStop="False"
                                        Tag="{Binding ElementName=Body}" />
                        <Grid x:Name="Body">
                        <Border CornerRadius="12">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#C6E04A" Offset="0" />
                                    <GradientStop Color="#9CC72A" Offset="0.45" />
                                    <GradientStop Color="#5E9412" Offset="0.8" />
                                    <GradientStop Color="#2F5708" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <!-- The sheen across the top of the card. -->
                        <Border CornerRadius="12">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#50FFFFFF" Offset="0" />
                                    <GradientStop Color="#00FFFFFF" Offset="0.35" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <!-- The Console space look's pane of glass under the front card's name. -->
                        <Border Visibility="{DynamicResource ConsoleOnly}" Height="76" Margin="12" VerticalAlignment="Bottom"
                                CornerRadius="10" Background="#55102A08" BorderBrush="#33FFFFFF" BorderThickness="1"
                                Opacity="{Binding Path=(local:OldSchoolPanel.Front), RelativeSource={RelativeSource AncestorType=ContentPresenter}}" />
                        <!-- A shape and not text: text this big is not drawn at all on the small cards at the back. -->
                        <Path Data="{Binding Icon}" Fill="#FFFFFF" Stretch="Uniform" Width="116" Height="116"
                              Margin="0,0,48,34" HorizontalAlignment="Right" VerticalAlignment="Center" Opacity="0.95" />
                        <!-- Only on the front card: the ones behind have theirs half covered. -->
                        <Grid Margin="20,0,20,18" VerticalAlignment="Bottom"
                              Opacity="{Binding Path=(local:OldSchoolPanel.Front), RelativeSource={RelativeSource AncestorType=ContentPresenter}}">
                            <StackPanel Style="{StaticResource HiddenByNotice}">
                                <TextBlock Text="{Binding Title}" FontFamily="{DynamicResource CardTitleFont}" FontSize="26" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Detail}" Margin="0,2,0,0" FontSize="14" Opacity="0.9" TextWrapping="Wrap"
                                           TextTrimming="CharacterEllipsis" MaxHeight="40"
                                           Visibility="{Binding HasDetail, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource ShownByNotice}" Text="{Binding Notice}" FontSize="20"
                                       FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Bottom" />
                        </Grid>
                        <ContentControl Template="{StaticResource ConsoleCardGloss}" Focusable="False" IsTabStop="False" />
                        </Grid>
                        <Border x:Name="Ring" CornerRadius="14" Margin="-4" BorderThickness="3"
                                BorderBrush="{DynamicResource CardRingBrush}" Effect="{DynamicResource CardRingEffect}" Opacity="0" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Ring" Property="Opacity" Value="1" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <DataTemplate x:Key="OldSchoolAction">
        <Button Style="{StaticResource OldSchoolActionButton}" />
    </DataTemplate>

    <!-- Controller button hint: a round glyph and its label. -->
    <Style x:Key="HintGlyph" TargetType="Border">
        <Setter Property="Width" Value="26" />
        <Setter Property="Height" Value="26" />
        <Setter Property="CornerRadius" Value="13" />
        <Setter Property="Margin" Value="22,0,8,0" />
    </Style>

    <!-- A button hint's pill: nothing in the Classic look, a pane of glass in the Console space look. -->
    <Style x:Key="HintPill" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource PillBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PillBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="22" />
        <Setter Property="Padding" Value="{DynamicResource PillPadding}" />
        <Setter Property="Margin" Value="{DynamicResource PillGap}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Bumper hint at either end of the store filter. -->
    <Style x:Key="BumperGlyph" TargetType="Border">
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="8,3" />
        <Setter Property="Background" Value="#2A2F3A" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!--
        A tab in the top bar: a round button with the tab's icon or its store's logo. Not focusable, so
        keyboard focus stays on the tiles.
    -->
    <Style x:Key="FilterTab" TargetType="RadioButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Foreground" Value="#F2F3F5" />
        <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="Margin" Value="0,0,4,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Pill" Width="44" Height="44" CornerRadius="22" Background="#59101216" Opacity="0.85">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Pill" Property="Background" Value="#22FFFFFF" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Pill" Property="Background" Value="#F2F3F5" />
                            <Setter TargetName="Pill" Property="Opacity" Value="1" />
                            <Setter Property="Foreground" Value="#101010" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        A row of the menu. Over the dimmed library it is a rounded dark row; the Old School layout's panel
        puts its own in place of it (MenuPresenter), the row of the Xbox 360's settings panel.
    -->
    <Style x:Key="MenuButton" TargetType="Button">
        <Setter Property="Foreground" Value="#F2F3F5" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template" Value="{DynamicResource MenuRowTemplate}" />
    </Style>

    <!-- The Old School layout's menu panel: slate, lighter at the top left, with fine level lines across it. -->
    <LinearGradientBrush x:Key="MenuPanelBack" StartPoint="0,0" EndPoint="0.7,1">
        <GradientStop Color="#4C535B" Offset="0" />
        <GradientStop Color="#383E45" Offset="0.45" />
        <GradientStop Color="#2A2F35" Offset="1" />
    </LinearGradientBrush>
    <DrawingBrush x:Key="MenuPanelLines" TileMode="Tile" Viewport="0,0,4,4" ViewportUnits="Absolute"
                  Viewbox="0,0,4,4" ViewboxUnits="Absolute">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#00000000" Geometry="M0,0 H4 V4 H0 Z" />
                <GeometryDrawing Brush="#0EFFFFFF" Geometry="M0,0 H4 V1 H0 Z" />
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <!-- The menu panel's row in focus: a glossy green bar, lit along its top half. -->
    <LinearGradientBrush x:Key="MenuPanelBar" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#A8DC4E" Offset="0" />
        <GradientStop Color="#86C634" Offset="0.48" />
        <GradientStop Color="#6AB01E" Offset="0.52" />
        <GradientStop Color="#5FA41A" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="MenuPanelGloss" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#55FFFFFF" Offset="0" />
        <GradientStop Color="#14FFFFFF" Offset="1" />
    </LinearGradientBrush>

    <!--
        The row of the Old School menu panel: an icon and the row's name, what it is set to at the right,
        and a hairline under it. The row in focus is the green bar, its words in white with a dark edge
        under them. The edge is a second line of text, not a shadow effect: an effect would be drawn again
        every frame while the moving background runs behind the panel.
    -->
    <ControlTemplate x:Key="MenuPanelRowTemplate" TargetType="Button">
        <Grid x:Name="Row" Background="Transparent" MinHeight="44">
            <Rectangle Height="1" VerticalAlignment="Bottom" Margin="6,0" Fill="#30FFFFFF" />
            <Border x:Name="Bar" CornerRadius="3" Margin="0,1,0,1" BorderThickness="1" BorderBrush="#B4E86E"
                    Background="{StaticResource MenuPanelBar}" Opacity="0">
                <Border CornerRadius="2,2,0,0" Height="20" VerticalAlignment="Top" Background="{StaticResource MenuPanelGloss}" />
            </Border>
            <Grid Margin="10,0,14,0" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="36" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="Icon" Text="{Binding (local:MenuRow.Icon), RelativeSource={RelativeSource TemplatedParent}}"
                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="18" Foreground="#C9D0D6"
                           VerticalAlignment="Center" />
                <TextBlock x:Name="Edge" Grid.Column="1" Margin="1,1,0,0" Foreground="#5A2E5410" Visibility="Hidden"
                           Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" FontSize="17" VerticalAlignment="Center" />
                <TextBlock x:Name="Label" Grid.Column="1" Foreground="#EEF1F3"
                           Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" FontSize="17" VerticalAlignment="Center" />
                <TextBlock x:Name="Value" Grid.Column="2" Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                           Margin="18,0,0,0" FontSize="15" Foreground="#B8C0C6" TextTrimming="CharacterEllipsis"
                           HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bar" Property="Opacity" Value="0.3" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Bar" Property="Opacity" Value="1" />
                <Setter TargetName="Edge" Property="Visibility" Value="Visible" />
                <Setter TargetName="Label" Property="Foreground" Value="White" />
                <Setter TargetName="Icon" Property="Foreground" Value="White" />
                <Setter TargetName="Value" Property="Foreground" Value="#F4FFF0" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Row" Property="Opacity" Value="0.45" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- The row of the menu over the dimmed library: its name, and at the right what it is set to now. -->
    <ControlTemplate x:Key="MenuRowTemplate" TargetType="Button">
        <Border x:Name="Row" CornerRadius="8" Padding="{DynamicResource MenuRowPadding}" Margin="{DynamicResource MenuRowMargin}"
                MinHeight="{DynamicResource MenuRowHeight}"
                Background="{DynamicResource MenuRowBrush}" BorderThickness="2" BorderBrush="Transparent">
            <!--
                One line: the row's name, and at the right what it is set to now, which is
                its Tag. A row that only opens something or does something has no Tag.
            -->
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}"
                           FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                           Margin="18,0,0,0" FontSize="14.5" Opacity="0.75" TextTrimming="CharacterEllipsis"
                           HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Row" Property="Background" Value="{DynamicResource MenuRowFocusBrush}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Row" Property="Background" Value="{DynamicResource MenuRowFocusBrush}" />
                <Setter TargetName="Row" Property="BorderBrush" Value="#F2F3F5" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Row" Property="Opacity" Value="0.45" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- A round glyph button in the top bar. Only the ones the d-pad can reach are focusable. -->
    <Style x:Key="IconButton" TargetType="Button">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Foreground" Value="#F2F3F5" />
        <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Disc" Width="44" Height="44" CornerRadius="22" Background="#59101216" Opacity="0.85"
                            BorderBrush="Transparent" BorderThickness="2">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Disc" Property="Background" Value="#22FFFFFF" />
                            <Setter TargetName="Disc" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Disc" Property="Background" Value="#22FFFFFF" />
                            <Setter TargetName="Disc" Property="BorderBrush" Value="#F2F3F5" />
                            <Setter TargetName="Disc" Property="Opacity" Value="1" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A button with words on it in the top bar, the shape of the search box it sits beside. -->
    <Style x:Key="PillButton" TargetType="Button">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Foreground" Value="#F2F3F5" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Pill" Height="40" CornerRadius="20" Padding="18,0" Background="#66101216"
                            BorderBrush="Transparent" BorderThickness="2">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Pill" Property="Background" Value="#22FFFFFF" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Pill" Property="Background" Value="#22FFFFFF" />
                            <Setter TargetName="Pill" Property="BorderBrush" Value="#F2F3F5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Save and Cancel under the launch arguments box, sized for a finger. -->
    <Style x:Key="DialogButton" TargetType="Button">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Foreground" Value="#F2F3F5" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Margin" Value="8,0,0,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Pill" CornerRadius="8" Padding="22,0" MinHeight="44" Background="#2C3240">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Pill" Property="Background" Value="#3A4254" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
