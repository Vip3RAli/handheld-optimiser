<!--
    The details of the game picked in the row, below it, when Game Details is on: its play time, achievements,
    size and profile, and what its store says when Store Description is on. ContinuePresenter fills it. Until
    2026-11-16 this was also the Last played card above the games, which the user had taken out.
-->
<UserControl x:Class="HandheldOptimiser.HomeLauncher.Library.ContinueView"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel x:Name="ContinuePanel" Visibility="Collapsed">
        <!-- About the game: its play time and the like, and its store's description. -->
        <Border x:Name="ContinueInfo" Height="270" Margin="10" Padding="22,18" CornerRadius="8"
                Background="#66101216" Visibility="Collapsed">
            <DockPanel>
                <ItemsControl x:Name="ContinueRows" DockPanel.Dock="Left" Focusable="False" VerticalAlignment="Top">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="108" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Label}" FontSize="14" Opacity="0.72" />
                                <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="14"
                                           TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <!-- Wikipedia's text is free to show when it is credited. -->
                <TextBlock x:Name="ContinueSource" DockPanel.Dock="Bottom" Margin="28,8,0,0" FontSize="11"
                           Opacity="0.68" Visibility="Collapsed" />
                <TextBlock x:Name="ContinueAbout" Margin="28,0,0,0" FontSize="15" LineHeight="23" Opacity="0.85"
                           TextWrapping="Wrap" TextTrimming="CharacterEllipsis" Visibility="Collapsed" />
            </DockPanel>
        </Border>
    </StackPanel>
</UserControl>
