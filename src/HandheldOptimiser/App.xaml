<Application x:Class="HandheldOptimiser.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:views="clr-namespace:HandheldOptimiser.Views">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>

            <!-- FontIcon does not resolve an icon font on its own, so the glyphs render as boxes
                 without this. Segoe Fluent Icons ships with Windows 11; MDL2 is the Windows 10 fallback. -->
            <!-- WPF-UI 4.3.0's Dark.xaml defines this brush with a StaticResource to SystemAccentColorPrimary,
                 which lives in a sibling dictionary and cannot be resolved, so any ui:Badge throws on first
                 render. Redefining it here (app-level keys win over merged dictionaries) with a
                 DynamicResource matches how every other accent brush in the theme is declared. -->
            <SolidColorBrush x:Key="BadgeBackground" Color="{DynamicResource SystemAccentColorPrimary}" />

            <!--
                The look, set once. WPF-UI reads these keys with DynamicResource, so redefining them here
                changes every card, button and text box in the app without restyling any of them.
                Cards are sculpted dark charcoal with a dimensional slate edge, giving tactile depth
                reminiscent of the Xbox NXE console dashboard. Everything has a refined 10 px corner.
            -->
            <CornerRadius x:Key="ControlCornerRadius">10</CornerRadius>
            <SolidColorBrush x:Key="CardBackground" Color="#D9131822" />
            <SolidColorBrush x:Key="CardBorderBrush" Color="#2A3548" />

            <!-- Segoe UI Variable is Windows 11's own font; Segoe UI stands in on Windows 10. -->
            <FontFamily x:Key="ContentControlThemeFontFamily">Segoe UI Variable Text, Segoe UI</FontFamily>
            <FontFamily x:Key="AppFont">Segoe UI Variable Text, Segoe UI</FontFamily>
            <FontFamily x:Key="AppDisplayFont">Segoe UI Variable Display, Segoe UI</FontFamily>

            <!-- The brand Xbox Emerald Green, for accents drawn by hand rather than by a themed control. -->
            <SolidColorBrush x:Key="BrandAccent" Color="#1ED760" />
            <SolidColorBrush x:Key="BrandAccentStrong" Color="#107C10" />
            <SolidColorBrush x:Key="BrandOnAccent" Color="#FFFFFF" />

            <!-- For panels that are plain Borders rather than ui:Card, so they match the cards. -->
            <Style x:Key="Panel" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource CardBackground}" />
                <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="10" />
            </Style>

            <!--
                The ring around the control that has the keyboard. A handheld's controller reaches the
                app as arrow keys, so this is what shows where the D-pad is. WPF only draws it once a
                key has been pressed, so touch and the mouse never leave it behind. Controls drawn with
                their own template here (pills, cards, tiles) would otherwise get WPF's default, a
                dotted black line that cannot be seen on a dark window.
            -->
            <Style x:Key="FocusRing">
                <Setter Property="Control.Template">
                    <Setter.Value>
                        <ControlTemplate>
                            <Rectangle Margin="-3" RadiusX="13" RadiusY="13" StrokeThickness="2"
                                       Stroke="{StaticResource BrandAccent}" SnapsToDevicePixels="True" />
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!--
                A pill: the one-click button. A plain Button with
                its own template, because the rounded-rectangle look of the themed button is the thing
                being replaced.
            -->
            <Style x:Key="Pill" TargetType="Button">
                <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
                <Setter Property="MinHeight" Value="40" />
                <Setter Property="Padding" Value="18,0" />
                <Setter Property="FontSize" Value="13.5" />
                <Setter Property="Foreground" Value="#F8FAFC" />
                <Setter Property="Background" Value="#1A2230" />
                <Setter Property="BorderBrush" Value="#2C394E" />
                <Setter Property="Cursor" Value="Hand" />
                <!-- Half the height, for fully round ends. A larger figure does not do it: WPF scales an
                     oversized radius down unevenly and the ends come out as part of an ellipse. -->
                <Setter Property="Border.CornerRadius" Value="20" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Shape"
                                    CornerRadius="{TemplateBinding Border.CornerRadius}"
                                    Padding="{TemplateBinding Padding}"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Shape" Property="Opacity" Value="0.85" />
                                    <Setter TargetName="Shape" Property="BorderBrush" Value="#3B4B66" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Shape" Property="Opacity" Value="0.7" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Shape" Property="Opacity" Value="0.4" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="AccentPill" TargetType="Button" BasedOn="{StaticResource Pill}">
                <Setter Property="MinHeight" Value="56" />
                <Setter Property="Border.CornerRadius" Value="28" />
                <Setter Property="Background" Value="{StaticResource BrandAccentStrong}" />
                <Setter Property="BorderBrush" Value="{StaticResource BrandAccent}" />
                <Setter Property="Foreground" Value="{StaticResource BrandOnAccent}" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>

            <!--
                A tile: a name and a switch, a few to a row, so a whole goal fits on a screen or two. The
                tile itself is a button, and pressing it anywhere but on its switch opens what it does
                beneath its row. Its edge turns green while that detail is open (see ITile).
            -->
            <Style x:Key="Tile" TargetType="Button">
                <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
                <Setter Property="views:TileKeys.Enabled" Value="True" />
                <Setter Property="MinHeight" Value="64" />
                <Setter Property="Padding" Value="14,8" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Shape"
                                    CornerRadius="10"
                                    Background="{DynamicResource CardBackground}"
                                    BorderBrush="{DynamicResource CardBorderBrush}"
                                    BorderThickness="1">
                                <Border x:Name="Tint" CornerRadius="10" Padding="{TemplateBinding Padding}" Background="Transparent">
                                    <ContentPresenter VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                                </Border>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Tint" Property="Background" Value="#0AFFFFFF" />
                                </Trigger>
                                <DataTrigger Binding="{Binding IsOpen}" Value="True">
                                    <Setter TargetName="Shape" Property="BorderBrush" Value="{StaticResource BrandAccent}" />
                                    <Setter TargetName="Tint" Property="Background" Value="#221ED760" />
                                </DataTrigger>
                                <!-- While a job runs the page is disabled, and a tile has to look it. -->
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Shape" Property="Opacity" Value="0.5" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- The open tile's detail, the full width of the grid under the tile's row. It is scrolled
                 into view as it opens, since under the last row on screen it would be out of sight. -->
            <Style x:Key="TileDetail" TargetType="Border">
                <Setter Property="views:ShowWhenLoaded.Enabled" Value="True" />
                <Setter Property="Background" Value="#1C112618" />
                <Setter Property="BorderBrush" Value="#661ED760" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Padding" Value="16,12" />
            </Style>

            <Style TargetType="{x:Type ui:FontIcon}">
                <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            </Style>

            <!--
                Touch sizing. The app is mostly used on a handheld's touch screen, where WPF-UI's defaults are
                sized for a mouse: its scroll bars are a few pixels wide and only grow on hover, which a finger
                never triggers. These app-level styles win over the theme's.
            -->

            <!-- Drag anywhere in a list or page to scroll it, with momentum, as on a phone. -->
            <Style TargetType="ScrollViewer">
                <!-- Never a stop for the keyboard. A scroll viewer that has it draws an outline round the
                     whole page and takes the arrow keys to scroll with, so they stop moving between the
                     controls inside it. It still scrolls to follow the keyboard as it moves among them. -->
                <Setter Property="Focusable" Value="False" />
                <Setter Property="PanningMode" Value="VerticalFirst" />
                <Setter Property="PanningDeceleration" Value="0.003" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollViewer">
                            <Grid Background="{TemplateBinding Background}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- The name matters. An arrow key pressed on a control inside a scroll viewer
                                     is the scroll viewer's to deal with: it moves the keyboard to the next
                                     control that way, scrolling to it if need be. It finds its content by
                                     this name, and without it it only scrolls, so arrow keys (which is how
                                     a controller's D-pad arrives) never moved between controls at all. -->
                                <ScrollContentPresenter x:Name="PART_ScrollContentPresenter"
                                                        Grid.Row="0" Grid.Column="0"
                                                        Margin="{TemplateBinding Padding}"
                                                        CanContentScroll="{TemplateBinding CanContentScroll}" />

                                <!-- Beside the content rather than over it, so it never covers a control. -->
                                <ScrollBar x:Name="PART_VerticalScrollBar" Grid.Row="0" Grid.Column="1"
                                           Margin="6,2,0,2"
                                           Orientation="Vertical"
                                           Value="{TemplateBinding VerticalOffset}"
                                           Maximum="{TemplateBinding ScrollableHeight}"
                                           ViewportSize="{TemplateBinding ViewportHeight}"
                                           Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" />

                                <ScrollBar x:Name="PART_HorizontalScrollBar" Grid.Row="1" Grid.Column="0"
                                           Margin="2,6,2,0"
                                           Orientation="Horizontal"
                                           Value="{TemplateBinding HorizontalOffset}"
                                           Maximum="{TemplateBinding ScrollableWidth}"
                                           ViewportSize="{TemplateBinding ViewportWidth}"
                                           Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Tapping the track either side of the thumb pages up or down. -->
            <Style x:Key="ScrollTrackButton" TargetType="RepeatButton">
                <Setter Property="Focusable" Value="False" />
                <Setter Property="IsTabStop" Value="False" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RepeatButton">
                            <Border Background="Transparent" />
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="ScrollThumb" TargetType="Thumb">
                <Setter Property="Focusable" Value="False" />
                <Setter Property="IsTabStop" Value="False" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Thumb">
                            <Border x:Name="Grip" CornerRadius="7" Background="#73FFFFFF" />
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Grip" Property="Background" Value="#A6FFFFFF" />
                                </Trigger>
                                <Trigger Property="IsDragging" Value="True">
                                    <Setter TargetName="Grip" Property="Background" Value="#D9FFFFFF" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Wide enough to grab with a thumb, always visible, with a thumb that never gets tiny. -->
            <Style TargetType="ScrollBar">
                <Setter Property="Stylus.IsPressAndHoldEnabled" Value="False" />
                <Setter Property="Width" Value="14" />
                <Setter Property="MinWidth" Value="14" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid>
                                <Border CornerRadius="7" Background="#1FFFFFFF" />
                                <Track x:Name="PART_Track" IsDirectionReversed="True">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageUpCommand" Style="{StaticResource ScrollTrackButton}" />
                                    </Track.DecreaseRepeatButton>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageDownCommand" Style="{StaticResource ScrollTrackButton}" />
                                    </Track.IncreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource ScrollThumb}" MinHeight="56" />
                                    </Track.Thumb>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="Orientation" Value="Horizontal">
                        <Setter Property="Width" Value="Auto" />
                        <Setter Property="MinWidth" Value="0" />
                        <Setter Property="Height" Value="14" />
                        <Setter Property="MinHeight" Value="14" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ScrollBar">
                                    <Grid>
                                        <Border CornerRadius="7" Background="#1FFFFFFF" />
                                        <Track x:Name="PART_Track" IsDirectionReversed="False">
                                            <Track.DecreaseRepeatButton>
                                                <RepeatButton Command="ScrollBar.PageLeftCommand" Style="{StaticResource ScrollTrackButton}" />
                                            </Track.DecreaseRepeatButton>
                                            <Track.IncreaseRepeatButton>
                                                <RepeatButton Command="ScrollBar.PageRightCommand" Style="{StaticResource ScrollTrackButton}" />
                                            </Track.IncreaseRepeatButton>
                                            <Track.Thumb>
                                                <Thumb Style="{StaticResource ScrollThumb}" MinWidth="56" />
                                            </Track.Thumb>
                                        </Track>
                                    </Grid>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- Buttons, switches and other controls are sized for fingers in TouchSizing.cs rather than
                 restyled here: a style BasedOn WPF-UI's does not pick up its themed template. -->

        </ResourceDictionary>
    </Application.Resources>
</Application>
