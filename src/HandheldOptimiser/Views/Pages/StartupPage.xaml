<UserControl x:Class="HandheldOptimiser.Views.Pages.StartupPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="4,0,4,12">
            <TextBlock Text="Startup Apps" FontSize="26" FontWeight="SemiBold" />
            <TextBlock Text="{Binding Subtitle}" Opacity="0.7" FontSize="13" Margin="0,2,0,0" TextWrapping="Wrap" />

            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                <ui:Button Content="Re-scan" Command="{Binding ScanCommand}" />
            </StackPanel>

            <TextBlock Text="{Binding SummaryText}" Opacity="0.7" FontSize="12" Margin="0,10,0,0" />
            <TextBlock Margin="0,4,0,0" FontSize="11.5" Opacity="0.55" TextWrapping="Wrap"
                       Text="Disabling uses the same mechanism as Task Manager, so entries stay visible there and can be re-enabled from either place." />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Entries}" Margin="4,0,4,8">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#10FFFFFF" CornerRadius="6" Padding="12,10" Margin="0,0,0,6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"
                                                   VerticalAlignment="Center" TextWrapping="Wrap" />
                                        <ui:Badge Content="{Binding ScopeLabel}" FontSize="9" Margin="8,0,0,0"
                                                  VerticalAlignment="Center" />
                                    </StackPanel>

                                    <TextBlock Text="{Binding Command}" FontFamily="Consolas" FontSize="10.5"
                                               Opacity="0.45" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                                </StackPanel>

                                <ui:ToggleSwitch Grid.Column="1"
                                                 IsChecked="{Binding IsEnabled, Mode=TwoWay}"                                                 Click="OnToggleClicked"
                                                 VerticalAlignment="Center"
                                                 MinWidth="48" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
