<UserControl x:Class="HandheldOptimiser.Views.Pages.AsusHealthPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:views="clr-namespace:HandheldOptimiser.Views">

    <UserControl.Resources>
        <views:BooleanToVisibilityConverter x:Key="BoolToVis" />
        <views:StringNotEmptyToVisibilityConverter x:Key="StringToVis" />
        <views:HealthStatusToBrushConverter x:Key="HealthBrush" />
        <views:HealthStatusToGlyphConverter x:Key="HealthGlyph" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="4,0,4,12">
            <TextBlock Text="ASUS &amp; Health" FontSize="26" FontWeight="SemiBold" />
            <TextBlock Text="{Binding HardwareModel}" Opacity="0.7" FontSize="13" Margin="0,2,0,0" />

            <ui:InfoBar Severity="Informational"
                        IsOpen="True"
                        IsClosable="False"
                        Margin="0,12,0,0"
                        Title="This page has no toggles on purpose"
                        Message="Armoury Crate SE, ASUS services, AMD drivers, Realtek audio, Defender and Windows Update are all on a hard denylist that blocks modification at write time. This page verifies they are intact, and can re-enable them if another tool disabled them." />

            <TextBlock Text="{Binding SummaryText}" Opacity="0.8" FontSize="12.5" Margin="0,12,0,0" TextWrapping="Wrap" />

            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                <ui:Button Content="Re-check" Command="{Binding RefreshCommand}" Margin="0,0,10,0" />
                <ui:Button Content="Repair disabled services"
                           Appearance="Primary"
                           Command="{Binding RepairCommand}" />
            </StackPanel>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Checks}" Margin="4,0,4,8">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#10FFFFFF" CornerRadius="6" Padding="12,10" Margin="0,0,0,6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <ui:FontIcon Grid.Column="0"
                                             Glyph="{Binding Status, Converter={StaticResource HealthGlyph}}"
                                             Foreground="{Binding Status, Converter={StaticResource HealthBrush}}"
                                             FontSize="17"
                                             VerticalAlignment="Top"
                                             Margin="0,2,12,0" />

                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="SemiBold"
                                               TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Detail}" FontSize="11.5" Opacity="0.6"
                                               Margin="0,3,0,0" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Advice}" FontSize="11.5" Foreground="#E8C45F"
                                               Opacity="0.9" Margin="0,5,0,0" TextWrapping="Wrap"
                                               Visibility="{Binding Advice, Converter={StaticResource StringToVis}}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
