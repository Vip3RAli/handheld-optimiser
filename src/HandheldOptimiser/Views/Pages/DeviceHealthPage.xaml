<UserControl x:Class="HandheldOptimiser.Views.Pages.DeviceHealthPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:views="clr-namespace:HandheldOptimiser.Views">

    <UserControl.Resources>
        <views:BooleanToVisibilityConverter x:Key="BoolToVis" />
        <views:StringNotEmptyToVisibilityConverter x:Key="StringToVis" />
        <views:HealthStatusToBrushConverter x:Key="HealthBrush" />
        <views:HealthStatusToGlyphConverter x:Key="HealthGlyph" />

        <!-- A row is read left to right: its mark, what it is, and the answer. The title column is the
             same width in every section, so the answers line up down the page. -->
        <GridLength x:Key="MarkWidth">26</GridLength>
        <GridLength x:Key="TitleWidth">250</GridLength>

        <Style x:Key="SectionHeading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Opacity" Value="0.65" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <DataTemplate x:Key="HealthRow">
            <Grid Margin="0,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{StaticResource MarkWidth}" />
                    <ColumnDefinition Width="{StaticResource TitleWidth}" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ui:FontIcon Grid.Column="0"
                             Glyph="{Binding Status, Converter={StaticResource HealthGlyph}}"
                             Foreground="{Binding Status, Converter={StaticResource HealthBrush}}"
                             FontSize="14"
                             HorizontalAlignment="Left"
                             VerticalAlignment="Top"
                             Margin="0,2,0,0" />

                <StackPanel Grid.Column="1" Margin="0,0,12,0">
                    <TextBlock Text="{Binding Title}" FontSize="13" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Tag}" FontSize="11" Opacity="0.5" TextWrapping="Wrap"
                               Visibility="{Binding Tag, Converter={StaticResource StringToVis}}" />
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="{Binding Value}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <ProgressBar Value="{Binding BarValue, Mode=OneWay}" Maximum="100"
                                 Height="4" Width="200" HorizontalAlignment="Left" Margin="0,6,0,2"
                                 Visibility="{Binding HasBar, Converter={StaticResource BoolToVis}}" />
                    <TextBlock Text="{Binding Note}" FontSize="11.5" Opacity="0.6" Margin="0,2,0,0" TextWrapping="Wrap"
                               Visibility="{Binding Note, Converter={StaticResource StringToVis}}" />
                </StackPanel>

                <ui:Button Grid.Column="3"
                           Content="{Binding OpenText}"
                           Command="{Binding DataContext.OpenCheckCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                           CommandParameter="{Binding}"
                           VerticalAlignment="Top"
                           Margin="12,0,0,0"
                           Visibility="{Binding OpenText, Converter={StaticResource StringToVis}}" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="HealthTable">
            <StackPanel Margin="26,4,0,6">
                <TextBlock Text="{Binding Heading}" FontSize="13" FontWeight="SemiBold" />

                <Grid Margin="0,6,0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{StaticResource TitleWidth}" />
                        <ColumnDefinition Width="170" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="1" Text="Plugged in" FontSize="11.5" Opacity="0.55" />
                    <TextBlock Grid.Column="2" Text="On battery" FontSize="11.5" Opacity="0.55" />
                </Grid>

                <ItemsControl ItemsSource="{Binding Rows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{StaticResource TitleWidth}" />
                                    <ColumnDefinition Width="170" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Label}" FontSize="13" Margin="0,0,12,0" />
                                <TextBlock Grid.Column="1" Text="{Binding PluggedIn}" FontSize="13" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="2" Text="{Binding OnBattery}" FontSize="13" FontWeight="SemiBold" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="4,0,4,12">
            <TextBlock Text="Device &amp; System Health" FontSize="28" FontWeight="SemiBold" FontFamily="{StaticResource AppDisplayFont}" />
            <TextBlock Text="{Binding HardwareModel}" Opacity="0.7" FontSize="13" Margin="0,2,0,0" />

            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- The answer to "is anything wrong?", before anything else on the page. -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Style="{StaticResource Panel}" Padding="12,7" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <ui:FontIcon Glyph="{Binding WorstStatus, Converter={StaticResource HealthGlyph}}"
                                         Foreground="{Binding WorstStatus, Converter={StaticResource HealthBrush}}"
                                         FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="{Binding AttentionText}" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{Binding WorstStatus, Converter={StaticResource HealthBrush}}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Panel}" Padding="12,7"
                            Visibility="{Binding FineText, Converter={StaticResource StringToVis}}">
                        <TextBlock Text="{Binding FineText}" FontSize="13" Opacity="0.75" VerticalAlignment="Center" />
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <ui:Button Content="Re-check" Command="{Binding RefreshCommand}" Margin="0,0,10,0" />
                    <ui:Button Content="Repair disabled services"
                               Appearance="Primary"
                               Command="{Binding RepairCommand}" />
                </StackPanel>
            </Grid>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="4,0,4,8">

                <!-- Whatever is yellow or red, with its explanation, so it is never below the fold. -->
                <Border Style="{StaticResource Panel}" Padding="14,10" Margin="0,0,0,8"
                        BorderBrush="{Binding WorstStatus, Converter={StaticResource HealthBrush}}"
                        Visibility="{Binding HasAttention, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="NEEDS A LOOK" Style="{StaticResource SectionHeading}" Margin="0,0,0,4" />
                        <ItemsControl ItemsSource="{Binding Attention}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="{StaticResource MarkWidth}" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <ui:FontIcon Grid.Column="0"
                                                     Glyph="{Binding Status, Converter={StaticResource HealthGlyph}}"
                                                     Foreground="{Binding Status, Converter={StaticResource HealthBrush}}"
                                                     FontSize="14" HorizontalAlignment="Left" VerticalAlignment="Top"
                                                     Margin="0,2,0,0" />

                                        <StackPanel Grid.Column="1">
                                            <TextBlock TextWrapping="Wrap">
                                                <Run Text="{Binding Title, Mode=OneWay}" FontSize="13.5" FontWeight="SemiBold" />
                                                <Run Text="  " />
                                                <Run Text="{Binding Tag, Mode=OneWay}" FontSize="11.5" Foreground="#8CFFFFFF" />
                                            </TextBlock>
                                            <TextBlock Text="{Binding Detail}" FontSize="12.5" Opacity="0.8"
                                                       Margin="0,3,0,0" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Advice}" FontSize="12" Foreground="#E8C45F"
                                                       Margin="0,4,0,0" TextWrapping="Wrap"
                                                       Visibility="{Binding Advice, Converter={StaticResource StringToVis}}" />
                                        </StackPanel>

                                        <ui:Button Grid.Column="2"
                                                   Content="{Binding OpenText}"
                                                   Command="{Binding DataContext.OpenCheckCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                   CommandParameter="{Binding}"
                                                   VerticalAlignment="Top"
                                                   Margin="12,0,0,0"
                                                   Visibility="{Binding OpenText, Converter={StaticResource StringToVis}}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <ItemsControl ItemsSource="{Binding Sections}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Panel}" Padding="14,10" Margin="0,0,0,8">
                                <StackPanel>
                                    <Grid MinHeight="30">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="{Binding Heading}" Style="{StaticResource SectionHeading}" />
                                        <TextBlock Grid.Column="1" Text="{Binding Summary}" FontSize="12.5" Opacity="0.75"
                                                   VerticalAlignment="Center" Margin="14,0,0,0" />
                                        <ui:Button Grid.Column="2"
                                                   Content="{Binding ToggleText}"
                                                   Command="{Binding ToggleCommand}"
                                                   Visibility="{Binding CanToggle, Converter={StaticResource BoolToVis}}" />
                                    </Grid>

                                    <ItemsControl ItemsSource="{Binding Rows}"
                                                  ItemTemplate="{StaticResource HealthRow}"
                                                  Visibility="{Binding ShowRows, Converter={StaticResource BoolToVis}}" />

                                    <ItemsControl ItemsSource="{Binding Tables}" ItemTemplate="{StaticResource HealthTable}" />

                                    <ItemsControl ItemsSource="{Binding MoreTables}"
                                                  ItemTemplate="{StaticResource HealthTable}"
                                                  Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}" />

                                    <TextBlock Text="{Binding Note}" FontSize="11.5" Opacity="0.55" Margin="26,4,0,2"
                                               TextWrapping="Wrap"
                                               Visibility="{Binding Note, Converter={StaticResource StringToVis}}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
