<UserControl x:Class="HandheldOptimiser.Views.Pages.BloatwarePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:HandheldOptimiser.ViewModels"
             xmlns:views="clr-namespace:HandheldOptimiser.Views">

    <UserControl.Resources>
        <views:BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!--
            A preinstalled app's tile: a tick box and its name. Pressing the tick box chooses the app
            for removal; pressing the rest of the tile opens what it is.
        -->
        <DataTemplate DataType="{x:Type vm:AppxRowViewModel}">
            <Button Style="{StaticResource Tile}"
                    MinHeight="52"
                    Padding="6,4,12,4"
                    AutomationProperties.Name="{Binding FriendlyName}"
                    Command="{Binding DataContext.Cells.ToggleCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                    CommandParameter="{Binding}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Wide and tall enough to hit with a thumb without opening the tile instead. Enter
                         ticks it too: that is the controller's A button, and a tick box by itself only
                         answers to Space. -->
                    <CheckBox Grid.Column="0"
                              IsChecked="{Binding IsSelected, Mode=TwoWay}"
                              Checked="OnSelectionChanged"
                              Unchecked="OnSelectionChanged"
                              KeyboardNavigation.AcceptsReturn="True"
                              MinWidth="40"
                              MinHeight="40"
                              Padding="0"
                              HorizontalContentAlignment="Center"
                              VerticalAlignment="Center" />

                    <TextBlock Grid.Column="1" Text="{Binding FriendlyName}" FontSize="14" TextWrapping="Wrap"
                               VerticalAlignment="Center" />

                    <!-- A reason someone might want to keep this one. It is in the detail. -->
                    <ui:FontIcon Grid.Column="2" Glyph="&#xE7BA;" FontSize="13" Margin="8,0,0,0"
                                 VerticalAlignment="Center" Foreground="#E8C45F"
                                 Visibility="{Binding HasKeepNote, Converter={StaticResource BoolToVis}}" />
                </Grid>
            </Button>
        </DataTemplate>

        <!-- The real package id, so nothing is removed sight-unseen, and where it is installed. -->
        <DataTemplate DataType="{x:Type vm:TileDetail}">
            <Border Style="{StaticResource TileDetail}" DataContext="{Binding Tile}">
                <StackPanel>
                    <ui:Badge Content="Recommended" FontSize="10" HorizontalAlignment="Left" Margin="0,0,0,8"
                              Visibility="{Binding Recommended, Converter={StaticResource BoolToVis}}" />
                    <TextBlock Text="{Binding IdentityName}" FontFamily="Consolas" FontSize="12" Opacity="0.8"
                               TextWrapping="Wrap" />
                    <TextBlock Text="{Binding ScopeText}" FontSize="12" Opacity="0.7" Margin="0,3,0,0" />
                    <TextBlock Text="{Binding KeepIfNote, StringFormat='Keep it if {0}'}" FontSize="12.5" Foreground="#E8C45F" Opacity="0.9"
                               TextWrapping="Wrap" Margin="0,8,0,0"
                               Visibility="{Binding HasKeepNote, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <StackPanel>
        <ui:InfoBar Severity="Informational"
                    IsOpen="True"
                    IsClosable="False"
                    Title="One-way operation"
                    Message="Removal cannot be undone from this app. Getting an app back means reinstalling it from the Microsoft Store. ASUS, AMD, Realtek, Xbox/Game Pass, Store and codec packages are never listed here and are blocked from removal." />

        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
            <ui:Button Content="Select recommended" Command="{Binding SelectRecommendedCommand}" Margin="0,0,10,0" />
            <ui:Button Content="Clear selection" Command="{Binding ClearSelectionCommand}" Margin="0,0,14,0" />
            <TextBlock Text="{Binding SelectedText}" FontSize="13" Opacity="0.8" VerticalAlignment="Center" />
        </StackPanel>

        <TextBlock Text="{Binding SummaryText}" Opacity="0.7" FontSize="12" Margin="2,10,2,12" TextWrapping="Wrap" />

        <!-- Each group of apps as tiles four across, with the open one's detail under its row. -->
        <ItemsControl ItemsSource="{Binding Groups}" Focusable="False">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="0,0,0,14">
                        <TextBlock Text="{Binding Header}" FontSize="14" FontWeight="SemiBold"
                                   Opacity="0.85" Margin="2,0,0,8" />

                        <ItemsControl ItemsSource="{Binding Cells.Cells}" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <views:TileGrid Columns="{Binding Cells.Columns}" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <ui:Button Content="Remove selected apps"
                   Appearance="Primary"
                   Height="52"
                   FontSize="15"
                   Margin="0,2,0,0"
                   HorizontalAlignment="Stretch"
                   HorizontalContentAlignment="Center"
                   Command="{Binding RemoveSelectedCommand}" />
    </StackPanel>
</UserControl>
