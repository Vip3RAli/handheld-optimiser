<UserControl x:Class="HandheldOptimiser.Views.Pages.GoalPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:HandheldOptimiser.Views">

    <UserControl.Resources>
        <views:StringNotEmptyToVisibilityConverter x:Key="StringToVis" />
        <views:UpperCaseConverter x:Key="Upper" />
        <views:BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <!--
        One goal's page: its sections, one under another, in the one scroll viewer the page has. A
        section must not scroll by itself, or it would swallow the drag that moves the page.
        Each section's own view comes from the DataTemplate for its type in MainWindow.
    -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <ItemsControl ItemsSource="{Binding Sections}" Margin="4,0,4,8" Focusable="False">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <!-- A section that does not apply to this device is left out, heading and all. -->
                    <StackPanel Margin="0,0,0,12" Visibility="{Binding IsShown, Converter={StaticResource BoolToVis}}">
                        <!-- A page with one section has no heading over it. -->
                        <Grid Margin="2,2,2,8"
                              Visibility="{Binding Heading, Converter={StaticResource StringToVis}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding Heading, Converter={StaticResource Upper}}"
                                       FontSize="12" FontWeight="SemiBold" Opacity="0.65" />
                            <TextBlock Grid.Column="1" Text="{Binding Summary}" FontSize="12" Opacity="0.65" />
                        </Grid>

                        <ContentPresenter Content="{Binding}" />
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </ScrollViewer>
</UserControl>
