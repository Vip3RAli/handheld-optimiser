<UserControl x:Class="HandheldOptimiser.Views.Pages.TweakListPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:HandheldOptimiser.ViewModels"
             xmlns:views="clr-namespace:HandheldOptimiser.Views">

    <UserControl.Resources>
        <views:BooleanToVisibilityConverter x:Key="BoolToVis" />
        <views:InverseBooleanToVisibilityConverter x:Key="NotToVis" />
        <views:TweakStateToBrushConverter x:Key="StateBrush" />

        <!-- A tweak's tile: its name and its switch, and nothing else unless there is something to say. -->
        <DataTemplate DataType="{x:Type vm:TweakItemViewModel}">
            <Button Style="{StaticResource Tile}"
                    AutomationProperties.Name="{Binding Name}"
                    Command="{Binding DataContext.Cells.ToggleCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                    CommandParameter="{Binding}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                        <TextBlock Text="{Binding Name}" FontSize="14.5" FontWeight="SemiBold"
                                   FontFamily="{StaticResource AppDisplayFont}" TextWrapping="Wrap" />

                        <!-- A workaround for another device's fault, which is never applied in bulk. -->
                        <TextBlock Text="{Binding DeviceBadge}" FontSize="11.5" Opacity="0.7" Margin="0,2,0,0"
                                   Foreground="{StaticResource BrandAccent}"
                                   Visibility="{Binding HasDeviceBadge, Converter={StaticResource BoolToVis}}" />

                        <!-- The switch says on or off. Words are added only when the answer is neither. -->
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0"
                                    Visibility="{Binding HasStateNote, Converter={StaticResource BoolToVis}}">
                            <Ellipse Width="7" Height="7" Margin="0,1,6,0" VerticalAlignment="Center"
                                     Fill="{Binding State, Converter={StaticResource StateBrush}}" />
                            <TextBlock Text="{Binding StateText}" FontSize="11.5" Opacity="0.7" />
                        </StackPanel>
                    </StackPanel>

                    <!-- This one carries a warning. It is in the detail, and is shown before switching on. -->
                    <ui:FontIcon Grid.Column="1" Glyph="&#xE7BA;" FontSize="14" Margin="0,0,10,0"
                                 VerticalAlignment="Center" Foreground="#E8C45F"
                                 Visibility="{Binding HasWarning, Converter={StaticResource BoolToVis}}" />

                    <!-- While the tweak is being changed, the ring stands where its switch was. -->
                    <Grid Grid.Column="2" MinWidth="48" VerticalAlignment="Center">
                        <ui:ProgressRing IsIndeterminate="True" Width="20" Height="20"
                                         Visibility="{Binding IsWorking, Converter={StaticResource BoolToVis}}" />
                        <ui:ToggleSwitch IsChecked="{Binding IsOn, Mode=TwoWay}"
                                         IsEnabled="{Binding IsKnown}"
                                         Click="OnToggleClicked"
                                         MinWidth="48"
                                         Visibility="{Binding IsWorking, Converter={StaticResource NotToVis}}" />
                    </Grid>
                </Grid>
            </Button>
        </DataTemplate>

        <!-- What the open tweak does, and what it costs: everything the tile leaves out. -->
        <DataTemplate DataType="{x:Type vm:TileDetail}">
            <Border Style="{StaticResource TileDetail}" DataContext="{Binding Tile}">
                <StackPanel>
                    <WrapPanel Orientation="Horizontal">
                        <ui:Badge Content="{Binding RiskBadge}" FontSize="10" Margin="0,0,6,0" />
                        <ui:Badge Content="{Binding DeviceBadge}" FontSize="10" Margin="0,0,6,0"
                                  Visibility="{Binding HasDeviceBadge, Converter={StaticResource BoolToVis}}" />
                        <Border CornerRadius="4" Padding="8,2" Margin="0,0,6,0" Background="#22FFFFFF">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="7" Height="7" Margin="0,0,6,0" VerticalAlignment="Center"
                                         Fill="{Binding State, Converter={StaticResource StateBrush}}" />
                                <TextBlock Text="{Binding StateText}" FontSize="10" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <ui:Badge Content="Needs restart" FontSize="10"
                                  Visibility="{Binding RequiresReboot, Converter={StaticResource BoolToVis}}" />
                    </WrapPanel>

                    <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Opacity="0.9"
                               Margin="0,8,0,0" FontSize="13" />

                    <Border Visibility="{Binding HasWarning, Converter={StaticResource BoolToVis}}"
                            Background="#1AE8C45F"
                            BorderBrush="#55E8C45F"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="10,8"
                            Margin="0,10,0,0">
                        <DockPanel>
                            <ui:FontIcon Glyph="&#xE7BA;" FontSize="14" Margin="0,0,8,0" DockPanel.Dock="Left"
                                         VerticalAlignment="Top" Foreground="#E8C45F" />
                            <TextBlock Text="{Binding Warning}" TextWrapping="Wrap" FontSize="12.5" Opacity="0.9" />
                        </DockPanel>
                    </Border>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <!--
        One section of tweaks, as tiles three across. The page it sits on has the heading, the scrolling
        and Apply all. The cells are the tiles plus the open tile's detail, which TileGrid gives a row
        of its own.
    -->
    <ItemsControl ItemsSource="{Binding Cells.Cells}" Focusable="False">
        <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
                <views:TileGrid Columns="{Binding Cells.Columns}" />
            </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
    </ItemsControl>
</UserControl>
