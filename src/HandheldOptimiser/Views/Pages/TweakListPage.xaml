<UserControl x:Class="HandheldOptimiser.Views.Pages.TweakListPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:views="clr-namespace:HandheldOptimiser.Views">

    <UserControl.Resources>
        <views:BooleanToVisibilityConverter x:Key="BoolToVis" />
        <views:TweakStateToBrushConverter x:Key="StateBrush" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="4,0,4,12">
            <TextBlock Text="{Binding Title}" FontSize="26" FontWeight="SemiBold" />
            <TextBlock Text="{Binding Subtitle}" Opacity="0.7" FontSize="13" Margin="0,2,0,0" TextWrapping="Wrap" />

            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                <ui:Button Content="Apply all on this page"
                           Appearance="Primary"
                           Command="{Binding ApplyAllInCategoryCommand}"
                           Margin="0,0,10,0" />
                <ui:Button Content="Re-check"
                           Command="{Binding RefreshCommand}" />
            </StackPanel>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Tweaks}" Margin="4,0,4,8">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ui:Card Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                    <!-- Name + badges -->
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold"
                                                   TextWrapping="Wrap" VerticalAlignment="Center" />
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <ui:Badge Content="{Binding RiskBadge}" FontSize="10" Margin="0,0,6,0" />
                                        <Border CornerRadius="9" Padding="8,2" Margin="0,0,6,0"
                                                Background="#22FFFFFF">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="7" Height="7" Margin="0,0,6,0"
                                                         VerticalAlignment="Center"
                                                         Fill="{Binding State, Converter={StaticResource StateBrush}}" />
                                                <TextBlock Text="{Binding StateText}" FontSize="10"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                        <ui:Badge Content="Needs restart" FontSize="10"
                                                  Visibility="{Binding RequiresReboot, Converter={StaticResource BoolToVis}}" />
                                    </StackPanel>

                                    <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Opacity="0.75"
                                               Margin="0,8,0,0" FontSize="12.5" />

                                    <!-- Warnings are never hidden behind a tooltip. -->
                                    <Border Visibility="{Binding HasWarning, Converter={StaticResource BoolToVis}}"
                                            Background="#1AE8C45F"
                                            BorderBrush="#55E8C45F"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="10,8"
                                            Margin="0,10,0,0">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:FontIcon Glyph="&#xE7BA;" FontSize="14" Margin="0,0,8,0"
                                                         VerticalAlignment="Top" Foreground="#E8C45F" />
                                            <TextBlock Text="{Binding Warning}" TextWrapping="Wrap" FontSize="12"
                                                       Opacity="0.9" MaxWidth="620" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <ui:ProgressRing IsIndeterminate="True" Width="20" Height="20"
                                                     Margin="0,0,0,6"
                                                     Visibility="{Binding IsWorking, Converter={StaticResource BoolToVis}}" />
                                    <ui:ToggleSwitch IsChecked="{Binding IsOn, Mode=TwoWay}"
                                                     Click="OnToggleClicked"
                                                     MinWidth="48" />
                                </StackPanel>
                            </Grid>
                        </ui:Card>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
