<UserControl x:Class="HandheldOptimiser.Views.Pages.PowerActionsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:views="clr-namespace:HandheldOptimiser.Views">

    <UserControl.Resources>
        <views:BooleanToVisibilityConverter x:Key="BoolToVis" />
        <views:StringNotEmptyToVisibilityConverter x:Key="StringToVis" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="4,0,4,12">
            <TextBlock Text="{Binding Title}" FontSize="26" FontWeight="SemiBold" />
            <TextBlock Text="{Binding Subtitle}" Opacity="0.7" FontSize="13" Margin="0,2,0,0" TextWrapping="Wrap" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Actions}" Margin="4,0,4,8">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ui:Card Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <ui:FontIcon Grid.Column="0" Glyph="{Binding Glyph}" FontSize="26"
                                             Margin="0,2,16,0" VerticalAlignment="Top" />

                                <StackPanel Grid.Column="1" Margin="0,0,16,0">
                                    <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Opacity="0.75"
                                               Margin="0,6,0,0" FontSize="12.5" />
                                    <TextBlock Text="{Binding DurationHint, StringFormat=Takes: {0}}" FontSize="11.5"
                                               Opacity="0.55" Margin="0,6,0,0"
                                               Visibility="{Binding DurationHint, Converter={StaticResource StringToVis}}" />

                                    <Border Visibility="{Binding HasWarning, Converter={StaticResource BoolToVis}}"
                                            Background="#1AE8C45F"
                                            BorderBrush="#55E8C45F"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="10,8"
                                            Margin="0,10,0,0">
                                        <DockPanel>
                                            <ui:FontIcon Glyph="&#xE7BA;" FontSize="14" Margin="0,0,8,0" DockPanel.Dock="Left"
                                                         VerticalAlignment="Top" Foreground="#E8C45F" />
                                            <TextBlock Text="{Binding Warning}" TextWrapping="Wrap" FontSize="12"
                                                       Opacity="0.9" />
                                        </DockPanel>
                                    </Border>

                                    <TextBlock Text="{Binding LastResult}" FontSize="11.5" Opacity="0.7"
                                               Margin="0,8,0,0" TextWrapping="Wrap"
                                               Visibility="{Binding LastResult, Converter={StaticResource StringToVis}}" />
                                </StackPanel>

                                <!-- Sized for a thumb on a 7" touchscreen. -->
                                <ui:Button Grid.Column="2"
                                           Appearance="Primary"
                                           Command="{Binding RunCommand}"
                                           MinWidth="120"
                                           MinHeight="44"
                                           VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:ProgressRing IsIndeterminate="True" Width="16" Height="16"
                                                         Margin="0,0,8,0" VerticalAlignment="Center"
                                                         Visibility="{Binding IsWorking, Converter={StaticResource BoolToVis}}" />
                                        <TextBlock Text="{Binding ButtonText}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </ui:Button>
                            </Grid>
                        </ui:Card>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
