<UserControl x:Class="HandheldOptimiser.Views.Pages.UpdatesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:views="clr-namespace:HandheldOptimiser.Views">

    <UserControl.Resources>
        <views:BooleanToVisibilityConverter x:Key="BoolToVis" />
        <views:StringNotEmptyToVisibilityConverter x:Key="StringToVis" />
        <views:UpdateRowStateToBrushConverter x:Key="StateBrush" />

        <DataTemplate x:Key="UpdateRow">
            <Border Style="{StaticResource Panel}" Padding="12,10" Margin="0,0,0,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <CheckBox Grid.Column="0"
                              IsChecked="{Binding IsSelected, Mode=TwoWay}"
                              IsEnabled="{Binding CanSelect}"
                              VerticalAlignment="Center"
                              Margin="0,0,12,0" />

                    <StackPanel Grid.Column="1" Margin="0,0,12,0">
                        <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" />

                        <WrapPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <Border CornerRadius="4" Padding="8,2" Margin="0,0,10,0" Background="#22FFFFFF"
                                    VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="7" Height="7" Margin="0,0,6,0" VerticalAlignment="Center"
                                             Fill="{Binding State, Converter={StaticResource StateBrush}}" />
                                    <TextBlock Text="{Binding StatusText}" FontSize="10.5" VerticalAlignment="Center"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <TextBlock Text="{Binding VersionText}" FontFamily="Consolas" FontSize="11.5"
                                       Opacity="0.65" VerticalAlignment="Center"
                                       Visibility="{Binding VersionText, Converter={StaticResource StringToVis}}" />
                        </WrapPanel>

                        <TextBlock Text="{Binding Detail}" FontFamily="Consolas" FontSize="11" Opacity="0.5"
                                   Margin="0,4,0,0" TextTrimming="CharacterEllipsis"
                                   Visibility="{Binding Detail, Converter={StaticResource StringToVis}}" />
                    </StackPanel>

                    <!-- Sized for a thumb on a 7" touchscreen. -->
                    <ui:Button Grid.Column="2"
                               Content="Skip"
                               ToolTip="Stop listing this update"
                               Command="{Binding SkipCommand}"
                               Visibility="{Binding CanSelect, Converter={StaticResource BoolToVis}}"
                               MinWidth="80"
                               MinHeight="40"
                               VerticalAlignment="Center" />
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="4,0,4,12">
            <TextBlock Text="{Binding Title}" FontSize="28" FontWeight="SemiBold" FontFamily="{StaticResource AppDisplayFont}" />
            <TextBlock Text="{Binding Subtitle}" Opacity="0.7" FontSize="13" Margin="0,2,0,0" TextWrapping="Wrap" />

            <WrapPanel Orientation="Horizontal" Margin="0,12,0,0">
                <ui:Button Content="Check for updates" Command="{Binding CheckCommand}" Margin="0,0,10,6" />
                <ui:Button Content="Select all" Command="{Binding SelectAllCommand}" Margin="0,0,10,6" />
                <ui:Button Content="Select none" Command="{Binding SelectNoneCommand}" Margin="0,0,16,6" />
                <ui:ToggleSwitch IsChecked="{Binding IncludeDrivers, Mode=TwoWay}" MinHeight="36" Margin="0,0,0,6"
                                 VerticalAlignment="Center"
                                 Content="Include driver updates" />
            </WrapPanel>

            <TextBlock Text="{Binding SummaryText}" Opacity="0.7" FontSize="12" Margin="0,4,0,0" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="4,0,4,8">
                <ItemsControl ItemsSource="{Binding Sections}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,0,18">
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding SummaryText}" FontSize="12" Opacity="0.6"
                                                       Margin="10,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding Description}" FontSize="12" Opacity="0.6"
                                                   TextWrapping="Wrap" Margin="0,2,0,0" />
                                        <TextBlock Text="{Binding ErrorText}" FontSize="12" Foreground="#E8C45F"
                                                   TextWrapping="Wrap" Margin="0,6,0,0"
                                                   Visibility="{Binding ErrorText, Converter={StaticResource StringToVis}}" />
                                    </StackPanel>

                                    <ui:Button Grid.Column="1"
                                               Content="{Binding OpenText}"
                                               Command="{Binding OpenCommand}"
                                               Visibility="{Binding OpenText, Converter={StaticResource StringToVis}}"
                                               MinHeight="36"
                                               VerticalAlignment="Top" />
                                </Grid>

                                <ItemsControl ItemsSource="{Binding Rows}" ItemTemplate="{StaticResource UpdateRow}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Expander Margin="0,4,0,0" IsExpanded="False"
                          Visibility="{Binding HasSkipped, Converter={StaticResource BoolToVis}}">
                    <Expander.Header>
                        <StackPanel>
                            <TextBlock Text="{Binding SkippedHeader}" FontSize="16" FontWeight="SemiBold" />
                            <TextBlock Text="These are left out of every check. Unskip one to see it again next time."
                                       FontSize="12" Opacity="0.6" Margin="0,2,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Expander.Header>
                    <ItemsControl ItemsSource="{Binding Skipped}" Margin="0,8,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Panel}" Padding="12,8" Margin="0,0,0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Name}" FontSize="13" VerticalAlignment="Center"
                                                   TextWrapping="Wrap" Margin="0,0,12,0" />
                                        <ui:Button Grid.Column="1" Content="Unskip" Command="{Binding UnskipCommand}"
                                                   MinWidth="80" MinHeight="40" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Expander>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Padding="4,12,4,0">
            <ui:Button Content="{Binding UpdateButtonText}"
                       Appearance="Primary"
                       Height="52"
                       FontSize="15"
                       HorizontalAlignment="Stretch"
                       HorizontalContentAlignment="Center"
                       Command="{Binding UpdateSelectedCommand}" />
        </Border>
    </Grid>
</UserControl>
