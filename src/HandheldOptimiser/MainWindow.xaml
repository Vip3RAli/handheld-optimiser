<ui:FluentWindow x:Class="HandheldOptimiser.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:vm="clr-namespace:HandheldOptimiser.ViewModels"
                 xmlns:views="clr-namespace:HandheldOptimiser.Views"
                 xmlns:pages="clr-namespace:HandheldOptimiser.Views.Pages"
                 Title="Handheld Optimiser"
                 Width="1180" Height="740"
                 MinWidth="900" MinHeight="560"
                 WindowStartupLocation="CenterScreen"
                 WindowBackdropType="Mica"
                 ExtendsContentIntoTitleBar="True"
                 WindowCornerPreference="Round">

    <ui:FluentWindow.Resources>
        <views:BooleanToVisibilityConverter x:Key="BoolToVis" />
        <views:InverseBooleanConverter x:Key="InverseBool" />
        <views:StringNotEmptyToVisibilityConverter x:Key="StringToVis" />
        <views:LogSeverityToBrushConverter x:Key="LogBrush" />

        <!-- View for each page view model. -->
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <pages:DashboardPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:TweakListViewModel}">
            <pages:TweakListPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:BloatwareViewModel}">
            <pages:BloatwarePage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:StartupViewModel}">
            <pages:StartupPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AsusHealthViewModel}">
            <pages:AsusHealthPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PowerActionsViewModel}">
            <pages:PowerActionsPage />
        </DataTemplate>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="200" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Handheld Optimiser" ShowMaximize="True">
            <ui:TitleBar.Icon>
                <ui:FontIcon Glyph="&#xE7FC;" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <!-- Restart banner: only appears once a change needs a reboot to take effect. -->
        <ui:InfoBar Grid.Row="1"
                    Margin="16,0,16,8"
                    Severity="Warning"
                    IsClosable="False"
                    Title="Restart required"
                    Message="Some applied changes only take effect after a restart."
                    IsOpen="{Binding RebootRequired}">
            <ui:InfoBar.Content>
                <ui:Button Content="Restart now"
                           Margin="0,8,0,0"
                           HorizontalAlignment="Left"
                           Appearance="Caution"
                           Command="{Binding RestartNowCommand}" />
            </ui:InfoBar.Content>
        </ui:InfoBar>

        <!-- Sidebar + page content -->
        <Grid Grid.Row="2" Margin="12,0,12,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="216" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{DynamicResource ApplicationBackgroundBrush}"
                    CornerRadius="8"
                    Padding="6">
                <ListBox ItemsSource="{Binding Pages}"
                         SelectedItem="{Binding SelectedPage, Mode=TwoWay}"
                         Background="Transparent"
                         BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="10,12" />
                            <Setter Property="MinHeight" Value="48" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <ui:FontIcon Glyph="{Binding Glyph}" FontSize="18" Margin="0,0,12,0"
                                             VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Title}" FontSize="14" VerticalAlignment="Center"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <ContentControl Grid.Column="1"
                            Margin="12,0,0,0"
                            Content="{Binding SelectedPage}"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
        </Grid>

        <!-- Live console. Everything the app executes appears here verbatim. -->
        <Expander Grid.Row="3"
                  Margin="12,12,12,0"
                  IsExpanded="{Binding IsLogExpanded, Mode=TwoWay}">
            <Expander.Header>
                <StackPanel Orientation="Horizontal">
                    <ui:FontIcon Glyph="&#xE756;" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBlock Text="Console" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Log.Entries.Count, StringFormat=' — {0} lines'}"
                               Opacity="0.6" VerticalAlignment="Center" />
                </StackPanel>
            </Expander.Header>

            <Grid Height="200">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
                    <ui:Button Content="Clear" Command="{Binding ClearLogCommand}" Margin="0,0,8,0" />
                    <ui:Button Content="Open log file" Command="{Binding OpenLogFileCommand}" />
                    <TextBlock Text="{Binding LogFilePath}" Opacity="0.5" FontSize="11"
                               VerticalAlignment="Center" Margin="12,0,0,0"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <Border Grid.Row="1"
                        Background="#12000000"
                        CornerRadius="6"
                        Padding="8">
                    <ListBox x:Name="LogList"
                             ItemsSource="{Binding Log.Entries}"
                             Background="Transparent"
                             BorderThickness="0"
                             VirtualizingPanel.IsVirtualizing="True"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="2,1" />
                                <Setter Property="MinHeight" Value="0" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding TimeText}" FontFamily="Consolas" FontSize="11"
                                               Opacity="0.45" Margin="0,0,8,0" />
                                    <TextBlock Text="{Binding Prefix}" FontFamily="Consolas" FontSize="11"
                                               Width="22"
                                               Foreground="{Binding Severity, Converter={StaticResource LogBrush}}" />
                                    <TextBlock Text="{Binding Message}" FontFamily="Consolas" FontSize="11"
                                               Foreground="{Binding Severity, Converter={StaticResource LogBrush}}"
                                               TextWrapping="NoWrap" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </Grid>
        </Expander>

        <!-- Status bar -->
        <Border Grid.Row="4" Padding="16,10" Margin="0,8,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ui:ProgressRing Grid.Column="0"
                                 IsIndeterminate="True"
                                 Width="18" Height="18"
                                 Margin="0,0,10,0"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <TextBlock Text="{Binding StatusText}" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding ProgressDetail}" Opacity="0.65" Margin="10,0,0,0"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               Visibility="{Binding ProgressDetail, Converter={StaticResource StringToVis}}" />
                </StackPanel>

                <TextBlock Grid.Column="2" Opacity="0.5" FontSize="11" VerticalAlignment="Center"
                           Text="Running as Administrator" />
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
