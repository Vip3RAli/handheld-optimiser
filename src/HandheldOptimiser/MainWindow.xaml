<ui:FluentWindow x:Class="HandheldOptimiser.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:vm="clr-namespace:HandheldOptimiser.ViewModels"
                 xmlns:views="clr-namespace:HandheldOptimiser.Views"
                 xmlns:pages="clr-namespace:HandheldOptimiser.Views.Pages"
                 Title="Handheld Optimiser"
                 FontFamily="{StaticResource AppFont}"
                 Icon="pack://application:,,,/Assets/app.ico"
                 Width="1180" Height="740"
                 MinWidth="900" MinHeight="560"
                 WindowStartupLocation="CenterScreen"
                 WindowBackdropType="Mica"
                 ExtendsContentIntoTitleBar="True"
                 WindowCornerPreference="Round">

    <ui:FluentWindow.Resources>
        <views:BooleanToVisibilityConverter x:Key="BoolToVis" />
        <views:InverseBooleanConverter x:Key="InverseBool" />
        <views:StringNotEmptyToVisibilityConverter x:Key="StringToVis" />
        <views:LogSeverityToBrushConverter x:Key="LogBrush" />

        <!-- View for each page view model. -->
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <pages:DashboardPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:TweakListViewModel}">
            <pages:TweakListPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:BloatwareViewModel}">
            <pages:BloatwarePage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:StartupViewModel}">
            <pages:StartupPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DeviceHealthViewModel}">
            <pages:DeviceHealthPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PowerActionsViewModel}">
            <pages:PowerActionsPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:GameRuntimesViewModel}">
            <pages:GameRuntimesPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:UpdatesViewModel}">
            <pages:UpdatesPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:HomeAppPickerViewModel}">
            <pages:HomeAppPicker />
        </DataTemplate>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="200" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Handheld Optimiser" ShowMaximize="True">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Assets/app-64.png" Width="18" Height="18" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <StackPanel Grid.Row="1">
            <!--
                The buttons sit under each banner, not inside it: InfoBar only draws its title, message
                and close button, so anything placed in its Content is never shown.
            -->

            <!-- Restart banner: only appears once a change needs a reboot to take effect. -->
            <ui:InfoBar Margin="16,0,16,8"
                        Severity="Warning"
                        IsClosable="False"
                        Title="Restart required"
                        Message="Some applied changes only take effect after a restart."
                        IsOpen="{Binding RebootRequired}" />
            <ui:Button Content="Restart now"
                       Margin="16,0,16,8"
                       MinHeight="36"
                       HorizontalAlignment="Left"
                       Appearance="Primary"
                       Command="{Binding RestartNowCommand}"
                       Visibility="{Binding RebootRequired, Converter={StaticResource BoolToVis}}" />

            <!-- Update banner: a newer release was found on GitHub. -->
            <ui:InfoBar Margin="16,0,16,8"
                        Severity="Informational"
                        IsClosable="True"
                        Title="{Binding UpdateTitle}"
                        Message="{Binding UpdateMessage}"
                        IsOpen="{Binding IsUpdateBannerOpen, Mode=TwoWay}" />
            <StackPanel Orientation="Horizontal" Margin="16,0,16,8"
                        Visibility="{Binding IsUpdateBannerOpen, Converter={StaticResource BoolToVis}}">
                <ui:Button Content="Update now"
                           Margin="0,0,8,0"
                           MinHeight="36"
                           Appearance="Primary"
                           Command="{Binding InstallUpdateCommand}"
                           Visibility="{Binding CanInstallUpdate, Converter={StaticResource BoolToVis}}" />
                <ui:Button Content="Open release page"
                           MinHeight="36"
                           Command="{Binding OpenReleasePageCommand}" />
            </StackPanel>
        </StackPanel>

        <!-- Sidebar + page content -->
        <Grid Grid.Row="2" Margin="12,0,12,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="232" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Five groups, each a row tall enough for a thumb, with a cyan bar beside the open one. -->
            <Border Grid.Column="0" Style="{StaticResource Panel}" Padding="8">
                <ListBox ItemsSource="{Binding Groups}"
                         SelectedItem="{Binding SelectedGroup, Mode=TwoWay}"
                         Background="Transparent"
                         BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="OverridesDefaultStyle" Value="True" />
                            <Setter Property="Margin" Value="0,0,0,6" />
                            <Setter Property="Cursor" Value="Hand" />
                            <Setter Property="Foreground" Value="#C8FFFFFF" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Row" MinHeight="64" CornerRadius="8" Background="Transparent">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border x:Name="Accent" Grid.Column="0"
                                                        Width="4" Height="30" CornerRadius="2"
                                                        Margin="2,0,12,0" VerticalAlignment="Center"
                                                        Background="{StaticResource BrandAccent}" Opacity="0" />
                                                <ContentPresenter Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0" />
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Row" Property="Background" Value="#0FFFFFFF" />
                                            </Trigger>
                                            <Trigger Property="IsKeyboardFocused" Value="True">
                                                <Setter TargetName="Row" Property="Background" Value="#0FFFFFFF" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Row" Property="Background" Value="#1AFFFFFF" />
                                                <Setter TargetName="Accent" Property="Opacity" Value="1" />
                                                <Setter Property="Foreground" Value="White" />
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <ui:FontIcon Glyph="{Binding Glyph}" FontSize="20" Margin="0,0,14,0"
                                             VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Title}" FontSize="15" VerticalAlignment="Center"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <Grid Grid.Column="1" Margin="14,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- The open group's pages. They wrap onto a second row when there are too many for the width. -->
                <ItemsControl Grid.Row="0"
                              Margin="4,0,0,6"
                              ItemsSource="{Binding SelectedGroup.Pages}"
                              Visibility="{Binding SelectedGroup.HasTabs, Converter={StaticResource BoolToVis}}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding Title}"
                                    Margin="0,0,8,8"
                                    Command="{Binding DataContext.OpenPageCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource Pill}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource BrandAccentStrong}" />
                                                <Setter Property="BorderBrush" Value="Transparent" />
                                                <Setter Property="Foreground" Value="{StaticResource BrandOnAccent}" />
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <ContentControl Grid.Row="1"
                                Content="{Binding SelectedPage}"
                                IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
            </Grid>
        </Grid>

        <!-- Live console. Everything the app executes appears here verbatim. -->
        <Expander Grid.Row="3"
                  Margin="12,12,12,0"
                  IsExpanded="{Binding IsLogExpanded, Mode=TwoWay}">
            <Expander.Header>
                <StackPanel Orientation="Horizontal">
                    <ui:FontIcon Glyph="&#xE756;" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBlock Text="Console" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Log.Entries.Count, StringFormat=' ({0} lines)'}"
                               Opacity="0.6" VerticalAlignment="Center" />
                </StackPanel>
            </Expander.Header>

            <Grid Height="200">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
                    <ui:Button Content="Clear" Command="{Binding ClearLogCommand}" Margin="0,0,8,0" />
                    <ui:Button Content="Open log file" Command="{Binding OpenLogFileCommand}" />
                    <TextBlock Text="{Binding LogFilePath}" Opacity="0.5" FontSize="11"
                               VerticalAlignment="Center" Margin="12,0,0,0"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <Border Grid.Row="1"
                        Background="#12000000"
                        CornerRadius="8"
                        Padding="8">
                    <ListBox x:Name="LogList"
                             ItemsSource="{Binding Log.Entries}"
                             Background="Transparent"
                             BorderThickness="0"
                             VirtualizingPanel.IsVirtualizing="True"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="2,1" />
                                <Setter Property="MinHeight" Value="0" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding TimeText}" FontFamily="Consolas" FontSize="11"
                                               Opacity="0.45" Margin="0,0,8,0" />
                                    <TextBlock Text="{Binding Prefix}" FontFamily="Consolas" FontSize="11"
                                               Width="22"
                                               Foreground="{Binding Severity, Converter={StaticResource LogBrush}}" />
                                    <TextBlock Text="{Binding Message}" FontFamily="Consolas" FontSize="11"
                                               Foreground="{Binding Severity, Converter={StaticResource LogBrush}}"
                                               TextWrapping="NoWrap" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </Grid>
        </Expander>

        <!-- Status bar -->
        <Border Grid.Row="4" Padding="16,10" Margin="0,8,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ui:ProgressRing Grid.Column="0"
                                 IsIndeterminate="True"
                                 Width="18" Height="18"
                                 Margin="0,0,10,0"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <TextBlock Text="{Binding StatusText}" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding ProgressDetail}" Opacity="0.65" Margin="10,0,0,0"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               Visibility="{Binding ProgressDetail, Converter={StaticResource StringToVis}}" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <TextBlock Opacity="0.5" FontSize="11" VerticalAlignment="Center"
                               Text="{Binding VersionText}" />
                    <ui:Button Content="Check for updates"
                               FontSize="11"
                               Padding="8,3"
                               Margin="8,0,16,0"
                               VerticalAlignment="Center"
                               Command="{Binding CheckForUpdatesCommand}"
                               IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
                    <TextBlock Opacity="0.5" FontSize="11" VerticalAlignment="Center"
                               Text="Running as Administrator" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
