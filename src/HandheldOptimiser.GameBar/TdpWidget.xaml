<Page
    x:Class="HandheldOptimiser.GameBar.TdpWidget"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Page.Resources>
        <Style x:Key="Choice" TargetType="ToggleButton">
            <Setter Property="MinWidth" Value="52" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Padding" Value="8,5" />
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,12,0,6" />
            <Setter Property="Opacity" Value="0.7" />
            <Setter Property="FontSize" Value="13" />
        </Style>
    </Page.Resources>

    <!-- Game Bar draws its own frame and title; the panel stays see-through behind the controls. -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="14,10,14,14">
            <TextBlock x:Name="Headline" Text="TDP Engine" FontSize="20" FontWeight="SemiBold" />
            <TextBlock x:Name="Detail" Margin="0,2,0,0" Opacity="0.85" TextWrapping="Wrap" />

            <TextBlock Style="{StaticResource Label}" Text="Frame rate" />
            <StackPanel x:Name="FrameRates" Orientation="Horizontal">
                <ToggleButton Style="{StaticResource Choice}" Content="Off" Tag="0" Click="OnFrameRate" />
                <ToggleButton Style="{StaticResource Choice}" Content="30" Tag="30" Click="OnFrameRate" />
                <ToggleButton Style="{StaticResource Choice}" Content="40" Tag="40" Click="OnFrameRate" />
                <ToggleButton Style="{StaticResource Choice}" Content="45" Tag="45" Click="OnFrameRate" />
                <ToggleButton Style="{StaticResource Choice}" Content="60" Tag="60" Click="OnFrameRate" />
            </StackPanel>

            <TextBlock Style="{StaticResource Label}" Text="Fans" />
            <StackPanel x:Name="Fans" Orientation="Horizontal">
                <ToggleButton Style="{StaticResource Choice}" Content="Ally" Tag="" Click="OnFans" />
                <ToggleButton Style="{StaticResource Choice}" Content="Quiet" Tag="quiet" Click="OnFans" />
                <ToggleButton Style="{StaticResource Choice}" Content="Cool" Tag="cool" Click="OnFans" />
                <ToggleButton Style="{StaticResource Choice}" Content="Full" Tag="full" Click="OnFans" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
