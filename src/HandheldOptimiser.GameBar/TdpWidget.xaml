<Page
    x:Class="HandheldOptimiser.GameBar.TdpWidget"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="#111318">

    <!-- NXE Evolution: Xbox Emerald Green & Dimensional Charcoal Cards. -->
    <Page.Resources>
        <SolidColorBrush x:Key="Accent" Color="#107C10" />
        <SolidColorBrush x:Key="AccentBright" Color="#1ED760" />
        <SolidColorBrush x:Key="OnAccent" Color="#FFFFFF" />
        <SolidColorBrush x:Key="CardFill" Color="#161A22" />
        <SolidColorBrush x:Key="CardEdge" Color="#2A3242" />
        <SolidColorBrush x:Key="PodFill" Color="#0E1117" />
        <SolidColorBrush x:Key="PodEdge" Color="#202634" />
        <SolidColorBrush x:Key="BarFill" Color="#0A0C11" />
        <SolidColorBrush x:Key="BarEdge" Color="#1E2430" />
        <SolidColorBrush x:Key="SegmentHover" Color="#252C3A" />
        <SolidColorBrush x:Key="Text" Color="#F3F4F6" />
        <SolidColorBrush x:Key="Muted" Color="#9CA3AF" />
        <SolidColorBrush x:Key="Transparent" Color="Transparent" />

        <!-- NXE Card: 14px rounded corners, 1.5px border, dimensional depth. -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardFill}" />
            <Setter Property="BorderBrush" Value="{StaticResource CardEdge}" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="15,13,15,15" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>

        <Style x:Key="CardIcon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource AccentBright}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>

        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="CharacterSpacing" Value="70" />
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- The line under a card's header. -->
        <Style x:Key="HeaderLine" TargetType="Border">
            <Setter Property="BorderBrush" Value="{StaticResource CardEdge}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="0,0,0,8" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>

        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <Style x:Key="ReadoutValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="24" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource Text}" />
        </Style>

        <Style x:Key="ReadoutName" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
        </Style>

        <!-- The dark strip a row of segments sits in. -->
        <Style x:Key="Bar" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource BarFill}" />
            <Setter Property="BorderBrush" Value="{StaticResource BarEdge}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="3" />
        </Style>

        <!-- One choice in a bar. Styled with NXE tactile pill feel and bright Xbox Green glow on selection. -->
        <Style x:Key="Tile" TargetType="ToggleButton">
            <Setter Property="Background" Value="{StaticResource Transparent}" />
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Height" Value="38" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Margin" Value="1.5,0" />
            <Setter Property="UseSystemFocusVisuals" Value="True" />
            <Setter Property="FocusVisualPrimaryBrush" Value="{StaticResource AccentBright}" />
            <Setter Property="FocusVisualPrimaryThickness" Value="2" />
            <Setter Property="FocusVisualSecondaryThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Background" Value="{StaticResource SegmentHover}" />
                                            <Setter Target="Content.Foreground" Value="{StaticResource Text}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Background" Value="{StaticResource SegmentHover}" />
                                            <Setter Target="Content.Foreground" Value="{StaticResource Text}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Checked">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Background" Value="{StaticResource Accent}" />
                                            <Setter Target="Content.Foreground" Value="{StaticResource OnAccent}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="CheckedPointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Background" Value="{StaticResource AccentBright}" />
                                            <Setter Target="Content.Foreground" Value="{StaticResource OnAccent}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="CheckedPressed">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Background" Value="{StaticResource Accent}" />
                                            <Setter Target="Content.Foreground" Value="{StaticResource OnAccent}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <ContentPresenter x:Name="Content" Content="{TemplateBinding Content}" HorizontalAlignment="Center"
                                              VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}"
                                              FontSize="{TemplateBinding FontSize}" FontWeight="{TemplateBinding FontWeight}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A corner arrow: a small segment of a fixed size, four in one slim row. -->
        <Style x:Key="Corner" TargetType="ToggleButton" BasedOn="{StaticResource Tile}">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Margin" Value="1" />
            <Setter Property="FontSize" Value="14" />
        </Style>
    </Page.Resources>

    <!-- Game Bar draws its own frame and title bar, so the page starts with the first card. -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="12,4,12,2">

            <!-- ===== Now ===== -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Border Style="{StaticResource HeaderLine}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource CardIcon}" Text="&#xE9D9;" />
                            <TextBlock Style="{StaticResource CardTitle}" Text="NOW" />
                        </StackPanel>
                    </Border>
                    <Grid x:Name="Readouts">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="6" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="6" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Background="{StaticResource PodFill}" BorderBrush="{StaticResource PodEdge}" BorderThickness="1"
                                CornerRadius="10" Padding="10,8,8,8">
                            <StackPanel>
                                <TextBlock Style="{StaticResource ReadoutName}" Text="POWER" CharacterSpacing="30" Margin="0,0,0,2" />
                                <TextBlock Style="{StaticResource ReadoutValue}">
                                    <Run x:Name="WattsValue" /><Run x:Name="WattsUnit" Text="W" FontSize="12.5" FontWeight="Normal" Foreground="{StaticResource Muted}" />
                                </TextBlock>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Background="{StaticResource PodFill}" BorderBrush="{StaticResource PodEdge}" BorderThickness="1"
                                CornerRadius="10" Padding="10,8,8,8">
                            <StackPanel>
                                <TextBlock Style="{StaticResource ReadoutName}" Text="FPS" CharacterSpacing="30" Margin="0,0,0,2" />
                                <TextBlock Style="{StaticResource ReadoutValue}" Foreground="{StaticResource AccentBright}">
                                    <Run x:Name="FpsValue" /><Run x:Name="FpsUnit" Text="fps" FontSize="12.5" FontWeight="Normal" Foreground="{StaticResource Muted}" />
                                </TextBlock>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="4" Background="{StaticResource PodFill}" BorderBrush="{StaticResource PodEdge}" BorderThickness="1"
                                CornerRadius="10" Padding="10,8,8,8">
                            <StackPanel>
                                <TextBlock Style="{StaticResource ReadoutName}" Text="TEMP" CharacterSpacing="30" Margin="0,0,0,2" />
                                <TextBlock Style="{StaticResource ReadoutValue}">
                                    <Run x:Name="TemperatureValue" /><Run x:Name="TemperatureUnit" Text="°C" FontSize="12.5" FontWeight="Normal" Foreground="{StaticResource Muted}" />
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </Grid>
                    <Border x:Name="StateLine" Margin="0,10,0,0" Background="{StaticResource PodFill}" BorderBrush="{StaticResource PodEdge}"
                            BorderThickness="1" CornerRadius="8" Padding="10,6">
                        <TextBlock TextWrapping="Wrap" FontSize="12.5" Foreground="{StaticResource Muted}">
                            <Run x:Name="StateName" Foreground="{StaticResource AccentBright}" FontWeight="SemiBold" /><Run x:Name="StateDetail" />
                        </TextBlock>
                    </Border>

                    <!-- Only while TDP Engine replaces Armoury Crate, which is when it runs the Ally's controller.
                         On is Gamepad, off is Desktop (the controller works the mouse and keyboard). -->
                    <Border x:Name="ControllerRow" Style="{StaticResource Bar}" Visibility="Collapsed" Margin="0,10,0,0" Padding="12,6,6,6">
                        <Grid>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource Label}" Margin="0" Text="Gamepad controls" />
                                <TextBlock x:Name="ControllerNote" Style="{StaticResource ReadoutName}" Text="Off: the controller works the mouse" />
                            </StackPanel>
                            <ToggleSwitch x:Name="ControllerSwitch" HorizontalAlignment="Right" MinWidth="0" Width="52" OnContent="" OffContent=""
                                          Toggled="OnControllerMode" FocusVisualPrimaryBrush="{StaticResource Accent}">
                                <ToggleSwitch.Resources>
                                    <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="#107C10" />
                                    <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="#1ED760" />
                                    <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="#107C10" />
                                    <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="#FFFFFF" />
                                    <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPointerOver" Color="#FFFFFF" />
                                    <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPressed" Color="#E5E7EB" />
                                    <SolidColorBrush x:Key="ToggleSwitchStrokeOff" Color="#4B5563" />
                                    <SolidColorBrush x:Key="ToggleSwitchKnobFillOff" Color="#9CA3AF" />
                                </ToggleSwitch.Resources>
                            </ToggleSwitch>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ===== Performance and power ===== -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Border Style="{StaticResource HeaderLine}">
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource CardIcon}" Text="&#xE945;" />
                                <TextBlock Style="{StaticResource CardTitle}" Text="PERFORMANCE &amp; POWER" />
                            </StackPanel>
                            <TextBlock x:Name="PowerValue" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="13"
                                       FontWeight="Bold" Foreground="{StaticResource AccentBright}" Text="Auto" />
                        </Grid>
                    </Border>

                    <!-- On is Auto: TDP Engine picks the power limit, fans and CPU boost, and only the frame rate is
                         the player's. Off is Manual: the player picks them. Saved by TDP Engine, for every game. -->
                    <Border Style="{StaticResource Bar}" Margin="0,0,0,14" Padding="12,6,6,6">
                        <Grid>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource Label}" Margin="0" Text="Auto" />
                                <TextBlock x:Name="ModeNote" Style="{StaticResource ReadoutName}" Text="TDP Engine sets power, fans and boost" />
                            </StackPanel>
                            <ToggleSwitch x:Name="ModeSwitch" HorizontalAlignment="Right" MinWidth="0" Width="52" OnContent="" OffContent=""
                                          Toggled="OnMode" FocusVisualPrimaryBrush="{StaticResource Accent}">
                                <ToggleSwitch.Resources>
                                    <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="#107C10" />
                                    <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="#1ED760" />
                                    <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="#107C10" />
                                    <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="#FFFFFF" />
                                    <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPointerOver" Color="#FFFFFF" />
                                    <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPressed" Color="#E5E7EB" />
                                    <SolidColorBrush x:Key="ToggleSwitchStrokeOff" Color="#4B5563" />
                                    <SolidColorBrush x:Key="ToggleSwitchKnobFillOff" Color="#9CA3AF" />
                                </ToggleSwitch.Resources>
                            </ToggleSwitch>
                        </Grid>
                    </Border>

                    <!-- Five stops: None (Off in Manual), 30, 40, 45 and 60 fps. The choice is sent once the slider
                         stops moving, so passing over 30 on the way to 60 changes nothing. -->
                    <Grid>
                        <TextBlock Style="{StaticResource Label}" Text="Frame rate" />
                        <TextBlock x:Name="FrameRateValue" HorizontalAlignment="Right" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource AccentBright}" Text="Off" />
                    </Grid>
                    <Slider x:Name="FrameRateSlider" Minimum="0" Maximum="4" StepFrequency="1" SmallChange="1" LargeChange="1"
                            TickFrequency="1" TickPlacement="Outside" Value="0" IsThumbToolTipEnabled="False"
                            ValueChanged="OnFrameRateSlider" Foreground="{StaticResource Accent}" Background="{StaticResource BarEdge}"
                            FocusVisualPrimaryBrush="{StaticResource Accent}">
                        <Slider.Resources>
                            <SolidColorBrush x:Key="SliderTrackValueFill" Color="#107C10" />
                            <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="#1ED760" />
                            <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="#107C10" />
                            <SolidColorBrush x:Key="SliderTrackFill" Color="#202634" />
                            <SolidColorBrush x:Key="SliderTrackFillPointerOver" Color="#2A3242" />
                            <SolidColorBrush x:Key="SliderTrackFillPressed" Color="#202634" />
                            <SolidColorBrush x:Key="SliderThumbBackground" Color="#FFFFFF" />
                            <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="#1ED760" />
                            <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="#E5E7EB" />
                            <SolidColorBrush x:Key="SliderTickBarFill" Color="#4B5563" />
                        </Slider.Resources>
                    </Slider>
                    <Grid>
                        <TextBlock x:Name="FrameRateLowest" Style="{StaticResource ReadoutName}" Text="None" />
                        <TextBlock Style="{StaticResource ReadoutName}" Text="60" HorizontalAlignment="Right" />
                    </Grid>

                    <!-- With a frame rate, the most TDP Engine may use; with frame rate Off, a limit held as it is. -->
                    <TextBlock x:Name="PowerLabel" Style="{StaticResource Label}" Text="Power limit" Margin="0,14,0,8" />
                    <Grid x:Name="PowerRow">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="72" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <!-- Auto sends 0: TDP Engine's usual range, or Armoury Crate's own limit. -->
                        <Border Style="{StaticResource Bar}">
                            <ToggleButton x:Name="AutoPower" Style="{StaticResource Tile}" Margin="0" Tag="0" Click="OnPowerLimit" Content="Auto" />
                        </Border>
                        <!-- From TDP Engine's lowest limit to the Ally's highest (30 W plugged in, 25 W on battery), a watt a step. Left and right on
                             the D-pad move it once it has focus; the choice is sent when it stops moving. -->
                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                            <Slider x:Name="PowerSlider" Minimum="7" Maximum="30" StepFrequency="1" SmallChange="1" LargeChange="5"
                                    TickFrequency="5" TickPlacement="None" Value="15" IsThumbToolTipEnabled="False"
                                    ValueChanged="OnPowerSlider" Foreground="{StaticResource Accent}" Background="{StaticResource BarEdge}"
                                    FocusVisualPrimaryBrush="{StaticResource Accent}">
                                <Slider.Resources>
                                    <SolidColorBrush x:Key="SliderTrackValueFill" Color="#107C10" />
                                    <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="#1ED760" />
                                    <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="#107C10" />
                                    <SolidColorBrush x:Key="SliderTrackFill" Color="#202634" />
                                    <SolidColorBrush x:Key="SliderTrackFillPointerOver" Color="#2A3242" />
                                    <SolidColorBrush x:Key="SliderTrackFillPressed" Color="#202634" />
                                    <SolidColorBrush x:Key="SliderThumbBackground" Color="#FFFFFF" />
                                    <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="#1ED760" />
                                    <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="#E5E7EB" />
                                </Slider.Resources>
                            </Slider>
                            <Grid>
                                <TextBlock Style="{StaticResource ReadoutName}" Text="7 W" />
                                <TextBlock x:Name="PowerMax" Style="{StaticResource ReadoutName}" Text="30 W" HorizontalAlignment="Right" />
                            </Grid>
                        </StackPanel>
                    </Grid>

                    <!-- On or off for the power source in use. Not known while TDP Engine is not running: the switch
                         then shows off with a line saying so, and turning it on starts TDP Engine. Manual only. -->
                    <Border x:Name="BoostRow" Style="{StaticResource Bar}" Margin="0,14,0,0" Padding="12,6,6,6">
                        <Grid>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource Label}" Margin="0" Text="CPU boost" />
                                <TextBlock x:Name="BoostNote" Style="{StaticResource ReadoutName}" Text="Faster bursts, more heat" />
                            </StackPanel>
                            <!-- The switch's own template keeps room for a label beside it; a fixed width leaves only the switch. -->
                            <ToggleSwitch x:Name="BoostSwitch" HorizontalAlignment="Right" MinWidth="0" Width="52" OnContent="" OffContent=""
                                          Toggled="OnCpuBoost" FocusVisualPrimaryBrush="{StaticResource Accent}">
                                <ToggleSwitch.Resources>
                                    <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="#107C10" />
                                    <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="#1ED760" />
                                    <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="#107C10" />
                                    <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="#FFFFFF" />
                                    <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPointerOver" Color="#FFFFFF" />
                                    <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPressed" Color="#E5E7EB" />
                                    <SolidColorBrush x:Key="ToggleSwitchStrokeOff" Color="#4B5563" />
                                    <SolidColorBrush x:Key="ToggleSwitchKnobFillOff" Color="#9CA3AF" />
                                </ToggleSwitch.Resources>
                            </ToggleSwitch>
                        </Grid>
                    </Border>

                    <!-- GPU memory on one line: the name, then the sizes in a list. A new size is used from the next
                         restart, so picking one asks to restart now. Hidden where it cannot be set. -->
                    <StackPanel x:Name="GpuMemoryRow" Margin="0,14,0,0" Visibility="Collapsed">
                        <Grid>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource Label}" Margin="0" Text="GPU memory" />
                                <TextBlock x:Name="GpuMemoryNote" Style="{StaticResource ReadoutName}" Visibility="Collapsed" />
                            </StackPanel>
                            <!-- A size is sent only once the list closes on it, and the D-pad on the closed box moves
                                 on rather than changing it, so passing by never changes the GPU memory. -->
                            <ComboBox x:Name="GpuMemorySizes" HorizontalAlignment="Right" MinWidth="110" DropDownOpened="OnGpuMemoryOpened"
                                      DropDownClosed="OnGpuMemoryPicked" PreviewKeyDown="OnGpuMemoryKey" />
                        </Grid>
                        <StackPanel>
                            <StackPanel x:Name="GpuMemoryRestart" Visibility="Collapsed" Margin="0,10,0,0">
                                <TextBlock x:Name="GpuMemoryQuestion" TextWrapping="Wrap" FontSize="13" Foreground="{StaticResource Text}" Margin="0,0,0,8" />
                                <Border Style="{StaticResource Bar}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <ToggleButton Style="{StaticResource Tile}" FontSize="13" Click="OnGpuMemoryRestart" Content="Restart" />
                                        <ToggleButton Grid.Column="1" Style="{StaticResource Tile}" FontSize="13" Click="OnGpuMemoryLater" Content="Later" />
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ===== Cooling: Manual only, as TDP Engine runs the fans in Auto ===== -->
            <Border x:Name="CoolingCard" Style="{StaticResource Card}">
                <StackPanel>
                    <Border Style="{StaticResource HeaderLine}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource CardIcon}" Text="&#xE9CA;" />
                            <TextBlock Style="{StaticResource CardTitle}" Text="COOLING" />
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{StaticResource Label}" Text="Fan curve" />
                    <Border Style="{StaticResource Bar}">
                        <Grid x:Name="Fans">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ToggleButton Style="{StaticResource Tile}" FontSize="13" Tag="" Click="OnFans" Content="Default" />
                            <ToggleButton Grid.Column="1" Style="{StaticResource Tile}" FontSize="13" Tag="quiet" Click="OnFans" Content="Quiet" />
                            <ToggleButton Grid.Column="2" Style="{StaticResource Tile}" FontSize="13" Tag="cool" Click="OnFans" Content="Cool" />
                            <ToggleButton Grid.Column="3" Style="{StaticResource Tile}" FontSize="13" Tag="full" Click="OnFans" Content="Max" />
                            <ToggleButton Grid.Column="4" Style="{StaticResource Tile}" FontSize="13" Tag="dynamic" Click="OnFans" Content="Auto" />
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ===== Overlay ===== -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Border Style="{StaticResource HeaderLine}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource CardIcon}" Text="&#xE7F4;" />
                            <TextBlock Style="{StaticResource CardTitle}" Text="OVERLAY" />
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{StaticResource Label}" Text="Overlay" />
                    <Border Style="{StaticResource Bar}">
                        <!-- The Tag is the level sent to the service. Nothing is lit while TDP Engine is not running. -->
                        <Grid x:Name="OverlayLevels">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ToggleButton Style="{StaticResource Tile}" FontSize="13" Tag="off" Click="OnOverlayLevel" Content="Off" />
                            <ToggleButton Grid.Column="1" Style="{StaticResource Tile}" FontSize="13" Tag="small" Click="OnOverlayLevel" Content="Small" />
                            <ToggleButton Grid.Column="2" Style="{StaticResource Tile}" FontSize="13" Tag="medium" Click="OnOverlayLevel" Content="Medium" />
                            <ToggleButton Grid.Column="3" Style="{StaticResource Tile}" FontSize="13" Tag="full" Click="OnOverlayLevel" Content="Full" />
                        </Grid>
                    </Border>

                    <!-- One slim row: the label, the layout (rows one under another, or one strip), then four small
                         arrows. Each arrow points at its corner. The Tags are what is sent to the service. -->
                    <Grid Margin="0,8,0,0">
                        <TextBlock Style="{StaticResource Label}" Margin="0" VerticalAlignment="Center" Text="Position" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Border Style="{StaticResource Bar}" Padding="2" Margin="0,0,6,0">
                                <StackPanel x:Name="OverlayLayouts" Orientation="Horizontal">
                                    <ToggleButton Style="{StaticResource Corner}" Tag="vertical" Click="OnOverlayLayout" Content="↕" />
                                    <ToggleButton Style="{StaticResource Corner}" Tag="horizontal" Click="OnOverlayLayout" Content="↔" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Bar}" Padding="2">
                                <StackPanel x:Name="OverlayCorners" Orientation="Horizontal">
                                    <ToggleButton Style="{StaticResource Corner}" Tag="top-left" Click="OnOverlayCorner" Content="↖" />
                                    <ToggleButton Style="{StaticResource Corner}" Tag="top-right" Click="OnOverlayCorner" Content="↗" />
                                    <ToggleButton Style="{StaticResource Corner}" Tag="bottom-left" Click="OnOverlayCorner" Content="↙" />
                                    <ToggleButton Style="{StaticResource Corner}" Tag="bottom-right" Click="OnOverlayCorner" Content="↘" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- Big stats and the time on the handheld's own screen while it sits under a monitor. -->
                    <Border Style="{StaticResource Bar}" Margin="0,14,0,0" Padding="12,8,8,8">
                        <Grid>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource Label}" Margin="0" Text="Show stats on handheld screen" />
                                <TextBlock Style="{StaticResource ReadoutName}" Text="While docked to a monitor" />
                            </StackPanel>
                            <ToggleSwitch x:Name="ScreenStatsSwitch" HorizontalAlignment="Right" MinWidth="0" Width="52" OnContent="" OffContent=""
                                          Toggled="OnScreenStats" FocusVisualPrimaryBrush="{StaticResource AccentBright}">
                                <ToggleSwitch.Resources>
                                    <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="#107C10" />
                                    <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="#1ED760" />
                                    <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="#107C10" />
                                    <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="#FFFFFF" />
                                    <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPointerOver" Color="#FFFFFF" />
                                    <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPressed" Color="#E5E7EB" />
                                    <SolidColorBrush x:Key="ToggleSwitchStrokeOff" Color="#4B5563" />
                                    <SolidColorBrush x:Key="ToggleSwitchKnobFillOff" Color="#9CA3AF" />
                                </ToggleSwitch.Resources>
                            </ToggleSwitch>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
