<Page
    x:Class="HandheldOptimiser.GameBar.TdpWidget"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Laid out like Armoury Crate's Command Center in Game Bar: a dark card per group, with the chosen
         button filled. Its red is the brand cyan here, as a deep fill with a bright edge so white text
         stays readable on it. -->
    <Page.Resources>
        <SolidColorBrush x:Key="Cyan" Color="#22D3EE" />
        <SolidColorBrush x:Key="CyanFill" Color="#0E4E5C" />
        <SolidColorBrush x:Key="CyanFillHover" Color="#13616F" />
        <SolidColorBrush x:Key="CardFill" Color="#262B36" />
        <SolidColorBrush x:Key="CardEdge" Color="#3A4150" />
        <SolidColorBrush x:Key="ChoiceFill" Color="#2C3240" />
        <SolidColorBrush x:Key="ChoiceFillHover" Color="#353C4C" />
        <SolidColorBrush x:Key="ChoiceEdge" Color="#454D5E" />
        <SolidColorBrush x:Key="Text" Color="#F2F3F5" />
        <SolidColorBrush x:Key="Muted" Color="#A9B0BC" />

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardFill}" />
            <Setter Property="BorderBrush" Value="{StaticResource CardEdge}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>

        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>

        <Style x:Key="ReadoutValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="24" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource Text}" />
        </Style>

        <Style x:Key="ReadoutName" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
        </Style>

        <Style x:Key="TileNumber" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>

        <Style x:Key="TileUnit" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,2,0,0" />
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
        </Style>

        <!-- A frame rate tile, like an Operating Mode tile. -->
        <Style x:Key="Tile" TargetType="ToggleButton">
            <Setter Property="Background" Value="{StaticResource ChoiceFill}" />
            <Setter Property="BorderBrush" Value="{StaticResource ChoiceEdge}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Height" Value="58" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Margin" Value="3,0" />
            <Setter Property="UseSystemFocusVisuals" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                              BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Background" Value="{StaticResource ChoiceFillHover}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Background" Value="{StaticResource CyanFill}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Checked">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Background" Value="{StaticResource CyanFill}" />
                                            <Setter Target="Root.BorderBrush" Value="{StaticResource Cyan}" />
                                            <Setter Target="Root.BorderThickness" Value="2" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="CheckedPointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Background" Value="{StaticResource CyanFillHover}" />
                                            <Setter Target="Root.BorderBrush" Value="{StaticResource Cyan}" />
                                            <Setter Target="Root.BorderThickness" Value="2" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="CheckedPressed">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Background" Value="{StaticResource CyanFill}" />
                                            <Setter Target="Root.BorderBrush" Value="{StaticResource Cyan}" />
                                            <Setter Target="Root.BorderThickness" Value="2" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Foreground="{TemplateBinding Foreground}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- One part of the fan switch, like Control Mode. The parts sit edge to edge, so only the two ends are rounded. -->
        <Style x:Key="Segment" TargetType="ToggleButton" BasedOn="{StaticResource Tile}">
            <Setter Property="Height" Value="38" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                              BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Background" Value="{StaticResource ChoiceFillHover}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Background" Value="{StaticResource CyanFill}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Checked">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Background" Value="{StaticResource CyanFill}" />
                                            <Setter Target="Root.BorderBrush" Value="{StaticResource Cyan}" />
                                            <Setter Target="Root.BorderThickness" Value="2" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="CheckedPointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Background" Value="{StaticResource CyanFillHover}" />
                                            <Setter Target="Root.BorderBrush" Value="{StaticResource Cyan}" />
                                            <Setter Target="Root.BorderThickness" Value="2" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="CheckedPressed">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Background" Value="{StaticResource CyanFill}" />
                                            <Setter Target="Root.BorderBrush" Value="{StaticResource Cyan}" />
                                            <Setter Target="Root.BorderThickness" Value="2" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <ContentPresenter Content="{TemplateBinding Content}" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Foreground="{TemplateBinding Foreground}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <!-- Game Bar draws its own frame and title bar, so the page starts with the first card. -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="12">
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="Now" />
                    <Grid x:Name="Readouts">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource ReadoutValue}">
                                <Run x:Name="WattsValue" /><Run x:Name="WattsUnit" Text="W" FontSize="13" FontWeight="Normal" Foreground="{StaticResource Muted}" />
                            </TextBlock>
                            <TextBlock Style="{StaticResource ReadoutName}" Text="Power limit" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Style="{StaticResource ReadoutValue}">
                                <Run x:Name="FpsValue" /><Run x:Name="FpsUnit" Text="fps" FontSize="13" FontWeight="Normal" Foreground="{StaticResource Muted}" />
                            </TextBlock>
                            <TextBlock Style="{StaticResource ReadoutName}" Text="Frame rate" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Style="{StaticResource ReadoutValue}">
                                <Run x:Name="TemperatureValue" /><Run x:Name="TemperatureUnit" Text="°C" FontSize="13" FontWeight="Normal" Foreground="{StaticResource Muted}" />
                            </TextBlock>
                            <TextBlock Style="{StaticResource ReadoutName}" Text="Temperature" />
                        </StackPanel>
                    </Grid>
                    <Border x:Name="StateLine" BorderBrush="{StaticResource CardEdge}" BorderThickness="0,1,0,0" Margin="0,10,0,0" Padding="0,10,0,0">
                        <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="{StaticResource Muted}">
                            <Run x:Name="StateName" Foreground="{StaticResource Cyan}" FontWeight="SemiBold" /><Run x:Name="StateDetail" />
                        </TextBlock>
                    </Border>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="Frame rate" />
                    <!-- The outer margin takes back the tiles' own, so the row lines up with the card's edges. -->
                    <Grid x:Name="FrameRates" Margin="-3,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <!-- The Tag is the frame rate sent to the service. -->
                        <ToggleButton Style="{StaticResource Tile}" Tag="0" Click="OnFrameRate">
                            <TextBlock Style="{StaticResource TileNumber}" Text="Off" />
                        </ToggleButton>
                        <ToggleButton Grid.Column="1" Style="{StaticResource Tile}" Tag="30" Click="OnFrameRate">
                            <StackPanel>
                                <TextBlock Style="{StaticResource TileNumber}" Text="30" />
                                <TextBlock Style="{StaticResource TileUnit}" Text="fps" />
                            </StackPanel>
                        </ToggleButton>
                        <ToggleButton Grid.Column="2" Style="{StaticResource Tile}" Tag="40" Click="OnFrameRate">
                            <StackPanel>
                                <TextBlock Style="{StaticResource TileNumber}" Text="40" />
                                <TextBlock Style="{StaticResource TileUnit}" Text="fps" />
                            </StackPanel>
                        </ToggleButton>
                        <ToggleButton Grid.Column="3" Style="{StaticResource Tile}" Tag="45" Click="OnFrameRate">
                            <StackPanel>
                                <TextBlock Style="{StaticResource TileNumber}" Text="45" />
                                <TextBlock Style="{StaticResource TileUnit}" Text="fps" />
                            </StackPanel>
                        </ToggleButton>
                        <ToggleButton Grid.Column="4" Style="{StaticResource Tile}" Tag="60" Click="OnFrameRate">
                            <StackPanel>
                                <TextBlock Style="{StaticResource TileNumber}" Text="60" />
                                <TextBlock Style="{StaticResource TileUnit}" Text="fps" />
                            </StackPanel>
                        </ToggleButton>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- With a frame rate, the most TDP Engine may use; with frame rate Off, a limit held as it is. -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid>
                        <TextBlock Style="{StaticResource CardTitle}" Text="Power limit" />
                        <TextBlock x:Name="PowerValue" HorizontalAlignment="Right" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{StaticResource Cyan}" Text="Auto" />
                    </Grid>
                    <Grid Margin="-3,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="76" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <!-- Auto sends 0: TDP Engine's usual range, or Armoury Crate's own limit. -->
                        <ToggleButton x:Name="AutoPower" Style="{StaticResource Tile}" Tag="0" Click="OnPowerLimit">
                            <TextBlock Style="{StaticResource TileNumber}" Text="Auto" />
                        </ToggleButton>
                        <!-- From TDP Engine's lowest limit to the Ally's highest (30 W plugged in, 25 W on battery), a watt a step. Left and right on
                             the D-pad move it once it has focus; the choice is sent when it stops moving. -->
                        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                            <Slider x:Name="PowerSlider" Minimum="7" Maximum="30" StepFrequency="1" SmallChange="1" LargeChange="5"
                                    TickFrequency="5" TickPlacement="None" Value="15" IsThumbToolTipEnabled="False"
                                    ValueChanged="OnPowerSlider" Foreground="{StaticResource Cyan}" Background="{StaticResource ChoiceEdge}">
                                <Slider.Resources>
                                    <SolidColorBrush x:Key="SliderTrackValueFill" Color="#22D3EE" />
                                    <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="#22D3EE" />
                                    <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="#22D3EE" />
                                    <SolidColorBrush x:Key="SliderTrackFill" Color="#454D5E" />
                                    <SolidColorBrush x:Key="SliderTrackFillPointerOver" Color="#454D5E" />
                                    <SolidColorBrush x:Key="SliderTrackFillPressed" Color="#454D5E" />
                                    <SolidColorBrush x:Key="SliderThumbBackground" Color="#22D3EE" />
                                    <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="#67E8F9" />
                                    <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="#F2F3F5" />
                                </Slider.Resources>
                            </Slider>
                            <Grid>
                                <TextBlock Style="{StaticResource ReadoutName}" Text="7 W" />
                                <TextBlock x:Name="PowerMax" Style="{StaticResource ReadoutName}" Text="30 W" HorizontalAlignment="Right" />
                            </Grid>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="Fans" />
                    <Grid x:Name="Fans">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ToggleButton Style="{StaticResource Segment}" Content="Default" Tag="" Click="OnFans" CornerRadius="6,0,0,6" />
                        <ToggleButton Grid.Column="1" Style="{StaticResource Segment}" Content="Quiet" Tag="quiet" Click="OnFans" BorderThickness="0,1,1,1" />
                        <ToggleButton Grid.Column="2" Style="{StaticResource Segment}" Content="Cool" Tag="cool" Click="OnFans" BorderThickness="0,1,1,1" />
                        <ToggleButton Grid.Column="3" Style="{StaticResource Segment}" Content="Max" Tag="full" Click="OnFans" BorderThickness="0,1,1,1" />
                        <ToggleButton Grid.Column="4" Style="{StaticResource Segment}" Content="Dynamic" Tag="dynamic" Click="OnFans" BorderThickness="0,1,1,1" CornerRadius="0,6,6,0" />
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
