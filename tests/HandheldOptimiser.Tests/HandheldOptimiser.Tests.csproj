<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\HandheldOptimiser\HandheldOptimiser.csproj" />
    <ProjectReference Include="..\..\src\HandheldOptimiser.HomeLauncher\HandheldOptimiser.HomeLauncher.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The TDP Engine controller and the service's request rules are pure logic, so they are built in here
      rather than the service referenced: the service and the launcher share the protocol's types, which
      would then be in two references. The protocol itself comes from the launcher, which builds it in.
    -->
    <Compile Include="..\..\src\HandheldOptimiser.PowerService\AllyButtons.cs" Link="AllyButtons.cs" />
    <Compile Include="..\..\src\HandheldOptimiser.PowerService\AllyCommands.cs" Link="AllyCommands.cs" />
    <Compile Include="..\..\src\HandheldOptimiser.PowerService\AllyControllers.cs" Link="AllyControllers.cs" />
    <Compile Include="..\..\src\HandheldOptimiser.PowerService\AutoTdpController.cs" Link="AutoTdpController.cs" />
    <Compile Include="..\..\src\HandheldOptimiser.PowerService\AutoTdpRules.cs" Link="AutoTdpRules.cs" />
    <Compile Include="..\..\src\HandheldOptimiser.PowerService\CpuBoostRules.cs" Link="CpuBoostRules.cs" />
    <Compile Include="..\..\src\HandheldOptimiser.PowerService\OverlayRules.cs" Link="OverlayRules.cs" />
    <Compile Include="..\..\src\HandheldOptimiser.PowerService\FanCurves.cs" Link="FanCurves.cs" />
    <Compile Include="..\..\src\HandheldOptimiser.PowerService\DynamicFans.cs" Link="DynamicFans.cs" />
    <Compile Include="..\..\src\HandheldOptimiser.PowerService\GameLock.cs" Link="GameLock.cs" />
    <Compile Include="..\..\src\HandheldOptimiser.PowerService\PowerLimits.cs" Link="PowerLimits.cs" />
  </ItemGroup>

</Project>
